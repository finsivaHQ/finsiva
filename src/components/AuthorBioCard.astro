---
interface Props {
  name?: string;
  role?: string;
  bio?: string;
  avatar?: string;
}

const {
  name = "Finsiva Editorial Team",
  role = "Financial Content & Tax Research",
  bio = "Our dedicated team of financial analysts and tax researchers continuously updates tax slab rules, deduction policies, and threshold parameters across global tax jurisdictions.",
  avatar = "/favicon-48x48.png"
} = Astro.props;
---

<div class="p-5 rounded-xl bg-surface border border-hairline dark:border-overlay-light flex items-start gap-4 my-8 shadow-sm">
  <img src={avatar} alt={name} class="w-12 h-12 rounded-full border border-hairline dark:border-overlay-light flex-shrink-0 object-cover" />
  <div>
    <div class="font-bold text-sm text-ink dark:text-on-primary">{name}</div>
    <div class="text-xs text-primary font-medium mb-1.5">{role}</div>
    <p class="text-xs text-muted leading-relaxed">{bio}</p>
  </div>
</div>
