---
interface Props {
  name?: string;
  role?: string;
  bio?: string;
  credentials?: string[];
  avatar?: string;
  lastVerified?: string;
}

const {
  name = "Finsiva Financial Editorial Board",
  role = "Tax & Financial Policy Analysts",
  bio = "Our editorial team consists of finance specialists and tax policy researchers dedicated to bringing verified, up-to-date tax calculators and guides to global readers.",
  credentials = ["CPA Reviewed", "Tax Slabs Verified 2026/2027", "YMYL Financial Quality Standard"],
  avatar,
  lastVerified = "August 2026"
} = Astro.props;
---

<div class="my-6 rounded-2xl border border-hairline bg-canvas p-5 shadow-xs transition-all dark:border-overlay-lighter dark:bg-surface">
  <div class="flex flex-col sm:flex-row items-start gap-4">
    <div class="relative shrink-0">
      {avatar ? (
        <img src={avatar} alt={name} class="h-14 w-14 rounded-full object-cover border-2 border-primary/20" />
      ) : (
        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-primary/20 to-primary/5 text-primary dark:from-on-primary/20 dark:to-on-primary/5 dark:text-on-primary font-bold text-xl border border-primary/20">
          <span>{name.charAt(0)}</span>
        </div>
      )}
      <div class="absolute -bottom-1 -right-1 flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500 text-white text-[10px] font-bold" title="Verified Finance Expert">
        ✓
      </div>
    </div>

    <div class="flex-1">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h4 class="text-base font-bold text-ink dark:text-on-primary flex items-center gap-2">
            {name}
            <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
              Verified Expert
            </span>
          </h4>
          <p class="text-xs font-medium text-muted dark:text-muted">{role}</p>
        </div>
        <span class="text-xs text-muted dark:text-muted bg-canvas-soft dark:bg-canvas px-2.5 py-1 rounded-md border border-hairline dark:border-overlay-lighter">
          Verified: {lastVerified}
        </span>
      </div>

      <p class="mt-2 text-sm text-body dark:text-muted leading-relaxed">
        {bio}
      </p>

      {credentials && credentials.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {credentials.map((cred) => (
            <span class="inline-flex items-center gap-1 rounded-md bg-canvas-soft dark:bg-canvas px-2 py-0.5 text-xs font-medium text-ink dark:text-on-primary border border-hairline dark:border-overlay-lighter">
              <svg class="h-3 w-3 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              {cred}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>
</div>
