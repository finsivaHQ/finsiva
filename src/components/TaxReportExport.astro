---
interface Props {
  title?: string;
  countryName?: string;
  taxYear?: string;
  targetId?: string;
}

const {
  title = "Tax Calculation Report",
  countryName = "",
  taxYear = "2025/2026",
  targetId = "calc-report-content"
} = Astro.props;
---

<div class="my-6 print:hidden">
  <button
    type="button"
    id="print-tax-report-btn"
    data-target={targetId}
    data-title={title}
    data-country={countryName}
    data-year={taxYear}
    class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-surface border border-hairline dark:border-overlay-light text-ink dark:text-on-primary hover:bg-hairline dark:hover:bg-overlay-light transition-colors text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/50 cursor-pointer"
  >
    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
    </svg>
    <span>Export Tax Summary / PDF</span>
  </button>
</div>

<script>
  document.addEventListener('astro:page-load', initExportBtn);
  initExportBtn();

  function initExportBtn() {
    const btn = document.getElementById('print-tax-report-btn');
    if (!btn || btn.getAttribute('data-initialized') === 'true') return;
    btn.setAttribute('data-initialized', 'true');

    btn.addEventListener('click', () => {
      window.print();
    });
  }
</script>
