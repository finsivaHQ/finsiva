---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class={`rounded-xl border border-hairline bg-canvas-soft p-6 sm:p-8 dark:border-overlay-light dark:bg-surface ${className}`}>
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div class="space-y-2 max-w-3xl">
      <span class="text-xs font-semibold uppercase tracking-wider text-primary dark:text-link">
        Financial Content & Tax Research
      </span>
      <h3 class="text-xl font-semibold text-ink dark:text-on-primary">
        Finsiva Tax Research & Editorial Standards
      </h3>
      <p class="text-sm leading-relaxed text-body dark:text-muted">
        Finsiva researches tax rules and calculation parameters using official government sources and reviews its financial content for accuracy, methodology, and regulatory changes.
      </p>
    </div>
    <div class="shrink-0">
      <a
        href="/editorial-policy/"
        class="inline-flex items-center gap-1.5 rounded-lg border border-hairline bg-canvas px-4 py-2 text-sm font-medium text-ink transition hover:border-primary hover:text-primary dark:border-overlay-lighter dark:bg-canvas dark:text-on-primary dark:hover:border-primary dark:hover:text-link"
      >
        View Editorial Policy <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>
