---
interface ImportantDate {
  title: string;
  date: string;
  description: string;
}

interface Props {
  countryName: string;
  importantDates?: ImportantDate[];
}

const { countryName, importantDates = [] } = Astro.props;
---

{importantDates.length > 0 && (
  <div class="bg-surface rounded-xl border border-hairline dark:border-overlay-light p-6 shadow-sm mb-10">
    <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-bold text-ink dark:text-on-primary">Tax Calendar & Deadlines</h3>
          <p class="text-xs text-muted">Official filing deadlines for {countryName}</p>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      {importantDates.map((item) => (
        <div class="flex items-start justify-between gap-4 p-3 rounded-lg bg-canvas dark:bg-surface border border-hairline dark:border-overlay-light flex-wrap sm:flex-nowrap">
          <div class="flex-1 min-w-0">
            <div class="font-semibold text-sm text-ink dark:text-on-primary">{item.title}</div>
            <div class="text-xs text-muted mt-0.5">{item.description}</div>
          </div>
          <div class="flex items-center gap-3 flex-shrink-0">
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary">
              {item.date}
            </span>
            <button
              type="button"
              class="add-ics-btn text-xs font-medium text-primary hover:underline flex items-center gap-1 cursor-pointer"
              data-title={`${countryName} Tax Deadline: ${item.title}`}
              data-desc={item.description}
              data-date={item.date}
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <span>Add to Cal</span>
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
)}

<script>
  document.addEventListener('astro:page-load', initCalendarBtns);
  initCalendarBtns();

  function initCalendarBtns() {
    const btns = document.querySelectorAll('.add-ics-btn');
    btns.forEach((btn) => {
      if (btn.getAttribute('data-initialized') === 'true') return;
      btn.setAttribute('data-initialized', 'true');

      btn.addEventListener('click', () => {
        const title = btn.getAttribute('data-title') || 'Tax Filing Deadline';
        const desc = btn.getAttribute('data-desc') || '';
        const rawDate = btn.getAttribute('data-date') || '';

        // Generate ICS content
        const now = new Date().toISOString().replace(/-|:|\.\d+/g, '');
        const icsContent = [
          'BEGIN:VCALENDAR',
          'VERSION:2.0',
          'PRODID:-//Finsiva//Tax Calendar//EN',
          'BEGIN:VEVENT',
          `UID:${now}@finsiva.com`,
          `DTSTAMP:${now}`,
          `SUMMARY:${title}`,
          `DESCRIPTION:${desc}`,
          'END:VEVENT',
          'END:VCALENDAR'
        ].join('\r\n');

        const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
        const link = document.createElement('a');
        link.href = window.URL.createObjectURL(blob);
        link.setAttribute('download', `${title.replace(/[^a-z0-9]/gi, '_').toLowerCase()}.ics`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      });
    });
  }
</script>
