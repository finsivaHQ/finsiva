---
interface Props {
  title?: string;
}

const { title = "Tax Summary Report" } = Astro.props;
---

<div class="hidden print:block mb-8 pb-4 border-b-2 border-primary">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <img src="/logo.png" alt="Finsiva Logo" class="h-10 w-10 object-contain" />
      <div>
        <h1 class="text-2xl font-extrabold text-black">Finsiva Financial Report</h1>
        <p class="text-xs text-gray-600">Universal Tax Estimation Platform • https://finsiva.com</p>
      </div>
    </div>
    <div class="text-right text-xs text-gray-500">
      <div>Report Type: <strong>{title}</strong></div>
      <div>Generated On: <strong>{new Date().toLocaleDateString()}</strong></div>
      <div>Verification: <strong>100% Private & Verified</strong></div>
    </div>
  </div>
</div>
