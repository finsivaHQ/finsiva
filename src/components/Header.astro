---
const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";
const isCountries = currentPath.startsWith("/countries") || currentPath.startsWith("/countries/");
const isAbout = currentPath === "/about";
const isBlog = currentPath.startsWith("/blogs");
const isContact = currentPath === "/contact";
const isPrivacy = currentPath === "/privacy";
const isTerms = currentPath === "/terms";
const isEditorial = currentPath === "/editorial-policy";
const isKnowledge = currentPath.startsWith("/knowledge") || currentPath.startsWith("/knowledge/");
const is404 = currentPath === "/404";
---

<header class="sticky top-0 z-50 border-b border-hairline bg-canvas/90 backdrop-blur-md dark:border-overlay-light dark:bg-surface/90">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 font-bold text-ink dark:text-on-primary" aria-label="Finsiva Home">
          <img
            src="/logo.png"
            alt="logo"
            class="h-9 w-9 object-contain"
            loading="lazy" />
          <span class="text-lg text-ink dark:text-on-primary" translate="no">Finsiva</span>
        </a>
        <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
          <a href="/" class={`nav-link rounded-pill px-3 py-2 text-sm font-medium transition ${isHome ? "nav-link-active" : "text-ink dark:text-on-primary"}`} aria-current={isHome ? "page" : undefined}><span data-i18n="common.home">Home</span></a>
          <div class="relative group">
            <a href="/countries/" id="country-picker-btn" class={`nav-link rounded-pill px-3 py-2 text-sm font-medium transition inline-flex items-center gap-1 ${isCountries ? "nav-link-active" : "text-ink dark:text-on-primary"}`} aria-current={isCountries ? "page" : undefined} aria-expanded="false" aria-haspopup="true">
              <span data-i18n="common.countries">Countries</span>
              <svg class="h-3 w-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </a>

            <!-- Quick Country Selector Dropdown -->
            <div id="country-picker-menu" class="hidden group-hover:block absolute left-0 z-50 mt-1 w-64 origin-top-left rounded-xl border border-hairline bg-canvas/95 backdrop-blur-md p-2 shadow-xl dark:border-overlay-lighter dark:bg-surface/95 transition-all duration-200">
              <div class="px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-muted dark:text-muted mb-1">Quick Select Country</div>
              <div class="grid grid-cols-1 gap-0.5 max-h-72 overflow-y-auto">
                <a href="/countries/hong-kong/" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-sm text-ink hover:bg-canvas-soft dark:text-on-primary dark:hover:bg-overlay-light transition-colors">
                  <span class="flex items-center gap-2"><span>🇭🇰</span> <span class="font-medium">Hong Kong</span></span>
                  <span class="text-xs text-muted">Salaries, Tax</span>
                </a>
                <a href="/countries/united-states/" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-sm text-ink hover:bg-canvas-soft dark:text-on-primary dark:hover:bg-overlay-light transition-colors">
                  <span class="flex items-center gap-2"><span>🇺🇸</span> <span class="font-medium">United States</span></span>
                  <span class="text-xs text-muted">Federal, State</span>
                </a>
                <a href="/countries/india/" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-sm text-ink hover:bg-canvas-soft dark:text-on-primary dark:hover:bg-overlay-light transition-colors">
                  <span class="flex items-center gap-2"><span>🇮🇳</span> <span class="font-medium">India</span></span>
                  <span class="text-xs text-muted">GST, Income</span>
                </a>
                <a href="/countries/singapore/" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-sm text-ink hover:bg-canvas-soft dark:text-on-primary dark:hover:bg-overlay-light transition-colors">
                  <span class="flex items-center gap-2"><span>🇸🇬</span> <span class="font-medium">Singapore</span></span>
                  <span class="text-xs text-muted">Income, GST</span>
                </a>
                <a href="/countries/united-kingdom/" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-sm text-ink hover:bg-canvas-soft dark:text-on-primary dark:hover:bg-overlay-light transition-colors">
                  <span class="flex items-center gap-2"><span>🇬🇧</span> <span class="font-medium">United Kingdom</span></span>
                  <span class="text-xs text-muted">PAYE, VAT</span>
                </a>
                <a href="/countries/malaysia/" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-sm text-ink hover:bg-canvas-soft dark:text-on-primary dark:hover:bg-overlay-light transition-colors">
                  <span class="flex items-center gap-2"><span>🇲🇾</span> <span class="font-medium">Malaysia</span></span>
                  <span class="text-xs text-muted">Income, SST</span>
                </a>
                <a href="/countries/pakistan/" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-sm text-ink hover:bg-canvas-soft dark:text-on-primary dark:hover:bg-overlay-light transition-colors">
                  <span class="flex items-center gap-2"><span>🇵🇰</span> <span class="font-medium">Pakistan</span></span>
                  <span class="text-xs text-muted">FBR, Sales</span>
                </a>
                <a href="/countries/philippines/" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-sm text-ink hover:bg-canvas-soft dark:text-on-primary dark:hover:bg-overlay-light transition-colors">
                  <span class="flex items-center gap-2"><span>🇵🇭</span> <span class="font-medium">Philippines</span></span>
                  <span class="text-xs text-muted">BIR, VAT</span>
                </a>
                <a href="/countries/indonesia/" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-sm text-ink hover:bg-canvas-soft dark:text-on-primary dark:hover:bg-overlay-light transition-colors">
                  <span class="flex items-center gap-2"><span>🇮🇩</span> <span class="font-medium">Indonesia</span></span>
                  <span class="text-xs text-muted">PPh, VAT</span>
                </a>
                <a href="/countries/new-zealand/" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-sm text-ink hover:bg-canvas-soft dark:text-on-primary dark:hover:bg-overlay-light transition-colors">
                  <span class="flex items-center gap-2"><span>🇳🇿</span> <span class="font-medium">New Zealand</span></span>
                  <span class="text-xs text-muted">PAYE, GST</span>
                </a>
              </div>
              <div class="mt-1 pt-1 border-t border-hairline dark:border-overlay-light text-center">
                <a href="/countries/" class="block py-1 text-xs font-semibold text-primary hover:underline">View All 10+ Countries →</a>
              </div>
            </div>
          </div>
          <div class="relative group">
            <button id="learn-picker-btn" class={`nav-link rounded-pill px-3 py-2 text-sm font-medium transition inline-flex items-center gap-1 ${isKnowledge || isBlog ? "nav-link-active" : "text-ink dark:text-on-primary"}`} aria-expanded="false" aria-haspopup="true">
              <span>Resources</span>
              <svg class="h-3 w-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div id="learn-picker-menu" class="hidden group-hover:block absolute left-0 z-50 mt-1 w-64 origin-top-left rounded-xl border border-hairline bg-canvas/95 backdrop-blur-md p-2 shadow-xl dark:border-overlay-lighter dark:bg-surface/95 transition-all duration-200">
              <div class="grid grid-cols-1 gap-1">
                <a href="/knowledge/" class="block px-3 py-2 rounded-lg hover:bg-canvas-soft dark:hover:bg-overlay-light transition-colors">
                  <div class="text-sm font-semibold text-ink dark:text-on-primary">Tax Knowledge Center</div>
                  <div class="text-xs text-muted mt-0.5">Comprehensive tax concept overviews</div>
                </a>
                <a href="/countries/" class="block px-3 py-2 rounded-lg hover:bg-canvas-soft dark:hover:bg-overlay-light transition-colors">
                  <div class="text-sm font-semibold text-ink dark:text-on-primary">All Country Guides</div>
                  <div class="text-xs text-muted mt-0.5">Tax slabs and rules for 10+ countries</div>
                </a>
                <a href="/knowledge/glossary/" class="block px-3 py-2 rounded-lg hover:bg-canvas-soft dark:hover:bg-overlay-light transition-colors">
                  <div class="text-sm font-semibold text-ink dark:text-on-primary">Tax Glossary</div>
                  <div class="text-xs text-muted mt-0.5">Dictionary of common tax terms</div>
                </a>
              </div>
            </div>
          </div>
        </nav>
      </div>

      <div class="flex items-center gap-1">
        <button id="search-trigger" class="btn btn-ghost flex items-center gap-2 text-sm font-medium text-ink dark:text-on-primary" aria-label="Open search (Cmd+K)" data-i18n-title="common.search">
          <svg id="search-icon-open" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <svg id="search-icon-close" class="h-4 w-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          <span class="hidden lg:inline" data-i18n="common.search">Search</span>
          <kbd class="hidden xl:inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-medium text-muted bg-canvas-soft dark:bg-surface border border-hairline dark:border-overlay-light rounded ml-1"><span class="text-xs">⌘</span>K</kbd>
        </button>

        <button id="theme-toggle" class="btn btn-ghost p-2.5 text-ink dark:text-on-primary" aria-label="Toggle theme" title="Toggle theme">
          <svg id="theme-icon-dark" class="h-5 w-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3a6 6 0 0 0 9 9 9 0 1 1-9-9Z"/></svg>
          <svg id="theme-icon-light" class="h-5 w-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        </button>

        <button id="mobile-menu-btn" class="btn btn-ghost md:hidden p-2.5 text-ink" aria-expanded="false" aria-label="Open navigation menu">
          <svg id="menu-icon-open" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="menu-icon-close" class="h-6 w-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden overflow-hidden transition-all duration-300 ease-in-out" style="max-height:0;opacity:0;" role="navigation" aria-label="Mobile navigation">
    <div class="mx-auto max-w-7xl px-4 py-3 space-y-1">
      <a href="/" class="mobile-nav-link block rounded-pill px-4 py-3 text-sm font-medium text-ink dark:text-on-primary transition-colors"><span data-i18n="common.home">Home</span></a>
      <a href="/countries/" class="mobile-nav-link block rounded-pill px-4 py-3 text-sm font-medium text-ink dark:text-on-primary transition-colors"><span data-i18n="common.countries">Countries</span></a>
      <div class="px-4 py-2">
        <div class="text-xs font-bold text-muted uppercase tracking-wider mb-2">Tax Resources</div>
        <a href="/knowledge/" class="mobile-nav-link block rounded-lg px-3 py-2 text-sm font-medium text-ink dark:text-on-primary hover:bg-canvas-soft transition-colors mb-1">Tax Knowledge Center</a>
        <a href="/countries/" class="mobile-nav-link block rounded-lg px-3 py-2 text-sm font-medium text-ink dark:text-on-primary hover:bg-canvas-soft transition-colors mb-1">All Country Guides</a>
        <a href="/knowledge/glossary/" class="mobile-nav-link block rounded-lg px-3 py-2 text-sm font-medium text-ink dark:text-on-primary hover:bg-canvas-soft transition-colors">Tax Glossary</a>
      </div>
      <a href="/contact/" class="mobile-nav-link block rounded-pill px-4 py-3 text-sm font-medium text-ink dark:text-on-primary transition-colors"><span data-i18n="common.contact">Contact</span></a>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    function initHeaderScripts() {
      var langBtn = document.getElementById('lang-btn');
      var langMenu = document.getElementById('lang-menu');
      var langSearch = document.getElementById('lang-search');
      var langButtons = langMenu ? langMenu.querySelectorAll('button[data-lang]') : [];
      var langLabel = langBtn ? langBtn.querySelector('#lang-label') : null;
      var langChevron = document.getElementById('lang-chevron');
      var mobileBtn = document.getElementById('mobile-menu-btn');
      var mobileMenu = document.getElementById('mobile-menu');
      var menuIconOpen = document.getElementById('menu-icon-open');
      var menuIconClose = document.getElementById('menu-icon-close');
      var mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
      var themeToggle = document.getElementById('theme-toggle');
      var learnBtn = document.getElementById('learn-picker-btn');
      var learnMenu = document.getElementById('learn-picker-menu');

      if (learnBtn && learnMenu && !learnBtn.dataset.boundLearn) {
        learnBtn.dataset.boundLearn = 'true';
        learnBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          var isHidden = learnMenu.classList.toggle('hidden');
          learnBtn.setAttribute('aria-expanded', String(!isHidden));
        });
        document.addEventListener('click', function(e) {
          if (!learnMenu.contains(e.target) && e.target !== learnBtn) {
            learnMenu.classList.add('hidden');
            learnBtn.setAttribute('aria-expanded', 'false');
          }
        });
        learnBtn.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            learnMenu.classList.add('hidden');
            learnBtn.setAttribute('aria-expanded', 'false');
            learnBtn.focus();
          }
        });
      }

      if (themeToggle && !themeToggle.dataset.boundTheme) {
        themeToggle.dataset.boundTheme = 'true';
        themeToggle.addEventListener('click', function() {
          var isDark = document.documentElement.classList.toggle('dark');
          try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
        });
      }

    if (langBtn && langMenu) {
      langBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        var isHidden = langMenu.classList.toggle('hidden');
        langBtn.setAttribute('aria-expanded', String(!isHidden));
        if (langChevron) {
          langChevron.style.transform = isHidden ? 'rotate(0deg)' : 'rotate(180deg)';
        }
      });

      langButtons.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          var lang = btn.getAttribute('data-lang');
          try { localStorage.setItem('lang', lang); } catch (e) {}
          if (langLabel) {
            var labelMap = {en:'EN',hi:'HI',es:'ES',fr:'FR',de:'DE',zh:'ZH',ja:'JA',ar:'AR',pt:'PT',ru:'RU', 'zh-TW':'ZH-TW'};
            langLabel.textContent = labelMap[lang] || lang.toUpperCase();
          }
          langMenu.classList.add('hidden');
          langBtn.setAttribute('aria-expanded', 'false');
          if (langChevron) {
            langChevron.style.transform = 'rotate(0deg)';
          }
          var event = new CustomEvent('lang-change', { bubbles: true, detail: { lang: lang } });
          document.documentElement.dispatchEvent(event);
          try {
            if (typeof setLang === 'function') setLang(lang);
          } catch (e) {}
          setTimeout(function() { window.location.reload(); }, 50);
        });
      });

      var countryToLang = {
        "united states": "en",
        "india": "hi",
        "hong kong": "zh",
        "singapore": "en",
        "indonesia": null,
        "malaysia": null,
        "new zealand": "en",
        "pakistan": null,
        "philippines": null,
        "united kingdom": "en"
      };

      if (langSearch) {
        langSearch.setAttribute('aria-label', 'Search languages');
        langSearch.addEventListener('input', function() {
          var q = langSearch.value.toLowerCase().trim();
          var matchedLang = null;

          if (q) {
            for (var country in countryToLang) {
              if (country.includes(q)) {
                matchedLang = countryToLang[country];
                break;
              }
            }
          }

          langButtons.forEach(function(btn) {
            if (!q || !matchedLang) {
              var text = btn.textContent.toLowerCase();
              btn.style.display = text.includes(q) ? '' : 'none';
            } else {
              var lang = btn.getAttribute('data-lang');
              btn.style.display = (lang === matchedLang) ? '' : 'none';
            }
          });
        });
      }

      if (langMenu) {
        langMenu.addEventListener('mousedown', function(e) {
          e.stopPropagation();
        });
        langMenu.addEventListener('click', function(e) {
          e.stopPropagation();
        });
      }

      document.addEventListener('click', function(e) {
        if (langMenu && !langMenu.contains(e.target) && e.target !== langBtn) {
          langMenu.classList.add('hidden');
          if (langBtn) langBtn.setAttribute('aria-expanded', 'false');
          if (langChevron) {
            langChevron.style.transform = 'rotate(0deg)';
          }
        }
      });
    }

    var searchTrigger = document.getElementById('search-trigger');
    var searchIconOpen = document.getElementById('search-icon-open');
    var searchIconClose = document.getElementById('search-icon-close');

    function updateSearchIcon(open) {
      if (searchIconOpen) searchIconOpen.classList.toggle('hidden', open);
      if (searchIconClose) searchIconClose.classList.toggle('hidden', !open);
      if (searchTrigger) searchTrigger.setAttribute('aria-label', open ? 'Close search' : 'Open search');
    }

    if (searchTrigger) {
      searchTrigger.addEventListener('click', function(e) {
        if (e) e.preventDefault();
        var modal = document.getElementById('search-modal');
        if (modal && modal.classList.contains('hidden')) {
          window.openSearchModal && window.openSearchModal();
        } else {
          window.closeSearchModal && window.closeSearchModal();
        }
      });
    }

    // Global Cmd+K / Ctrl+K keyboard shortcut handler
    document.addEventListener('keydown', function(e) {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault();
        var modal = document.getElementById('search-modal');
        if (modal && modal.classList.contains('hidden')) {
          window.openSearchModal && window.openSearchModal();
        } else {
          window.closeSearchModal && window.closeSearchModal();
        }
      }
    });

    document.addEventListener('search:opened', function() {
      updateSearchIcon(true);
    });

    document.addEventListener('search:closed', function() {
      updateSearchIcon(false);
    });

    function openMobileMenu() {
      if (!mobileMenu || !mobileBtn) return;
      mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
      mobileMenu.style.opacity = '1';
      mobileMenu.classList.remove('hidden');
      mobileBtn.setAttribute('aria-expanded', 'true');
      if (menuIconOpen) menuIconOpen.classList.add('hidden');
      if (menuIconClose) menuIconClose.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      var firstLink = mobileMenu.querySelector('a');
      if (firstLink) firstLink.focus();
    }

    function closeMobileMenu() {
      if (!mobileMenu || !mobileBtn) return;
      mobileMenu.style.maxHeight = '0';
      mobileMenu.style.opacity = '0';
      mobileBtn.setAttribute('aria-expanded', 'false');
      if (menuIconOpen) menuIconOpen.classList.remove('hidden');
      if (menuIconClose) menuIconClose.classList.add('hidden');
      document.body.style.overflow = '';
      mobileBtn.focus();
    }

    function isMobileMenuOpen() {
      return mobileMenu && mobileMenu.style.opacity === '1';
    }

    function setActiveMobileNav() {
      var currentPath = window.location.pathname;
      mobileNavLinks.forEach(function(link) {
        var href = link.getAttribute('href');
        if (!href) return;
        var isActive = false;
        if (href === '/') {
          isActive = currentPath === '/';
        } else if (href === '/countries') {
          isActive = currentPath.startsWith('/countries');
        } else if (href === '/blogs') {
          isActive = currentPath.startsWith('/blogs');
        } else if (href === '/knowledge') {
          isActive = currentPath.startsWith('/knowledge');
        } else if (href === '/about') {
          isActive = currentPath === '/about';
        } else if (href === '/contact') {
          isActive = currentPath === '/contact';
        }
        if (isActive) {
          link.classList.add('mobile-nav-link-active');
          link.setAttribute('aria-current', 'page');
        } else {
          link.classList.remove('mobile-nav-link-active');
          link.removeAttribute('aria-current');
        }
      });
    }

    if (mobileBtn && mobileMenu) {
      mobileBtn.addEventListener('click', function() {
        if (isMobileMenuOpen()) {
          closeMobileMenu();
        } else {
          openMobileMenu();
        }
      });

      mobileBtn.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          mobileBtn.click();
        }
      });
    }

    mobileNavLinks.forEach(function(link) {
      link.addEventListener('click', function() {
        if (isMobileMenuOpen()) {
          closeMobileMenu();
        }
      });
    });

    setActiveMobileNav();

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        if (langMenu && !langMenu.classList.contains('hidden')) {
          langMenu.classList.add('hidden');
          if (langBtn) langBtn.setAttribute('aria-expanded', 'false');
          if (langChevron) {
            langChevron.style.transform = 'rotate(0deg)';
          }
          langBtn.focus();
          return;
        }
        if (isMobileMenuOpen()) {
          closeMobileMenu();
        }
      }
    });

    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        if (window.innerWidth >= 768 && mobileMenu) {
          mobileMenu.style.maxHeight = '';
          mobileMenu.style.opacity = '';
          mobileMenu.classList.remove('hidden');
          document.body.style.overflow = '';
          if (menuIconOpen) menuIconOpen.classList.add('hidden');
          if (menuIconClose) menuIconClose.classList.add('hidden');
        }
      }, 150);
    });

    }

    initHeaderScripts();
  })();
</script>
