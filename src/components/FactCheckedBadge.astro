---
interface Props {
  reviewerName?: string;
  reviewerTitle?: string;
  sourceUrl?: string;
  sourceName?: string;
  lastChecked?: string;
}

const {
  reviewerName = "Finsiva Tax Compliance Board",
  reviewerTitle = "Certified Tax Analysts",
  sourceUrl,
  sourceName = "Official Revenue Authorities",
  lastChecked = "FY 2026/2027"
} = Astro.props;
---

<div class="my-4 flex flex-wrap items-center gap-3 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-3.5 text-xs text-ink dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-on-primary">
  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-500 text-white font-bold shadow-xs">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
    </svg>
  </div>
  
  <div class="flex-1 min-w-[200px]">
    <div class="flex items-center gap-2 font-semibold text-emerald-700 dark:text-emerald-300">
      <span>Fact-Checked & Regulatory Compliant</span>
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
      <span class="text-[11px] font-normal text-muted dark:text-muted">Updated for {lastChecked}</span>
    </div>
    <p class="mt-0.5 text-muted dark:text-muted leading-tight">
      Cross-referenced against official tax brackets published by {sourceName}. Reviewed by <span class="font-medium text-ink dark:text-on-primary">{reviewerName}</span> ({reviewerTitle}).
    </p>
  </div>

  {sourceUrl && (
    <a
      href={sourceUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-1.5 font-medium text-white transition-colors hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-600 shrink-0"
    >
      <span>Verify Source</span>
      <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  )}
</div>
