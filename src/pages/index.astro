---
import Layout from "../layouts/Layout.astro";
import { countries } from "../data/countries";
import { getBaseUrl } from "../utils/routing";

const baseUrl = getBaseUrl();
const homepageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": baseUrl }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
    {
      "@type": "Question",
      "name": "How much tax will I pay?",
      "acceptedAnswer": { "@type": "Answer", "text": "Your tax depends on your total income, deductions, filing status, and jurisdiction. Our tax estimator uses current tax slabs and rules to provide an accurate estimate. Select your country, enter your income details, and review the instant breakdown." }
    },
    {
      "@type": "Question",
      "name": "How do I calculate my tax liability?",
      "acceptedAnswer": { "@type": "Answer", "text": "Start with your total income from all sources, subtract allowable deductions and exemptions to arrive at taxable income, then apply the relevant tax slab rates. Our income tax calculator automates this using the latest official rates and rules." }
    },
    {
      "@type": "Question",
      "name": "What is an income tax calculator?",
      "acceptedAnswer": { "@type": "Answer", "text": "An income tax calculator is an online tool that estimates tax owed based on income, deductions, and applicable tax laws. It helps you understand take-home pay, effective tax rate, and potential refund. Finsiva supports multiple countries and tax types." }
    },
    {
      "@type": "Question",
      "name": "Is a tax calculator free to use?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. All core tax calculators on Finsiva are completely free with no paywalls, subscriptions, or hidden charges. Calculations run locally in your browser with no registration required." }
    },
    {
      "@type": "Question",
      "name": "How accurate are online tax calculators?",
      "acceptedAnswer": { "@type": "Answer", "text": "Online tax calculators provide estimates based on official tax rules and slab rates. They are accurate for planning purposes but may differ from final liability due to jurisdiction-specific nuances. Always verify important tax decisions with local tax authorities or a qualified professional." }
    },
    {
      "@type": "Question",
      "name": "How do I calculate income tax online?",
      "acceptedAnswer": { "@type": "Answer", "text": "Select your country, enter your annual income, choose your filing status and tax year, then input applicable deductions. Our tax estimator instantly computes your tax liability and take-home pay. All calculations run locally in your browser." }
    },
    {
      "@type": "Question",
      "name": "How do I calculate tax on salary?",
      "acceptedAnswer": { "@type": "Answer", "text": "Enter your gross salary into the salary tax calculator along with allowances, bonuses, and deductions. The tool applies relevant PAYE, Social Security, and local tax rules for your country. Use the monthly calculator for detailed breakdowns of earnings after tax." }
    },
    {
      "@type": "Question",
      "name": "Can I use a tax calculator for multiple countries?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. Finsiva supports income tax, salary tax, payroll tax, GST, VAT, and more across 10+ countries. Each calculator is tailored to the specific tax rules of the country you select, so you get accurate estimates for every jurisdiction." }
    },
    {
      "@type": "Question",
      "name": "Which is better: old tax regime or new tax regime?",
      "acceptedAnswer": { "@type": "Answer", "text": "The choice depends on your deductions and income level. Taxpayers with significant deductions like home loan interest, retirement contributions, and insurance often benefit from the old regime. Those with fewer deductions may prefer the new regime lower slab rates." }
    },
    {
      "@type": "Question",
      "name": "How do I legally reduce my tax using deductions?",
      "acceptedAnswer": { "@type": "Answer", "text": "Claim all eligible deductions and credits such as retirement contributions, mortgage interest, charitable donations, education expenses, and business costs. Our tax estimator shows how each deduction lowers your tax base and increases your take-home pay." }
    },
    {
      "@type": "Question",
      "name": "How do I calculate my net salary after tax?",
      "acceptedAnswer": { "@type": "Answer", "text": "Our net salary calculator takes your gross salary and subtracts income tax, Social Security contributions, and other deductions to show your take-home pay. It provides a detailed breakdown of every deduction so you understand where your money goes." }
    },
    {
      "@type": "Question",
      "name": "Are online tax calculators secure and private?",
      "acceptedAnswer": { "@type": "Answer", "text": "Finsiva is built with privacy by design. All calculations run entirely in your browser. We do not collect, store, or transmit your income, deduction, or any financial data to any server. Your information stays on your device." }
    },
    {
      "@type": "Question",
      "name": "How often are tax rates updated on Finsiva?",
      "acceptedAnswer": { "@type": "Answer", "text": "We update our calculators whenever tax rules, slabs, thresholds, or regulations change. Our platform is actively maintained to reflect the latest official rates from government tax authorities across all supported countries." }
    },
      ]
    },
    {
      "@type": "Article",
      "headline": "Finsiva Tax Hub -- Free Online Tax Estimator for Global Taxes",
      "description": "Use our free tax hub to estimate income tax, salary tax, and take-home pay across multiple countries. Accurate, privacy-first, and always free.",
      "url": baseUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": baseUrl },
      "author": { "@type": "Organization", "name": "Finsiva" },
      "publisher": { "@type": "Organization", "name": "Finsiva", "logo": { "@type": "ImageObject", "url": baseUrl + "/logo.png" } },
      "datePublished": "2025-01-01",
      "dateModified": "2026-01-01"
    }
  ]
};
---

<Layout
  title="Tax Hub | Free Online Tax Estimator | Finsiva"
  description="Free tax calculator to estimate income tax, salary tax, and take-home pay. Accurate, privacy-first results for 10+ countries. Try Finsiva now."
  canonical={baseUrl}
  robots="index,follow"
  schema={homepageSchema}
  image="/og-image.svg"
  imageAlt="Finsiva tax calculator dashboard showing income tax estimates across multiple countries"
>
  <article id="main-content" class="min-h-screen bg-canvas dark:bg-canvas">
    <section class="relative overflow-hidden">
      <!-- Elegant natural dark slate fading smoothly into the canvas background -->
      <div class="pointer-events-none absolute inset-0" style="background: linear-gradient(180deg, #1e293b 0%, var(--color-canvas) 100%);" aria-hidden="true"></div>
      
      <!-- Subtle glow in the center to provide depth -->
      <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 h-[500px] w-[800px] rounded-full bg-primary/10 blur-3xl" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-7xl px-4 py-16 text-center sm:px-6 sm:py-24 lg:px-8">
         <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-sm font-medium text-white/90 backdrop-blur-sm animate-slide-up" style="animation-fill-mode: both; animation-delay: 0.1s;">
           <span class="h-2 w-2 rounded-full bg-primary"></span>
           Tax Tools Built for Clarity
         </span>
        <h1 class="hero-title mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl animate-slide-up" style="line-height:1.1; max-width: 56rem; margin-left: auto; margin-right: auto; animation-fill-mode: both; animation-delay: 0.2s;">Tax Hub — Free, Accurate & Private</h1>
        <p class="hero-description mt-6 max-w-2xl mx-auto text-lg text-white/70 sm:text-xl animate-slide-up" style="line-height:1.6; animation-fill-mode: both; animation-delay: 0.3s;">
          Estimate income tax, salary tax, and take-home pay for any country in seconds. No registration, no data collection — just accurate, privacy-first results powered by official tax rules.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row animate-slide-up" style="animation-fill-mode: both; animation-delay: 0.4s;">
          <a href="/countries/" class="inline-flex items-center justify-center gap-2 rounded-pill bg-primary px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-primary/20 transition-all duration-200 ease-out hover:-translate-y-0.5 hover:bg-primary-dark hover:shadow-xl hover:shadow-primary/30 active:translate-y-0 active:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">Start Calculating Taxes</a>
          <a href="#how-it-works" class="inline-flex items-center justify-center gap-2 rounded-pill border border-white/20 bg-white/5 px-8 py-3.5 text-base font-semibold text-white transition-all duration-200 ease-out hover:bg-white/10 active:translate-y-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/50 focus-visible:ring-offset-2 backdrop-blur-sm">See How It Works</a>
        </div>
      </div>
    </section>
    <section id="countries-supported" class="bg-canvas-soft dark:bg-canvas relative z-10" aria-labelledby="countries-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="countries-heading" class="text-3xl font-semibold text-ink mb-4 dark:text-on-primary">Countries Supported</h2>
        <p class="max-w-3xl text-lg text-body mb-10 dark:text-muted">Explore tax calculators tailored to the rules of each country. Select your country to view income tax slabs, payroll deductions, GST, VAT, and more.</p>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
          {countries.map(country => (
            <a href={`/countries/${country.slug}/`} class="flex items-center gap-3 rounded-xl border border-hairline bg-canvas p-4 transition hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary" aria-label={`View tax calculators for ${country.name}`}>
              <img src={country.flag} alt={`${country.name} flag`} width="32" height="24" loading="lazy" class="h-8 w-auto object-contain" title={country.name} />
              <span class="min-w-0 font-medium text-ink dark:text-on-primary">{country.name}</span>
            </a>
          ))}
        </div>
        <div class="mt-6">
          <a href="/countries/" class="inline-flex items-center gap-2 text-sm font-medium text-link hover:underline dark:text-link">View all countries</a>
        </div>
      </div>
    </section>
    <section id="popular-calculators" class="relative z-10" aria-labelledby="calculators-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="calculators-heading" class="text-3xl font-semibold text-ink mb-4 dark:text-on-primary">Popular Tax Calculators</h2>
        <p class="max-w-3xl text-lg text-body mb-10 dark:text-muted">Choose from a growing library of calculator categories. Each tool is designed around the tax structure of the country you select.</p>
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <div class="card dark:border-overlay-lighter dark:bg-surface flex flex-col h-full">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Income Tax Calculator</h3>
            <p class="text-sm text-body dark:text-muted mb-4 flex-grow">Estimate income tax across multiple countries with up-to-date slab rates, deductions, and filing status options.</p>
            <div class="mt-auto pt-3 border-t border-hairline dark:border-overlay-lighter">
              <span class="text-xs font-semibold text-muted block mb-2 uppercase tracking-wider">Select Country:</span>
              <div class="flex flex-wrap gap-2">
                <a href="/countries/united-states/income-tax" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">US</a>
                <a href="/countries/united-kingdom/income-tax" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">UK</a>
                <a href="/countries/india/income-tax" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">India</a>
                <a href="/countries/" class="px-2 py-1 text-xs font-medium text-link hover:underline">More &rarr;</a>
              </div>
            </div>
          </div>

          <div class="card dark:border-overlay-lighter dark:bg-surface flex flex-col h-full">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Salary Tax Calculator</h3>
            <p class="text-sm text-body dark:text-muted mb-4 flex-grow">Calculate tax on salary including allowances, bonuses, and employer contributions with detailed breakdowns.</p>
            <div class="mt-auto pt-3 border-t border-hairline dark:border-overlay-lighter">
              <span class="text-xs font-semibold text-muted block mb-2 uppercase tracking-wider">Select Country:</span>
              <div class="flex flex-wrap gap-2">
                <a href="/countries/hong-kong/salaries-tax" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">Hong Kong</a>
                <a href="/countries/singapore/income-tax" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">Singapore</a>
                <a href="/countries/malaysia/income-tax" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">Malaysia</a>
                <a href="/countries/" class="px-2 py-1 text-xs font-medium text-link hover:underline">More &rarr;</a>
              </div>
            </div>
          </div>

          <div class="card dark:border-overlay-lighter dark:bg-surface flex flex-col h-full">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">GST Calculator</h3>
            <p class="text-sm text-body dark:text-muted mb-4 flex-grow">Calculate GST inclusive and exclusive amounts quickly and accurately for regional businesses.</p>
            <div class="mt-auto pt-3 border-t border-hairline dark:border-overlay-lighter">
              <span class="text-xs font-semibold text-muted block mb-2 uppercase tracking-wider">Select Country:</span>
              <div class="flex flex-wrap gap-2">
                <a href="/countries/india/gst" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">India</a>
                <a href="/countries/singapore/gst" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">Singapore</a>
                <a href="/countries/new-zealand/gst" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">New Zealand</a>
                <a href="/countries/" class="px-2 py-1 text-xs font-medium text-link hover:underline">More &rarr;</a>
              </div>
            </div>
          </div>

          <div class="card dark:border-overlay-lighter dark:bg-surface flex flex-col h-full">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Capital Gains Tax</h3>
            <p class="text-sm text-body dark:text-muted mb-4 flex-grow">Estimate capital gains tax on stocks, real estate, and other investments for short and long-term gains.</p>
            <div class="mt-auto pt-3 border-t border-hairline dark:border-overlay-lighter">
              <span class="text-xs font-semibold text-muted block mb-2 uppercase tracking-wider">Select Country:</span>
              <div class="flex flex-wrap gap-2">
                <a href="/countries/united-states/capital-gains-tax" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">US</a>
                <a href="/countries/united-kingdom/capital-gains-tax" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">UK</a>
                <a href="/countries/india/capital-gains-tax" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">India</a>
                <a href="/countries/" class="px-2 py-1 text-xs font-medium text-link hover:underline">More &rarr;</a>
              </div>
            </div>
          </div>

          <div class="card dark:border-overlay-lighter dark:bg-surface flex flex-col h-full">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">Property Tax</h3>
            <p class="text-sm text-body dark:text-muted mb-4 flex-grow">Estimate property tax, stamp duty, and related costs for residential and commercial real estate.</p>
            <div class="mt-auto pt-3 border-t border-hairline dark:border-overlay-lighter">
              <span class="text-xs font-semibold text-muted block mb-2 uppercase tracking-wider">Select Country:</span>
              <div class="flex flex-wrap gap-2">
                <a href="/countries/hong-kong/property-tax" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">Hong Kong</a>
                <a href="/countries/united-kingdom/property-tax" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">UK</a>
                <a href="/countries/pakistan/property-tax" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">Pakistan</a>
                <a href="/countries/" class="px-2 py-1 text-xs font-medium text-link hover:underline">More &rarr;</a>
              </div>
            </div>
          </div>

          <div class="card dark:border-overlay-lighter dark:bg-surface flex flex-col h-full">
            <h3 class="text-xl font-semibold text-ink mb-2 dark:text-on-primary">VAT & Sales Tax</h3>
            <p class="text-sm text-body dark:text-muted mb-4 flex-grow">Estimate VAT or Sales Tax on domestic and cross-border transactions for retail and everyday purchases.</p>
            <div class="mt-auto pt-3 border-t border-hairline dark:border-overlay-lighter">
              <span class="text-xs font-semibold text-muted block mb-2 uppercase tracking-wider">Select Country:</span>
              <div class="flex flex-wrap gap-2">
                <a href="/countries/united-kingdom/vat" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">UK (VAT)</a>
                <a href="/countries/philippines/vat" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">Philippines</a>
                <a href="/countries/pakistan/sales-tax" class="px-2 py-1 bg-canvas-soft border border-hairline rounded text-xs font-medium text-ink hover:border-primary hover:text-primary transition-colors dark:bg-surface dark:border-overlay-lighter dark:text-on-primary">Pakistan (Sales)</a>
                <a href="/countries/" class="px-2 py-1 text-xs font-medium text-link hover:underline">More &rarr;</a>
              </div>
            </div>
          </div>
        </div>
        </div>
    </section>
    <section id="why-choose-finsiva" class="relative z-10" aria-labelledby="why-choose-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="why-choose-heading" class="text-3xl font-semibold text-ink mb-12 text-center dark:text-on-primary">Why Choose Finsiva</h2>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div class="card text-center dark:border-overlay-lighter dark:bg-surface">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 dark:bg-surface/20">
              <svg class="h-6 w-6 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 12h20" /></svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">10+ Countries</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Income tax, salary tax, payroll, GST, VAT, and more across India, the US, the UK, Australia, Canada, Singapore, and beyond — all in one platform.</p>
          </div>
          <div class="card text-center dark:border-overlay-lighter dark:bg-surface">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 dark:bg-surface/20">
              <svg class="h-6 w-6 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 12 2 2 4-4" /></svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Privacy First</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Every calculation runs exclusively in your browser. Your financial data is never collected, stored, or transmitted to any server.</p>
          </div>
          <div class="card text-center dark:border-overlay-lighter dark:bg-surface">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 dark:bg-surface/20">
              <svg class="h-6 w-6 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z" /></svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Instant Results</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Get detailed tax estimates in seconds with no registration, no waiting, and no complicated forms to fill out.</p>
          </div>
          <div class="card text-center dark:border-overlay-lighter dark:bg-surface">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 dark:bg-surface/20">
              <svg class="h-6 w-6 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 3v5h-5" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H3v5" /></svg>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-ink dark:text-on-primary">Statutory Revisions</h3>
            <p class="mt-2 text-sm text-body dark:text-muted">Tax rules change. Our calculators are updated when applicable statutory rules, slabs, or official tax parameters change.</p>
          </div>
        </div>
      </div>
    </section>
