---
import Layout from "../layouts/Layout.astro";
import { countries } from "../data/countries";
import { getBaseUrl } from "../utils/routing";

const baseUrl = getBaseUrl();
const homepageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": baseUrl }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
    {
      "@type": "Question",
      "name": "How much tax will I pay?",
      "acceptedAnswer": { "@type": "Answer", "text": "Your tax depends on your total income, deductions, filing status, and jurisdiction. Our tax estimator uses current tax slabs and rules to provide an accurate estimate. Select your country, enter your income details, and review the instant breakdown." }
    },
    {
      "@type": "Question",
      "name": "How do I calculate my tax liability?",
      "acceptedAnswer": { "@type": "Answer", "text": "Start with your total income from all sources, subtract allowable deductions and exemptions to arrive at taxable income, then apply the relevant tax slab rates. Our income tax calculator automates this using the latest official rates and rules." }
    },
    {
      "@type": "Question",
      "name": "What is an income tax calculator?",
      "acceptedAnswer": { "@type": "Answer", "text": "An income tax calculator is an online tool that estimates tax owed based on income, deductions, and applicable tax laws. It helps you understand take-home pay, effective tax rate, and potential refund. Finsiva supports multiple countries and tax types." }
    },
    {
      "@type": "Question",
      "name": "Is a tax calculator free to use?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. All core tax calculators on Finsiva are completely free with no paywalls, subscriptions, or hidden charges. Calculations run locally in your browser with no registration required." }
    },
    {
      "@type": "Question",
      "name": "How accurate are online tax calculators?",
      "acceptedAnswer": { "@type": "Answer", "text": "Online tax calculators provide estimates based on official tax rules and slab rates. They are accurate for planning purposes but may differ from final liability due to jurisdiction-specific nuances. Always verify important tax decisions with local tax authorities or a qualified professional." }
    },
    {
      "@type": "Question",
      "name": "How do I calculate income tax online?",
      "acceptedAnswer": { "@type": "Answer", "text": "Select your country, enter your annual income, choose your filing status and tax year, then input applicable deductions. Our tax estimator instantly computes your tax liability and take-home pay. All calculations run locally in your browser." }
    },
    {
      "@type": "Question",
      "name": "How do I calculate tax on salary?",
      "acceptedAnswer": { "@type": "Answer", "text": "Enter your gross salary into the salary tax calculator along with allowances, bonuses, and deductions. The tool applies relevant PAYE, Social Security, and local tax rules for your country. Use the monthly calculator for detailed breakdowns of earnings after tax." }
    },
    {
      "@type": "Question",
      "name": "Can I use a tax calculator for multiple countries?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes. Finsiva supports income tax, salary tax, payroll tax, GST, VAT, and more across 10+ countries. Each calculator is tailored to the specific tax rules of the country you select, so you get accurate estimates for every jurisdiction." }
    },
    {
      "@type": "Question",
      "name": "Which is better: old tax regime or new tax regime?",
      "acceptedAnswer": { "@type": "Answer", "text": "The choice depends on your deductions and income level. Taxpayers with significant deductions like home loan interest, retirement contributions, and insurance often benefit from the old regime. Those with fewer deductions may prefer the new regime lower slab rates." }
    },
    {
      "@type": "Question",
      "name": "How do I legally reduce my tax using deductions?",
      "acceptedAnswer": { "@type": "Answer", "text": "Claim all eligible deductions and credits such as retirement contributions, mortgage interest, charitable donations, education expenses, and business costs. Our tax estimator shows how each deduction lowers your tax base and increases your take-home pay." }
    },
    {
      "@type": "Question",
      "name": "How do I calculate my net salary after tax?",
      "acceptedAnswer": { "@type": "Answer", "text": "Our net salary calculator takes your gross salary and subtracts income tax, Social Security contributions, and other deductions to show your take-home pay. It provides a detailed breakdown of every deduction so you understand where your money goes." }
    },
    {
      "@type": "Question",
      "name": "Are online tax calculators secure and private?",
      "acceptedAnswer": { "@type": "Answer", "text": "Finsiva is built with privacy by design. All calculations run entirely in your browser. We do not collect, store, or transmit your income, deduction, or any financial data to any server. Your information stays on your device." }
    },
    {
      "@type": "Question",
      "name": "How often are tax rates updated on Finsiva?",
      "acceptedAnswer": { "@type": "Answer", "text": "We update our calculators whenever tax rules, slabs, thresholds, or regulations change. Our platform is actively maintained to reflect the latest official rates from government tax authorities across all supported countries." }
    },
      ]
    },
    {
      "@type": "Article",
      "headline": "Finsiva Tax Hub -- Free Online Tax Estimator for Global Taxes",
      "description": "Use our free tax hub to estimate income tax, salary tax, and take-home pay across multiple countries. Accurate, privacy-first, and always free.",
      "url": baseUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": baseUrl },
      "author": { "@type": "Organization", "name": "Finsiva" },
      "publisher": { "@type": "Organization", "name": "Finsiva", "logo": { "@type": "ImageObject", "url": baseUrl + "/logo.png" } },
      "datePublished": "2025-01-01",
      "dateModified": "2026-01-01"
    }
  ]
};
---

<Layout
  title="Tax Hub | Free Online Tax Estimator | Finsiva"
  description="Free tax calculator to estimate income tax, salary tax, and take-home pay. Accurate, privacy-first results for 10+ countries. Try Finsiva now."
  canonical={baseUrl}
  robots="index,follow"
  schema={homepageSchema}
  image="/og-image.svg"
  imageAlt="Finsiva tax calculator dashboard showing income tax estimates across multiple countries"
>
  <article id="main-content" class="min-h-screen bg-canvas dark:bg-canvas">
    
    <!-- 1. ACTION-ORIENTED HERO SECTION -->
    <section class="relative overflow-hidden pt-24 pb-16 lg:pt-32 lg:pb-24">
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-primary/5 to-canvas dark:from-primary/10 dark:to-canvas"></div>
      <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 h-[500px] w-[800px] rounded-full bg-primary/10 blur-3xl" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
        <span class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-sm font-medium text-primary mb-6">
          <span class="h-2 w-2 rounded-full bg-primary animate-pulse"></span>
          Tax Tools Built for Clarity
        </span>
        
        <h1 class="text-5xl font-extrabold tracking-tight text-ink dark:text-white sm:text-6xl lg:text-7xl mb-6">
          Tax Hub,<br/> <span class="text-primary">Simplified.</span>
        </h1>
        
        <p class="mx-auto max-w-2xl text-xl text-body dark:text-muted mb-10 leading-relaxed">
          Estimate income tax, salary deductions, and take-home pay instantly. No registration, no data collection—just accurate, privacy-first results.
        </p>
        
        <!-- Quick Country Select Widget -->
        <div class="mx-auto max-w-3xl bg-white dark:bg-surface border border-hairline dark:border-overlay-lighter rounded-2xl shadow-xl shadow-primary/5 p-5 sm:p-8 mb-8 text-left relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary to-blue-400"></div>
          <h2 class="text-sm font-bold text-ink dark:text-on-primary uppercase tracking-wider mb-5">Quick Start: Select Your Country</h2>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {countries.slice(0, 7).map(country => (
              <a href={`/countries/${country.slug}/`} class="group flex flex-col items-center justify-center gap-2 p-4 rounded-xl border border-hairline bg-canvas-soft hover:border-primary hover:bg-primary/5 hover:-translate-y-1 transition-all duration-200 dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
                <img src={country.flag} alt={`${country.name} flag`} class="h-8 w-auto object-contain transition-transform group-hover:scale-110" />
                <span class="font-semibold text-ink dark:text-on-primary text-xs text-center">{country.name}</span>
              </a>
            ))}
            <a href="/countries/" class="flex flex-col items-center justify-center gap-2 p-4 rounded-xl border border-dashed border-muted hover:border-primary text-primary transition-colors bg-canvas dark:bg-canvas-soft">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              <span class="font-semibold text-xs text-center">View All</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. CONSOLIDATED "WHY FINSIVA" SECTION -->
    <section class="py-16 bg-canvas-soft dark:bg-canvas relative z-10 border-y border-hairline dark:border-overlay-lighter">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-extrabold text-ink dark:text-on-primary text-center mb-12">Why Choose Finsiva?</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 text-center">
          <div class="p-4">
             <div class="mx-auto h-12 w-12 bg-primary/10 rounded-full flex items-center justify-center mb-4 text-primary">
               <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
             </div>
             <h3 class="font-bold text-ink dark:text-on-primary mb-2 text-lg">Privacy First</h3>
             <p class="text-sm text-body dark:text-muted">Calculations run locally in your browser. No data collected or stored.</p>
          </div>
          <div class="p-4">
             <div class="mx-auto h-12 w-12 bg-primary/10 rounded-full flex items-center justify-center mb-4 text-primary">
               <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
             </div>
             <h3 class="font-bold text-ink dark:text-on-primary mb-2 text-lg">Instant Results</h3>
             <p class="text-sm text-body dark:text-muted">No sign-ups, no waiting. Get your tax estimates in milliseconds.</p>
          </div>
          <div class="p-4">
             <div class="mx-auto h-12 w-12 bg-primary/10 rounded-full flex items-center justify-center mb-4 text-primary">
               <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
             </div>
             <h3 class="font-bold text-ink dark:text-on-primary mb-2 text-lg">Global Support</h3>
             <p class="text-sm text-body dark:text-muted">Accurate tax slabs and rules for over 10+ countries worldwide.</p>
          </div>
          <div class="p-4">
             <div class="mx-auto h-12 w-12 bg-primary/10 rounded-full flex items-center justify-center mb-4 text-primary">
               <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
             </div>
             <h3 class="font-bold text-ink dark:text-on-primary mb-2 text-lg">Always Updated</h3>
             <p class="text-sm text-body dark:text-muted">Calculators dynamically reflect the latest statutory tax rules.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. HOW IT WORKS (Visual 3-step process) -->
    <section class="py-20 relative z-10" aria-labelledby="how-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 id="how-heading" class="text-3xl font-extrabold text-ink mb-16 text-center dark:text-on-primary">How It Works</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 max-w-5xl mx-auto relative">
          <!-- Connecting Line -->
          <div class="hidden md:block absolute top-12 left-[15%] right-[15%] h-0.5 bg-gradient-to-r from-primary/10 via-primary to-primary/10 -z-10"></div>
          
          <div class="text-center bg-canvas dark:bg-canvas p-6">
            <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white dark:bg-surface border-4 border-primary text-xl font-bold text-primary shadow-lg shadow-primary/20 mb-6">1</span>
            <h3 class="text-xl font-bold text-ink dark:text-on-primary mb-3">Choose Country</h3>
            <p class="text-body dark:text-muted leading-relaxed">Select the country whose tax rules apply to your situation. We tailor all fields locally.</p>
          </div>
          <div class="text-center bg-canvas dark:bg-canvas p-6">
            <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white dark:bg-surface border-4 border-primary text-xl font-bold text-primary shadow-lg shadow-primary/20 mb-6">2</span>
            <h3 class="text-xl font-bold text-ink dark:text-on-primary mb-3">Enter Details</h3>
            <p class="text-body dark:text-muted leading-relaxed">Provide your income, deductions, and filing status safely—no data leaves your device.</p>
          </div>
          <div class="text-center bg-canvas dark:bg-canvas p-6">
            <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white dark:bg-surface border-4 border-primary text-xl font-bold text-primary shadow-lg shadow-primary/20 mb-6">3</span>
            <h3 class="text-xl font-bold text-ink dark:text-on-primary mb-3">Get Estimate</h3>
            <p class="text-body dark:text-muted leading-relaxed">Instantly review your tax liability, effective rate, and exact take-home pay.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. STREAMLINED POPULAR CALCULATORS -->
    <section class="py-16 bg-canvas-soft dark:bg-surface/30 relative z-10 border-t border-hairline dark:border-overlay-lighter" aria-labelledby="calculators-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
          <div class="max-w-2xl">
            <h2 id="calculators-heading" class="text-3xl font-extrabold text-ink mb-4 dark:text-on-primary">Popular Calculators</h2>
            <p class="text-lg text-body dark:text-muted">Choose from our library of tools optimized for regional rules.</p>
          </div>
          <a href="/countries/" class="hidden md:inline-flex items-center gap-2 font-semibold text-primary hover:text-primary-hover">Explore all tools &rarr;</a>
        </div>
        
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Card 1 -->
          <div class="group flex flex-col bg-white dark:bg-surface border border-hairline dark:border-overlay-lighter rounded-2xl p-5 shadow-sm hover:shadow-xl hover:border-primary transition-all duration-300">
            <div class="h-10 w-10 bg-blue-100 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400 rounded-xl flex items-center justify-center mb-4">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-ink dark:text-on-primary mb-1">Income Tax</h3>
            <p class="text-sm text-body dark:text-muted mb-4 flex-grow">Estimate your income tax with the latest slab rates, standard deductions, and regional filing statuses.</p>
            <div class="pt-3 border-t border-hairline dark:border-overlay-lighter">
              <span class="text-xs font-bold text-muted uppercase tracking-wider block mb-2">Top Regions:</span>
              <div class="flex flex-wrap gap-2">
                <a href="/countries/united-states/income-tax/" class="px-2.5 py-0.5 bg-canvas rounded-full text-[11px] font-semibold hover:bg-primary hover:text-white transition-colors dark:bg-canvas-soft">US</a>
                <a href="/countries/united-kingdom/income-tax/" class="px-2.5 py-0.5 bg-canvas rounded-full text-[11px] font-semibold hover:bg-primary hover:text-white transition-colors dark:bg-canvas-soft">UK</a>
                <a href="/countries/india/income-tax/" class="px-2.5 py-0.5 bg-canvas rounded-full text-[11px] font-semibold hover:bg-primary hover:text-white transition-colors dark:bg-canvas-soft">India</a>
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="group flex flex-col bg-white dark:bg-surface border border-hairline dark:border-overlay-lighter rounded-2xl p-5 shadow-sm hover:shadow-xl hover:border-primary transition-all duration-300">
            <div class="h-10 w-10 bg-green-100 text-green-600 dark:bg-green-900/30 dark:text-green-400 rounded-xl flex items-center justify-center mb-4">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="text-lg font-bold text-ink dark:text-on-primary mb-1">Salary Tax</h3>
            <p class="text-sm text-body dark:text-muted mb-4 flex-grow">Calculate tax on gross salary, including allowances, bonuses, and mandatory employer contributions.</p>
            <div class="pt-3 border-t border-hairline dark:border-overlay-lighter">
              <span class="text-xs font-bold text-muted uppercase tracking-wider block mb-2">Top Regions:</span>
              <div class="flex flex-wrap gap-2">
                <a href="/countries/hong-kong/salaries-tax/" class="px-2.5 py-0.5 bg-canvas rounded-full text-[11px] font-semibold hover:bg-primary hover:text-white transition-colors dark:bg-canvas-soft">Hong Kong</a>
                <a href="/countries/singapore/income-tax/" class="px-2.5 py-0.5 bg-canvas rounded-full text-[11px] font-semibold hover:bg-primary hover:text-white transition-colors dark:bg-canvas-soft">Singapore</a>
                <a href="/countries/malaysia/income-tax/" class="px-2.5 py-0.5 bg-canvas rounded-full text-[11px] font-semibold hover:bg-primary hover:text-white transition-colors dark:bg-canvas-soft">Malaysia</a>
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="group flex flex-col bg-white dark:bg-surface border border-hairline dark:border-overlay-lighter rounded-2xl p-5 shadow-sm hover:shadow-xl hover:border-primary transition-all duration-300">
            <div class="h-10 w-10 bg-purple-100 text-purple-600 dark:bg-purple-900/30 dark:text-purple-400 rounded-xl flex items-center justify-center mb-4">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
            </div>
            <h3 class="text-lg font-bold text-ink dark:text-on-primary mb-1">Capital Gains</h3>
            <p class="text-sm text-body dark:text-muted mb-4 flex-grow">Estimate capital gains tax on stocks, real estate, and crypto for short and long-term investments.</p>
            <div class="pt-3 border-t border-hairline dark:border-overlay-lighter">
              <span class="text-xs font-bold text-muted uppercase tracking-wider block mb-2">Top Regions:</span>
              <div class="flex flex-wrap gap-2">
                <a href="/countries/united-states/capital-gains-tax/" class="px-2.5 py-0.5 bg-canvas rounded-full text-[11px] font-semibold hover:bg-primary hover:text-white transition-colors dark:bg-canvas-soft">US</a>
                <a href="/countries/united-kingdom/capital-gains-tax/" class="px-2.5 py-0.5 bg-canvas rounded-full text-[11px] font-semibold hover:bg-primary hover:text-white transition-colors dark:bg-canvas-soft">UK</a>
                <a href="/countries/india/capital-gains-tax/" class="px-2.5 py-0.5 bg-canvas rounded-full text-[11px] font-semibold hover:bg-primary hover:text-white transition-colors dark:bg-canvas-soft">India</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    
    <!-- RESTORED SEO CONTENT -->
    <div class="pt-12 border-t border-hairline dark:border-overlay-lighter">
      <section id="why-millions-use" class="bg-canvas-soft dark:bg-canvas relative z-10" aria-labelledby="millions-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="millions-heading" class="text-3xl font-semibold text-ink mb-12 text-center dark:text-on-primary">Why Use Tax Calculators?</h2>
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
          <div class="flex flex-col md:flex-row gap-6">
            <div class="flex-shrink-0 flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 dark:bg-surface/30">
              <svg class="h-8 w-8 text-primary dark:text-link" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-ink dark:text-on-primary">Understand Your Tax Position</h3>
              <p class="mt-2 text-body dark:text-muted">Tax systems vary dramatically across countries. A tax calculator helps you understand how much of your income goes to taxes and what factors most affect your bill — whether you are a salaried employee, freelancer, or business owner.</p>
              <p class="mt-2 text-body dark:text-muted">Knowing your tax position before receiving a paycheck or signing a contract gives you a realistic picture of your financial future and helps you negotiate compensation with confidence.</p>
            </div>
          </div>
          <div class="flex flex-col md:flex-row gap-6">
            <div class="flex-shrink-0 flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 dark:bg-surface/30">
              <svg class="h-8 w-8 text-primary dark:text-link" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-ink dark:text-on-primary">Plan Deductions and Save</h3>
              <p class="mt-2 text-body dark:text-muted">Most taxpayers leave money on the table by missing deductions they are entitled to. A calculator helps you model different scenarios — adjusting income thresholds, claiming specific credits, or comparing old versus new regimes — so you can optimize your tax strategy.</p>
              <p class="mt-2 text-body dark:text-muted">Try different scenarios to see how retirement contributions, mortgage interest, or charitable giving lower your taxable income. This kind of proactive planning is impossible with paper-based estimation.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section id="key-features" class="relative z-10" aria-labelledby="features-heading">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <h2 id="features-heading" class="text-3xl font-semibold text-ink mb-12 text-center dark:text-on-primary">Features</h2>
