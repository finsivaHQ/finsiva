        if (!text) return;
        navigator.clipboard.writeText(text).then(function() {
          var btns = document.querySelectorAll('.result-action-btn--copy');
          btns.forEach(function(btn) {
            var original = btn.innerHTML;
            btn.innerHTML = '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>Copied!</span>';
            setTimeout(function() { btn.innerHTML = original; }, 2000);
          });
        }).catch(function() {});
