const customSeo = calculatorSeoMap[ruleId];

const pageTitle = customSeo?.title || `${country.name} ${calculator.name} ${country.taxYear}: Slabs, Rates & Net Calculation`;
const pageDescription = customSeo?.description || `Calculate your ${country.name} ${calculator.name.toLowerCase()} for the ${country.taxYear} tax year. ${calculator.description}`;
const calcCanonical = `https://finsiva.com/countries/${country.slug}/${category.slug}/${calculator.slug}/`;

const calcFaqSchema = mergedContent.faq && mergedContent.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": mergedContent.faq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : undefined;

const calcWebAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": `${country.name} ${calculator.name}`,
  "url": calcCanonical,
  "description": pageDescription,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": country.currency
  }
};

---

<CountryLayout
  title={pageTitle}
  description={pageDescription}
  canonical={calcCanonical}
  schema={calcWebAppSchema}
  breadcrumbs={[
    { label: "Countries", href: "/countries/" },
    { label: country.name, href: `/countries/${country.slug}/` },
    { label: category.name, href: `/countries/${country.slug}/${category.slug}/` },
    { label: calculator.name }
  ]}
>
  {calcFaqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(calcFaqSchema)} slot="head" />
  )}
  <div class="relative overflow-hidden rounded-2xl bg-canvas p-8 sm:p-12 mb-8 border border-hairline shadow-sm dark:bg-surface dark:border-overlay-lighter">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
    <div class="absolute left-0 right-0 top-0 -z-10 m-auto h-[310px] w-[310px] rounded-full bg-primary/20 opacity-50 blur-[100px] dark:bg-primary/10"></div>
    <div class="relative z-10 max-w-3xl">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink dark:text-on-primary" data-i18n={calculator.name}>{calculator.name}</h1>
      <p class="mt-4 text-lg text-body dark:text-muted" data-i18n={calculator.description}>{calculator.description}</p>
    </div>
  </div>

  <div class="mb-4 flex items-center gap-3 text-sm text-muted dark:text-muted">
    <span class="tag tag-primary">{country.name}</span>
    <span class="tag">{category.name}</span>
    <span class="tag">Tax Period: {country.taxYear || "2025/26"}</span>
  </div>

  <FactCheckedBadge
    reviewerName="Finsiva Research & Methodology"
    reviewerTitle="Statutory Research"
    sourceName={country.officialTaxAuthority}
    sourceUrl={country.taxAuthorityUrl}
    lastChecked={country.taxYear}
  />

  <!-- Position 0 Featured Snippet Definition Box -->
  <div class="my-6 rounded-2xl border border-primary/20 bg-primary/5 p-5 sm:p-6 dark:border-primary/20 dark:bg-primary/5">
    <div class="flex items-start gap-3.5">
      <div class="mt-0.5 rounded-xl bg-primary p-2.5 text-white flex-shrink-0 shadow-sm">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-primary">Statutory Rule &amp; Definition</span>
          <span class="text-[11px] font-semibold text-muted">&bull; Verified for {country.taxYear || "2026"}</span>
        </div>
        {content?.definitionBox ? (
          <div class="text-sm leading-relaxed text-ink dark:text-on-primary" set:html={content.definitionBox}></div>
        ) : (
          <p class="text-sm leading-relaxed text-ink dark:text-on-primary">
            <strong>{country.name} {calculator.name}:</strong> Under statutory guidelines established by {country.officialTaxAuthority}, {calculator.description.toLowerCase().replace(/\.$/, "")}. Calculations for {country.taxYear || "2026"} determine precise marginal brackets, statutory rate percentages, allowable deductions, and net post-tax retained amounts.
          </p>
        )}
      </div>
    </div>
  </div>


  <div class="mx-auto max-w-7xl">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-5 xl:col-span-4 lg:sticky lg:top-24">
      <div class="rounded-2xl border border-hairline bg-canvas p-6 shadow-sm dark:border-overlay-lighter dark:bg-surface/50 backdrop-blur-sm">
        <h2 class="text-xl font-bold text-ink mb-6 flex items-center gap-2 dark:text-on-primary" data-i18n="calculator.input_heading">
          <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
          Calculator Input
        </h2>
      
      {rule ? (
        <form id="calc-form" class="space-y-6" onsubmit="event.preventDefault()" data-rule-id={rule.id} data-country-currency={country.currency}>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-1">
            {rule.inputs.map((input) => (
              <div>
                <label for={input.id} class="block text-sm font-medium text-ink mb-2 dark:text-on-primary">
                  <span data-i18n={input.label}>{input.label}</span>
                  {input.required && <span class="text-danger ml-1">*</span>}
                </label>
                
                {input.type === "select" ? (
                  <select
                    id={input.id}
                    class="form-select"
                  >
                    {input.options?.map((opt) => (
                      <option value={opt.value} selected={opt.value === input.defaultValue} data-i18n={opt.label}>{opt.label}</option>
                    ))}
                  </select>
                ) : (
                  <input
                    type={input.type}
                    id={input.id}
                    autocomplete="off"
                    placeholder={input.placeholder}
                    data-i18n-placeholder={input.placeholder}
                    class="form-input"
                  />
                )}
                
                {input.helpText && (
                  <p class="mt-1 text-sm text-muted dark:text-muted" data-i18n={input.helpText}>{input.helpText}</p>
                )}
              </div>
            ))}
          </div>

          <div class="flex gap-4">
            <button
              type="button"
              id="calc-btn"
              class="btn btn-primary"
              data-i18n="calculator.calculate"
            >
              Calculate
            </button>
            <button
              type="button"
              id="reset-btn"
              class="btn btn-secondary"
              data-i18n="calculator.reset"
            >
              Reset
            </button>
          </div>
        </form>
      ) : (
        <form id="calc-form" class="space-y-6" onsubmit="event.preventDefault()">
          <p class="text-body dark:text-muted" data-i18n="calculator.no_inputs">No calculator inputs are configured for this page. Please select a different calculator.</p>
        </form>
      )}
      
      <div id="calc-error" class="mt-4 hidden" role="alert">
         <p class="text-sm text-danger mt-4" data-i18n="calculator.error">Please enter valid values for all required fields</p>
      </div>
      
      </div>
    </div>
    
    <!-- Results Column -->
    <div class="lg:col-span-7 xl:col-span-8">
      <div id="result-wrapper" class="min-h-[400px]" aria-live="polite" aria-atomic="true">
        <div id="calc-announcement" class="sr-only" aria-live="assertive" aria-atomic="true"></div>
        <div id="result-empty" class="empty-state flex flex-col justify-center min-h-[400px] rounded-2xl border-2 border-dashed border-hairline bg-canvas-soft/50 py-16 px-6 dark:border-overlay-lighter dark:bg-surface/30">
          <div class="empty-state-icon mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 dark:bg-on-primary/10">
            <svg class="h-6 w-6 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m-6 4h6m-6 4h4M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          </div>
          <p class="empty-state-title text-lg font-medium text-ink dark:text-on-primary">Your calculation results will appear here.</p>
          <p class="empty-state-description mt-1 text-sm text-muted dark:text-muted">Enter your details above and click Calculate to see your estimated tax.</p>
        </div>

        <div id="result" class="hidden" role="region" aria-label="Calculation results">
          <div class="no-print mb-4 flex flex-wrap items-center justify-between gap-3">
            <h3 class="text-xl font-semibold text-ink dark:text-on-primary" data-i18n="results.title">Results</h3>
            <div class="flex flex-wrap items-center gap-2">
              <button id="print-btn" class="btn btn-secondary btn-sm" aria-label="Print calculator results" onclick="window.print()">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                Print
              </button>
              <button id="copy-result-btn" class="btn btn-secondary btn-sm" aria-label="Copy result to clipboard">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                Copy
              </button>
              <button id="share-btn" class="btn btn-secondary btn-sm" aria-label="Share this calculator">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
                <span data-i18n="actions.share">Share</span>
              </button>
            </div>
          </div>
          
          <PayFrequencyToggle />

          <!-- Dynamic Visual Breakdown Bar -->
          <div id="visual-breakdown-card" class="my-4 rounded-2xl border border-hairline bg-canvas p-5 shadow-sm dark:border-overlay-lighter dark:bg-surface">
            <div class="flex items-center justify-between text-xs font-semibold mb-2">
              <span class="text-ink dark:text-on-primary flex items-center gap-1.5">
                <span>📊</span> Visual Breakdown: Net Retained vs Tax Obligation
              </span>
              <span id="visual-tax-percentage" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-primary/10 text-primary">0% Tax</span>
            </div>

            <div class="h-4 w-full rounded-full bg-canvas-soft dark:bg-canvas overflow-hidden flex border border-hairline dark:border-overlay-light">
              <div id="visual-bar-net" class="bg-emerald-500 transition-all duration-300" style="width: 100%;" title="Net Retained / Base"></div>
              <div id="visual-bar-tax" class="bg-primary transition-all duration-300" style="width: 0%;" title="Tax Obligation"></div>
            </div>

            <div class="grid grid-cols-2 gap-4 mt-3 text-xs">
              <div class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
                <span class="text-muted">Net / Retained:</span>
                <span id="visual-net-text" class="font-bold text-ink dark:text-on-primary">-</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full bg-primary flex-shrink-0"></span>
                <span class="text-muted">Total Tax / Fee:</span>
                <span id="visual-tax-text" class="font-bold text-primary">-</span>
              </div>
            </div>
          </div>


          <div class="rounded-2xl border border-hairline bg-canvas p-6 shadow-sm dark:border-overlay-lighter dark:bg-surface">
             {rule ? (
               <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                 {rule.outputs.map((output) => {
                   const isHighlighted = ['incomeTax', 'totalTax', 'federalTax', 'capitalGainsTax', 'takeHomePay', 'afterTaxIncome', 'afterTaxGain', 'cess', 'totalDeductions', 'stampDuty', 'propertyTax', 'salariesTax', 'profitsTax', 'totalFICA', 'socialSecurity', 'medicare'].includes(output.id);
                   return (
                     <div class={"rounded-lg border p-4 " + (isHighlighted ? "border-primary/30 bg-primary/5 dark:border-primary/20 dark:bg-primary/5" : "border-hairline bg-canvas dark:border-overlay-lighter dark:bg-surface")}>
                       <p class={"text-sm font-medium text-muted dark:text-muted"} data-i18n={output.label}>{output.label}</p>
                       <p class={"mt-2 font-bold overflow-x-auto whitespace-nowrap [scrollbar-width:none] [&::-webkit-scrollbar]:hidden " + (isHighlighted ? "text-2xl text-primary dark:text-on-primary" : "text-xl text-ink dark:text-on-primary")} id={"result-" + output.id}>
                         {output.format === "currency" ? formatCurrency(0, country.currency) : output.format === "percentage" ? "0%" : "0"}
                       </p>
                       <p class="text-xs text-muted mt-1 dark:text-muted" data-i18n={output.description}>{output.description}</p>
                     </div>
                   );
                 })}
               </div>
             ) : (
               <p class="text-3xl font-bold text-primary dark:text-on-primary" id="result-value">
                 {formatCurrency(0, country.currency)}
               </p>
             )}

             <div id="premium-dashboard-wrapper" class="hidden">
               <div id="premium-dashboard-container"></div>
             </div>

              <p class="text-sm text-muted mt-4 dark:text-muted" data-i18n="calculator.estimate_disclaimer">
                This is an estimate. Consult a tax professional for accurate calculations.
              </p>
              
              <TaxReportExport calculatorTitle={calculator.name} currency={country.currency} />
            </div>


           <div class="mt-10">
             <details class="group rounded-xl border border-hairline bg-canvas-soft p-6 transition hover:border-primary focus-within:border-primary dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary">
               <summary class="flex cursor-pointer list-none items-center justify-between text-left" aria-expanded="false" aria-controls="advanced-tools-content" onclick="this.setAttribute('aria-expanded', this.parentElement.hasAttribute('open') ? 'false' : 'true')">
                 <div class="flex items-center gap-3">
                   <svg class="h-5 w-5 text-primary dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                   <h3 class="text-lg font-semibold text-ink dark:text-on-primary">Advanced Tools & Analysis</h3>
                 </div>
                 <svg class="h-5 w-5 shrink-0 text-ink transition-transform duration-200 group-open:rotate-180 dark:text-on-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
               </summary>
               <div id="advanced-tools-content" class="mt-8 space-y-8">
           <TaxSavingsWidget countrySlug={country.slug} currency={country.currency} />

           <TaxBracketVisualizer currency={country.currency} />

           <TaxCalendarWidget countrySlug={country.slug} />

           <TaxRefundEstimator currency={country.currency} />

           <TaxResidencyQuiz countryName={country.name} />

           <GlobalPurchasingPower currency={country.currency} />

           <TaxComparisonModal currency={country.currency} />

               </div>
             </details>
           </div>
           
          <div class="no-print mt-4">
            <button id="copy-result-text-btn" class="btn btn-ghost btn-sm text-muted hover:text-ink dark:text-muted dark:hover:text-on-primary" aria-label="Copy result text">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              Copy
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

  <section id="calc-overview" class="mt-12" aria-labelledby="overview-heading">
    <h2 id="overview-heading" class="text-2xl font-semibold text-ink mb-6 dark:text-on-primary" set:html={mergedContent.overview.title}></h2>
    <div class="rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
      <div class="prose max-w-none text-body dark:text-muted space-y-4 dark:prose-invert dark:text-body" set:html={mergedContent.overview.html}></div>
    </div>
  </section>

  {rule && rule.examples && rule.examples.length > 0 && (
    <div class="mt-12">
      <h2 class="text-2xl font-semibold text-ink mb-6 dark:text-on-primary" set:html={mergedContent.workedExample?.title || "Example Calculation"}></h2>
      <div class="rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <div>
            <h3 class="text-lg font-semibold text-ink mb-4 dark:text-on-primary" set:html={rule.examples[0].title}></h3>
            <div class="space-y-2">
              {Object.entries(rule.examples[0].inputs).map(([key, value]) => {
                const inputDef = rule.inputs.find(i => i.id === key);
                return (
                  <div class="flex justify-between">
                    <span class="text-body dark:text-muted" data-i18n={inputDef?.label || key}>{inputDef?.label || key}:</span>
                    <span class="font-medium text-ink dark:text-on-primary">{value}</span>
                  </div>
                );
              })}
            </div>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-ink mb-4 dark:text-on-primary" data-i18n="result.title">Result</h3>
            <div class="space-y-2">
              {Object.entries(rule.examples[0].outputs).map(([key, value]) => {
                const outputDef = rule.outputs.find(o => o.id === key);
                const formattedValue = outputDef?.format === "currency" 
                  ? formatCurrency(value, country.currency)
                  : outputDef?.format === "percentage"
                  ? `${value}%`
                  : String(value);
                return (
                  <div class="flex justify-between">
                    <span class="text-body dark:text-muted" data-i18n={outputDef?.label || key}>{outputDef?.label || key}:</span>
                    <span class="font-medium text-ink dark:text-on-primary">{formattedValue}</span>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
        <p class="mt-4 text-sm text-muted dark:text-muted" set:html={rule.examples[0].explanation}></p>
      </div>
    </div>
  )}

  {rule && rule.formulas && rule.formulas.length > 0 && (
    <div class="mt-12">
      <h2 class="text-2xl font-semibold text-ink mb-6 dark:text-on-primary" data-i18n="methodology.title">Calculation Methodology</h2>
      <div class="rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
        <div class="space-y-6">
          {rule.formulas.map((formula) => (
            <div>
              <h3 class="text-lg font-semibold text-ink dark:text-on-primary" data-i18n={formula.name}>{formula.name}</h3>
              <code class="block mt-2 rounded-lg bg-canvas-soft p-3 text-sm font-mono text-primary dark:bg-surface dark:text-on-primary">
                {formula.formula}
              </code>
              <p class="mt-2 text-sm text-body dark:text-muted" data-i18n={formula.description}>{formula.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  <script is:inline>
    (function() {
      var form = document.getElementById('calc-form');
      var calcBtn = document.getElementById('calc-btn');
      var resetBtn = document.getElementById('reset-btn');
      var resultDiv = document.getElementById('result');
      var resultEmpty = document.getElementById('result-empty');
      var resultWrapper = document.getElementById('result-wrapper');
      var errorDiv = document.getElementById('calc-error');
      var copyResultBtn = document.getElementById('copy-result-btn');
      var shareBtn = document.getElementById('share-btn');
      var ruleId = form ? form.getAttribute('data-rule-id') : '';
      var currencyCode = form ? form.getAttribute('data-country-currency') || 'USD' : 'USD';

      var currencySymbols = {
        USD: '$', INR: '₹', HKD: 'HK$', SGD: 'S$', IDR: 'Rp',
        MYR: 'RM', NZD: 'NZ$', PKR: 'Rs', PHP: '₱', GBP: '£'
      };

      function getInput(id) {
        var el = document.getElementById(id);
        if (!el) return null;
        if (el.type === 'number') return parseFloat(el.value) || 0;
        return el.value;
      }

      function fmt(num, dec) {
        if (dec === undefined) dec = 2;
        return num.toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec });
      }

      function fmtCurrency(num, code) {
        var sym = currencySymbols[code] || '$';
        var dec = (code === 'IDR' || code === 'PKR' || code === 'INR') ? 0 : 2;
        return sym + fmt(num, dec);
      }

      function setOutput(id, value, format) {
        var el = document.getElementById('result-' + id);
        if (!el) return;
        if (format === 'currency') el.textContent = fmtCurrency(value, currencyCode);
        else if (format === 'percentage') el.textContent = value.toFixed(1) + '%';
        else el.textContent = fmt(value, 0);
      }

      function pTax(income, brackets) {
        var tax = 0, prev = 0;
        for (var i = 0; i < brackets.length; i++) {
          var lim = brackets[i][0], r = brackets[i][1];
          if (income > prev) {
            var taxable = Math.min(income, lim) - prev;
            tax += taxable * r;
          }
          prev = lim;
        }
        return tax;
      }

