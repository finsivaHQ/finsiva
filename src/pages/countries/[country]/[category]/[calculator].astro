      function sharePremiumResult() {
        var dashboard = document.getElementById('premium-dashboard-inner');
        var text = dashboard ? dashboard.innerText : '';
        var title = document.title || 'Finsiva Tax Calculator Result';
        var url = window.location.href;
        if (navigator.share) {
          navigator.share({ title: title, text: text, url: url }).catch(function() {});
        } else if (navigator.clipboard) {
