        if (scheme === 'startup') {
          var t1 = Math.min(income, 100000);
          var t2 = Math.max(0, Math.min(income - 100000, 100000));
          exemptIncome = (t1 * 0.75) + (t2 * 0.50);
        } else {
          var p1 = Math.min(income, 10000);
          var p2 = Math.max(0, Math.min(income - 10000, 190000));
          exemptIncome = (p1 * 0.75) + (p2 * 0.50);
        }

        var taxableProfit = Math.max(0, income - exemptIncome);
        var taxBeforeRebate = taxableProfit * 0.17;
        var citRebateAmount = citRebate === 'yes' ? Math.min(taxBeforeRebate * 0.50, 40000) : 0;
        var netTaxPayable = Math.max(0, taxBeforeRebate - citRebateAmount);
        var effectiveRate = income > 0 ? (netTaxPayable / income) * 100 : 0;

        setOutput('grossTax', grossTax, 'currency');
        setOutput('exemptIncome', exemptIncome, 'currency');
        setOutput('taxableProfit', taxableProfit, 'currency');
        setOutput('citRebateAmount', citRebateAmount, 'currency');
        setOutput('netTaxPayable', netTaxPayable, 'currency');
        setOutput('effectiveRate', effectiveRate, 'percentage');
