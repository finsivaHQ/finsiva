      function buildDonutChart(tax, net, sym) {
        var total = tax + net;
        if (total <= 0) return '';
        var taxPct = (tax / total) * 100;
        var netPct = (net / total) * 100;

        function polar(cx, cy, r, angle) {
          var rad = ((angle - 90) * Math.PI) / 180;
          return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) };
        }

        function arcCmd(cx, cy, r, startAngle, endAngle, sweep) {
          var endPoint = polar(cx, cy, r, endAngle);
          var large = Math.abs(endAngle - startAngle) <= 180 ? '0' : '1';
          return 'A' + r + ' ' + r + ' 0 ' + large + ' ' + sweep + ' ' + endPoint.x + ' ' + endPoint.y;
        }

        function donutSegment(cx, cy, R, r, startAngle, endAngle) {
          var outerStart = polar(cx, cy, R, startAngle);
          var outerEnd = polar(cx, cy, R, endAngle);
          var innerEnd = polar(cx, cy, r, endAngle);
          var innerStart = polar(cx, cy, r, startAngle);
          return 'M' + outerStart.x + ' ' + outerStart.y +
                 arcCmd(cx, cy, R, startAngle, endAngle, 1) +
                 'L' + innerEnd.x + ' ' + innerEnd.y +
                 arcCmd(cx, cy, r, endAngle, startAngle, 0) +
                 'Z';
        }

        var size = 200, cx = 100, cy = 100, R = 80, r = 50;
        var taxPath = taxPct > 0 ? donutSegment(cx, cy, R, r, 0, taxPct) : '';
        var netPath = netPct > 0 ? donutSegment(cx, cy, R, r, taxPct, taxPct + netPct) : '';
        var centerCircle = '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="var(--color-canvas, #ffffff)" />';

        return '<svg viewBox="0 0 ' + size + ' ' + size + '" class="chart-donut" aria-hidden="true">' +
          (taxPath ? '<path d="' + taxPath + '" fill="#EF4444" />' : '') +
          (netPath ? '<path d="' + netPath + '" fill="#22C55E" />' : '') +
          centerCircle +
          '<text x="' + cx + '" y="' + (cy - 8) + '" text-anchor="middle" class="chart-center-text chart-center-label">Total</text>' +
          '<text x="' + cx + '" y="' + (cy + 14) + '" text-anchor="middle" class="chart-center-text chart-center-value">' + sym + total.toLocaleString('en-US', {maximumFractionDigits: 0}) + '</text>' +
        '</svg>' +
        '<div class="chart-legend" role="list">' +
          '<div class="chart-legend-item" role="listitem"><span class="chart-legend-color" style="background-color: #EF4444" aria-hidden="true"></span><span class="chart-legend-label">Tax</span><span class="chart-legend-value">' + sym + tax.toLocaleString('en-US', {maximumFractionDigits: 0}) + ' (' + taxPct.toFixed(1) + '%)</span></div>' +
          '<div class="chart-legend-item" role="listitem"><span class="chart-legend-color" style="background-color: #22C55E" aria-hidden="true"></span><span class="chart-legend-label">Take-home</span><span class="chart-legend-value">' + sym + net.toLocaleString('en-US', {maximumFractionDigits: 0}) + ' (' + netPct.toFixed(1) + '%)</span></div>' +
        '</div>';
      }

      function buildInsights(gross, tax, net, effective, sym, ruleId) {
        if (gross <= 0) return '';
        var taxPct = gross > 0 ? (tax / gross) * 100 : 0;
        var netPct = gross > 0 ? (net / gross) * 100 : 0;
        var insights = [];

        if (taxPct > 0) {
          insights.push({ text: 'Your total tax represents approximately ' + taxPct.toFixed(1) + '% of your gross income.', type: 'info' });
        }
        if (netPct > 50) {
          insights.push({ text: 'The majority of your income (' + netPct.toFixed(1) + '%) remains after tax.', type: 'success' });
        } else if (netPct <= 50 && netPct > 0) {
          insights.push({ text: 'Approximately ' + (100 - netPct).toFixed(1) + '% of your income goes toward taxes.', type: 'warning' });
        }
        if (effective > 0 && effective < 15) {
          insights.push({ text: 'Your effective tax rate of ' + effective.toFixed(1) + '% is relatively low compared to global averages.', type: 'success' });
        } else if (effective >= 15 && effective < 30) {
          insights.push({ text: 'Your effective tax rate of ' + effective.toFixed(1) + '% is within a typical range for this income level.', type: 'info' });
        } else if (effective >= 30) {
          insights.push({ text: 'Your effective tax rate of ' + effective.toFixed(1) + '% is relatively high. Consider exploring eligible deductions or reliefs.', type: 'warning' });
        }
        if (tax > 0 && net > 0) {
          insights.push({ text: 'For every ' + sym + '1,000 you earn, approximately ' + sym + (taxPct * 10).toFixed(0) + ' goes to tax.', type: 'info' });
        }
        if (gross > 0 && tax === 0) {
          insights.push({ text: 'Your income falls within a tax-free threshold. This is common for lower income brackets.', type: 'success' });
        }
        insights = insights.slice(0, 3);

        var items = insights.map(function(ins) {
          var iconSvg = '';
          if (ins.type === 'success') iconSvg = '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
          else if (ins.type === 'warning') iconSvg = '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.774-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>';
          else iconSvg = '<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
          return '<div class="insight-card insight-card--' + ins.type + '" role="listitem">' +
            '<div class="insight-icon" aria-hidden="true">' + iconSvg + '</div>' +
            '<p class="insight-text">' + ins.text + '</p>' +
          '</div>';
        }).join('');

        return '<div class="insights-container" role="region" aria-label="Educational insights">' +
          '<h3 class="insights-title">Key Insights</h3>' +
          '<div class="insights-list">' + items + '</div>' +
        '</div>';
      }

      function buildTaxExplainer(ruleId) {
        var terms = [];
        var isIncomeTax = ruleId.indexOf('income-tax') >= 0 || ruleId.indexOf('salaries-tax') >= 0 || ruleId.indexOf('payroll-tax') >= 0 || ruleId.indexOf('fica') >= 0 || ruleId.indexOf('national-insurance') >= 0;
        var isVatGst = ruleId.indexOf('gst') >= 0 || ruleId.indexOf('vat') >= 0 || ruleId.indexOf('sst') >= 0;
        var isProperty = ruleId.indexOf('stamp-duty') >= 0 || ruleId.indexOf('property-tax') >= 0;

        if (isIncomeTax) {
          terms = [
            { term: 'Effective Tax Rate', definition: 'The average rate at which your income is taxed. It is calculated by dividing your total tax by your gross income. This rate is usually lower than your marginal rate because of progressive taxation.' },
            { term: 'Marginal Tax Rate', definition: 'The highest tax rate applied to your last dollar of income. In progressive tax systems, different portions of your income are taxed at different rates.' },
            { term: 'Taxable Income', definition: 'Your gross income minus allowable deductions, exemptions, and allowances. This is the amount on which your tax is actually calculated.' },
            { term: 'Take-home Pay', definition: 'The amount you receive after all taxes and deductions have been subtracted from your gross income. This is your actual disposable income.' },
            { term: 'Progressive Taxation', definition: 'A tax system where higher income levels are taxed at higher rates. As your income increases, you move into higher tax brackets, but only the income within each bracket is taxed at that bracket\'s rate.' }
          ];
        } else if (isVatGst) {
          terms = [
            { term: 'VAT / GST', definition: 'Value Added Tax or Goods and Services Tax is a consumption tax applied to the value added at each stage of production and distribution.' },
            { term: 'Tax Inclusive', definition: 'The tax is already included in the displayed price. We calculate the actual tax amount by extracting it from the total.' },
            { term: 'Tax Exclusive', definition: 'The tax is added on top of the base amount. We calculate the total by applying the tax rate to the base price.' },
            { term: 'Net Amount', definition: 'The original amount before tax is applied. This is the value of the goods or services excluding tax.' },
            { term: 'Total Amount', definition: 'The final amount you pay, including both the net amount and the applicable tax.' }
          ];
        } else if (isProperty) {
          terms = [
            { term: 'Stamp Duty', definition: 'A tax levied on legal documents, typically on property transfers. It is usually calculated as a percentage of the property value or a fixed amount.' },
            { term: 'Property Tax', definition: 'An annual tax on property ownership, usually based on the assessed value of the property. Rates vary by location and property type.' },
            { term: 'Net Assessable Value', definition: 'The value of the property used for tax calculation after applying standard deductions and allowances.' },
            { term: 'Total Cost', definition: 'The complete cost of acquiring or owning the property, including the purchase price plus all applicable taxes and duties.' }
          ];
        } else {
          terms = [
            { term: 'Effective Rate', definition: 'The average percentage of tax applied to your income or transaction. It shows the true burden relative to the total amount.' },
            { term: 'Tax Amount', definition: 'The calculated tax liability based on the applicable rate and the transaction value or income.' },
            { term: 'Net Amount', definition: 'The original amount before tax is applied.' },
            { term: 'Total Amount', definition: 'The final amount including tax.' }
          ];
        }

        var items = terms.map(function(t) {
          return '<div class="tax-term-card">' +
            '<h4 class="tax-term-name">' + t.term + '</h4>' +
            '<p class="tax-term-definition">' + t.definition + '</p>' +
          '</div>';
        }).join('');

        return '<div class="tax-explainer" role="region" aria-label="Tax terms explained">' +
          '<h3 class="tax-explainer-title">Understanding Your Results</h3>' +
          '<div class="tax-explainer-grid">' + items + '</div>' +
        '</div>';
      }

