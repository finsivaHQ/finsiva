      function calcUSRetirementSavings() {
        var salary = getInput('annualSalary') || 0;
        var filing = getInput('filingStatus') || 'single';
        var c401k = getInput('contribution401k') || 0;
        var cIRA = getInput('contributionIRA') || 0;
        var cHSA = getInput('contributionHSA') || 0;

        var totalContributions = c401k + cIRA + cHSA;

        // Determine marginal bracket based on 2025 brackets
        var marginalRate = 12;
        if (filing === 'married') {
          if (salary > 583750) marginalRate = 37;
          else if (salary > 487450) marginalRate = 35;
          else if (salary > 383900) marginalRate = 32;
          else if (salary > 201050) marginalRate = 24;
          else if (salary > 94300) marginalRate = 22;
          else if (salary > 23200) marginalRate = 12;
          else marginalRate = 10;
        } else {
          if (salary > 583750) marginalRate = 37;
          else if (salary > 243725) marginalRate = 35;
          else if (salary > 191950) marginalRate = 32;
          else if (salary > 100525) marginalRate = 24;
          else if (salary > 47150) marginalRate = 22;
          else if (salary > 11600) marginalRate = 12;
          else marginalRate = 10;
        }

        var taxSavings = totalContributions * (marginalRate / 100);
        var takeHomeReduction = Math.max(0, totalContributions - taxSavings);
        var effectiveDiscount = marginalRate;

        setOutput('totalContributions', totalContributions, 'currency');
        setOutput('marginalRate', marginalRate, 'percentage');
        setOutput('taxSavings', taxSavings, 'currency');
        setOutput('takeHomeReduction', takeHomeReduction, 'currency');
        setOutput('effectiveDiscount', effectiveDiscount, 'percentage');
      }

      function calcUSTaxSavingsEstimator() {
        var income = getInput('grossIncome') || 0;
        var filing = getInput('filingStatus') || 'single';
        var itemized = getInput('itemizedDeductions') || 0;
        var preTax = getInput('preTaxDeductions') || 0;
        var credits = getInput('taxCredits') || 0;

        var standardDeduction = 15000;
        if (filing === 'married') standardDeduction = 30000;
        else if (filing === 'head') standardDeduction = 22500;

        var appliedDeduction = Math.max(standardDeduction, itemized);
        var taxableIncome = Math.max(0, income - appliedDeduction - preTax);

        // Approximate federal tax on taxableIncome
        var tax = 0;
        if (taxableIncome > 100000) tax = 14000 + (taxableIncome - 100000) * 0.24;
        else if (taxableIncome > 47000) tax = 5000 + (taxableIncome - 47000) * 0.22;
        else if (taxableIncome > 11000) tax = 1100 + (taxableIncome - 11000) * 0.12;
        else tax = taxableIncome * 0.10;

        var netTaxPayable = Math.max(0, tax - credits);

        // Baseline tax without pre-tax or credits
        var baselineTaxable = Math.max(0, income - standardDeduction);
        var baselineTax = 0;
        if (baselineTaxable > 100000) baselineTax = 14000 + (baselineTaxable - 100000) * 0.24;
        else if (baselineTaxable > 47000) baselineTax = 5000 + (baselineTaxable - 47000) * 0.22;
        else if (baselineTaxable > 11000) baselineTax = 1100 + (baselineTaxable - 11000) * 0.12;
        else baselineTax = baselineTaxable * 0.10;

        var totalTaxSaved = Math.max(0, baselineTax - netTaxPayable);

        setOutput('standardDeduction', standardDeduction, 'currency');
        setOutput('appliedDeduction', appliedDeduction, 'currency');
        setOutput('taxableIncome', taxableIncome, 'currency');
        setOutput('netTaxPayable', netTaxPayable, 'currency');
        setOutput('totalTaxSaved', totalTaxSaved, 'currency');
      }

      function calcUSIRSPaymentPlan() {
        var balance = getInput('taxOwed') || 0;
        var planType = getInput('planType') || 'direct_debit';
        var payment = getInput('monthlyPayment') || 100;

        var fee = 31;
        if (planType === 'short_term') fee = 0;
        else if (planType === 'standard_installment') fee = 130;

        var months = payment > 0 ? Math.ceil(balance / payment) : 0;
        // Failure to pay penalty: 0.25% per month while in agreement
        // Interest: approx 8% annual = ~0.67% per month
        var monthlyFactor = 0.0092; 
        var estimatedInterestAndPenalties = Math.round(balance * (months * monthlyFactor * 0.55));
        var totalRepayment = balance + fee + estimatedInterestAndPenalties;

        setOutput('setupFee', fee, 'currency');
        setOutput('monthsToPayoff', months, 'number');
        setOutput('estimatedInterestAndPenalties', estimatedInterestAndPenalties, 'currency');
        setOutput('totalRepayment', totalRepayment, 'currency');
      }

      function calcUSIRSRefundStatus() {
        var method = getInput('filingMethod') || 'efile_dd';
        var days = getInput('daysSinceFiling') || 0;
        var eitc = getInput('claimEITC') || 'no';

        var targetDays = 21;
        if (method === 'efile_check') targetDays = 28;
        else if (method === 'paper_mail') targetDays = 56;
        if (eitc === 'yes') targetDays = Math.max(targetDays, 30);

        var remaining = Math.max(0, targetDays - days);

        setOutput('standardTargetDays', targetDays, 'number');
        setOutput('daysRemaining', remaining, 'number');
      }

      function calculate() {
        if (!form) return;

        var inputs = form.querySelectorAll('input[required], select[required]');
        var valid = true;
        inputs.forEach(function(input) {
          if ((input.type === 'number' && (!input.value || parseFloat(input.value) <= 0)) ||
              (input.tagName === 'SELECT' && !input.value)) {
            valid = false;
            markInvalid(input);
          } else {
            clearInvalid(input);
          }
        });

        if (!valid) { showError(); return; }
        hideError();

        try {
          if (ruleId === 'united-states-income-tax-federal-income-tax') calcUSFederalIncomeTax();
          else if (ruleId === 'united-states-income-tax-state-income-tax') calcStateTax();
          else if (ruleId === 'united-states-payroll-tax-payroll-tax-calculator') calcFICA();
          else if (ruleId === 'united-states-corporate-tax-corporate-tax-calculator') calcCorporate();
          else if (ruleId === 'united-states-capital-gains-tax-capital-gains-calculator') calcCapitalGains();
          else if (ruleId === 'india-income-tax-income-tax-calculator') calcIndiaIncomeTax();
          else if (ruleId === 'india-gst-gst-calculator') calcGenericVATorGST(getInput('gstRate') || '0.18', getInput('calculationType') || 'exclusive');
          else if (ruleId === 'india-tds-tds-calculator') calcTDS();
          else if (ruleId === 'malaysia-income-tax-income-tax-calculator') calcMYIncomeTax();
          else if (ruleId === 'malaysia-foreign-income-foreign-income-calculator') calcMYForeignIncomeTax();
          else if (ruleId === 'malaysia-rental-income-rental-income-calculator') calcMYRentalIncomeTax();
          else if (ruleId === 'malaysia-sst-sst-calculator') calcSST();
          else if (ruleId === 'new-zealand-income-tax-income-tax-calculator') calcNZIncomeTax();
          else if (ruleId === 'new-zealand-gst-gst-calculator') calcGenericVATorGST(0.15, getInput('calculationType') || 'exclusive');
          else if (ruleId === 'pakistan-income-tax-income-tax-calculator') calcPKIncomeTax();
          else if (ruleId === 'pakistan-sales-tax-sales-tax-calculator') calcGenericVATorGST(0.18, getInput('calculationType') || 'exclusive');
          else if (ruleId === 'philippines-income-tax-income-tax-calculator') calcPHIncomeTax();
          else if (ruleId === 'philippines-vat-vat-calculator') calcGenericVATorGST(0.12, getInput('calculationType') || 'exclusive');
          else if (ruleId === 'united-kingdom-income-tax-income-tax-calculator') calcUKIncomeTax();
          else if (ruleId === 'united-kingdom-vat-vat-calculator') calcGenericVATorGST(getInput('vatRate') || '0.20', getInput('calculationType') || 'exclusive');
          else if (ruleId === 'united-kingdom-national-insurance-ni-calculator') calcNIContributions();
          else if (ruleId === 'united-kingdom-vehicle-tax-ev-tax-calculator') calcUKEVTax();
          else if (ruleId === 'hong-kong-salaries-tax-salaries-tax-calculator') calcHKSalariesTax();
          else if (ruleId === 'singapore-income-tax-income-tax-calculator') calcSGIncomeTax();
          else if (ruleId === 'singapore-gst-gst-calculator') calcGenericVATorGST(getInput('gstRate') || '0.09', getInput('calculationType') || 'exclusive');
          else if (ruleId === 'singapore-stamp-duty-stamp-duty-calculator') calcStampDuty();
          else if (ruleId === 'singapore-corporate-tax-income-tax-calculator') calcSGCorporateTax();
          else if (ruleId === 'united-states-tax-planning-retirement-contribution-calculator') calcUSRetirementSavings();
          else if (ruleId === 'united-states-tax-planning-tax-savings-estimator') calcUSTaxSavingsEstimator();
          else if (ruleId === 'united-states-irs-support-irs-payment-planner') calcUSIRSPaymentPlan();
          else if (ruleId === 'united-states-irs-support-irs-refund-status') calcUSIRSRefundStatus();
          else if (ruleId === 'indonesia-income-tax-income-tax-calculator') calcIDIncomeTax();
          else if (ruleId === 'indonesia-vat-vat-calculator') calcGenericVATorGST(0.11, getInput('calculationType') || 'exclusive');
          else if (ruleId === 'united-states-income-tax-effective-tax-rate') calcEffectiveRate();
          else if (ruleId === 'united-states-estate-tax-estate-tax-calculator') calcEstateTax();
          else if (ruleId === 'united-states-payroll-tax-fica-calculator') calcFICA();
          else if (ruleId === 'united-states-payroll-tax-self-employment-tax') calcFICA();
          else if (ruleId === 'united-states-corporate-tax-small-business-tax') calcCorporate();
          else if (ruleId === 'united-states-capital-gains-tax-ltcg-calculator') calcCapitalGains();
          else if (ruleId === 'hong-kong-salaries-tax-salary-tax-computation') calcHKSalariesTax();
          else if (ruleId === 'hong-kong-salaries-tax-hk-net-salary-calculator') calcHKSalariesTax();
          else if (ruleId === 'hong-kong-salaries-tax-hong-kong-tax-calculator-for-expats') calcHKSalariesTax();
          else if (ruleId === 'hong-kong-salaries-tax-hong-kong-income-tax-for-foreigners-calculator') calcHKSalariesTax();
          else if (ruleId === 'hong-kong-profits-tax-hk-corporate-tax-calculator') calcHKProfitsTax();
          else if (ruleId === 'hong-kong-profits-tax-profit-tax-computation') calcHKProfitsTax();
          else if (ruleId === 'hong-kong-stamp-duty-hk-property-stamp-duty-calculator') calcStampDuty();
          else if (ruleId === 'hong-kong-stamp-duty-stamp-duty-calculator') calcStampDuty();
          else if (ruleId === 'hong-kong-stamp-duty-rental-stamp-duty-calculator') calcStampDuty();
          else if (ruleId === 'hong-kong-stamp-duty-first-registration-tax-calculator') calcHKFirstRegTax();
