---
import CountryLayout from "../../../../layouts/CountryLayout.astro";
import { countries } from "../../../../data/countries";
import { getCountryBySlug, getCategoryBySlug } from "../../../../data/countries";
import FactCheckedBadge from "../../../../components/FactCheckedBadge.astro";
import AuthorBioCard from "../../../../components/AuthorBioCard.astro";

export function getStaticPaths() {
  return countries.flatMap(country => 
    country.taxCategories.map(category => ({
      params: { 
        country: country.slug, 
        category: category.slug 
      }
    }))
  );
}

const country = getCountryBySlug(Astro.params.country!);
const category = getCategoryBySlug(Astro.params.country!, Astro.params.category!);

if (!country || !category) {
  return Astro.redirect("/countries");
}
---

<CountryLayout
  title={`${country.name} ${category.name} ${country.taxYear}`}
  description={`Comprehensive guide to ${country.name} ${category.name} for ${country.taxYear}. ${category.description}`}
  canonical={`https://finsiva.com/countries/${country.slug}/${category.slug}`}
  breadcrumbs={[
    { label: "Countries", href: "/countries" },
    { label: country.name, href: `/countries/${country.slug}` },
    { label: category.name }
  ]}
>
  <div class="mb-6">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-ink dark:text-on-primary tracking-tight">
      <span data-i18n="category.name">{category.name}</span>
    </h1>
    <p class="mt-2 text-base sm:text-lg text-body dark:text-muted">
      <span data-i18n="category.description">{category.description}</span>
    </p>
  </div>

  <FactCheckedBadge
    reviewerName="Finsiva Tax Compliance Board"
    reviewerTitle="Certified Tax Policy Analysts"
    sourceName={country.officialTaxAuthority}
    sourceUrl={country.taxAuthorityUrl}
    lastChecked={country.taxYear}
  />

  <!-- CATEGORY QUICK SWITCHER -->
  <div class="mb-8 p-4 rounded-2xl border border-hairline bg-canvas-soft dark:border-overlay-lighter dark:bg-surface/50">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-wider text-muted dark:text-muted mr-1">{country.name} Tax Categories:</span>
      {country.taxCategories.map(cat => (
        <a 
          href={`/countries/${country.slug}/${cat.slug}`}
          class={`px-3 py-1.5 rounded-full text-xs font-semibold transition ${cat.slug === category.slug ? 'bg-primary text-on-primary shadow-sm dark:bg-on-primary dark:text-primary' : 'bg-canvas border border-hairline text-ink hover:border-primary dark:bg-surface dark:text-on-primary dark:border-overlay-lighter'}`}
        >
          {cat.name}
        </a>
      ))}
    </div>
  </div>

  <div class="max-w-none mb-12">
    <p class="text-base text-body leading-relaxed dark:text-muted"><span data-i18n="category.overview">{category.overview}</span></p>
  </div>

  <!-- CALCULATORS SECTION -->
  {category.calculators.length > 0 && (
    <section class="mb-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-ink dark:text-on-primary flex items-center gap-2" data-i18n="country.calculators">
          <span>🧮</span> Calculators
        </h2>
        <span class="text-xs text-muted font-medium">{category.calculators.length} Tools Available</span>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {category.calculators.map(calc => {
          const isPop = calc.isPopular || country.popularCalculators?.some(p => p.slug === calc.slug);
          return (
            <a
              href={`/countries/${country.slug}/${category.slug}/${calc.slug}`}
              class="group relative flex flex-col justify-between p-6 border border-hairline rounded-2xl bg-canvas shadow-sm hover:border-primary hover:shadow-md hover:-translate-y-0.5 transition-all dark:border-overlay-lighter dark:bg-surface"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <h3 class="font-bold text-lg text-ink group-hover:text-primary transition-colors dark:text-on-primary leading-snug">
                    <span data-i18n="calculator.name">{calc.name}</span>
                  </h3>
                  {isPop && (
                    <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-600 dark:bg-amber-400/20 dark:text-amber-300 border border-amber-500/30 shrink-0">
                      🔥 Top Tool
                    </span>
                  )}
                </div>
                <p class="text-xs sm:text-sm text-body dark:text-muted leading-relaxed">
                  <span data-i18n="calculator.description">{calc.description}</span>
                </p>
              </div>
              <div class="mt-5 pt-3 border-t border-hairline dark:border-overlay-lighter flex items-center justify-between text-xs font-semibold text-primary dark:text-link">
                <span>Launch Calculator</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- GUIDES SECTION -->
  {category.guides.length > 0 && (
    <section class="mb-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-ink dark:text-on-primary flex items-center gap-2" data-i18n="country.guides">
          <span>📘</span> Tax Guides & Explanations
        </h2>
        <span class="text-xs text-muted font-medium">{category.guides.length} Articles</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {category.guides.map(guide => (
          <a
            href={`/countries/${country.slug}/${category.slug}/${guide.slug}`}
            class="group rounded-2xl border border-hairline bg-canvas p-6 shadow-sm transition-all hover:border-primary hover:shadow-md hover:-translate-y-0.5 dark:border-overlay-lighter dark:bg-surface flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center gap-2 mb-2 text-primary font-semibold text-xs uppercase tracking-wider">
                <span>Official Guide</span>
              </div>
              <h3 class="font-bold text-lg text-ink group-hover:text-primary transition-colors dark:text-on-primary leading-snug">
                <span data-i18n="guide.title">{guide.title}</span>
              </h3>
              <p class="text-xs sm:text-sm text-body dark:text-muted mt-2 leading-relaxed">
                <span data-i18n="guide.description">{guide.description}</span>
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-hairline dark:border-overlay-lighter flex items-center justify-between text-xs font-semibold text-primary dark:text-link">
              <span>Read Full Guide</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- FAQS SECTION -->
  {category.faqs.length > 0 && (
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-ink mb-6 dark:text-on-primary flex items-center gap-2" data-i18n="category.frequently_asked_questions">
        <span>❓</span> Frequently Asked Questions
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {category.faqs.map(faq => (
          <div class="rounded-2xl border border-hairline bg-canvas p-6 shadow-sm dark:border-overlay-lighter dark:bg-surface">
            <h3 class="font-bold text-base text-ink dark:text-on-primary flex items-start gap-2.5">
              <span class="text-primary font-extrabold text-base shrink-0">Q.</span>
              <span data-i18n="faq.question">{faq.question}</span>
            </h3>
            <p class="mt-3 text-xs sm:text-sm text-body leading-relaxed dark:text-muted pl-6 border-l-2 border-primary/30 dark:border-primary/40">
              <span data-i18n="faq.answer">{faq.answer}</span>
            </p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- RELATED CATEGORIES SECTION -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-ink mb-6 dark:text-on-primary flex items-center gap-2" data-i18n="category.related_categories">
      <span>🌐</span> Related Tax Categories
    </h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {country.taxCategories
        .filter(c => c.slug !== category.slug)
        .slice(0, 6)
        .map(related => (
          <a
            href={`/countries/${country.slug}/${related.slug}`}
            class="group rounded-2xl border border-hairline bg-canvas p-5 shadow-sm hover:border-primary hover:shadow-md hover:-translate-y-0.5 transition-all dark:border-overlay-lighter dark:bg-surface flex flex-col justify-between"
          >
            <div>
              <h3 class="font-bold text-base text-ink group-hover:text-primary transition-colors dark:text-on-primary">
                <span data-i18n="related.name">{related.name}</span>
              </h3>
              <p class="text-xs text-muted mt-2 leading-relaxed dark:text-muted">
                <span data-i18n="related.description">{related.description}</span>
              </p>
            </div>
            <div class="mt-4 text-xs font-semibold text-primary group-hover:underline dark:text-link">
              Explore {related.name} →
            </div>
          </a>
        ))}
    </div>
  </section>

  <!-- DEEP DIVE SECTION -->
  <section class="mt-12 rounded-2xl border border-hairline bg-canvas-soft p-6 sm:p-8 dark:border-overlay-light dark:bg-surface" aria-labelledby="category-deep-dive">
    <h2 id="category-deep-dive" class="text-2xl font-bold text-ink mb-4 dark:text-on-primary">Deep Dive Into {category.name}</h2>
    <p class="text-sm sm:text-base text-body leading-relaxed dark:text-muted">{category.name} in {country.name} represents one of the most important areas of personal and business finance. Whether you are an employee, a business owner, an investor, or a freelancer, understanding the rules, thresholds, and reliefs within this category helps you make informed decisions and stay compliant with local tax obligations.</p>
    <p class="mt-4 text-sm sm:text-base text-body leading-relaxed dark:text-muted">The tax framework for {category.name.toLowerCase()} is designed to balance revenue generation with economic incentives. Over the years, {country.name} has refined its approach to ensure fairness while encouraging investment, entrepreneurship, and responsible financial planning. Our calculators and guides are updated regularly to reflect these changes, giving you accurate estimates for planning purposes.</p>
    <p class="mt-4 text-sm sm:text-base text-body leading-relaxed dark:text-muted">We recommend starting with the calculators listed above to get a baseline estimate, then reviewing the guides for detailed explanations of how the numbers are derived. If you have specific questions, the FAQ section addresses common scenarios, and our Knowledge Center covers foundational concepts that apply across multiple jurisdictions.</p>
  </section>

  <section class="mt-8 rounded-2xl border border-hairline bg-canvas p-6 sm:p-8 dark:border-overlay-lighter dark:bg-surface" aria-labelledby="category-tips">
    <h2 id="category-tips" class="text-2xl font-bold text-ink mb-4 dark:text-on-primary">Practical Tips for {country.name} Taxpayers</h2>
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <li class="flex items-start gap-3 text-xs sm:text-sm text-body dark:text-muted">
        <svg class="mt-0.5 h-5 w-5 text-primary flex-shrink-0 dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 0 0118 0z" /></svg>
        <span>Review your {category.name.toLowerCase()} position at least annually to capture new thresholds or reliefs.</span>
      </li>
      <li class="flex items-start gap-3 text-xs sm:text-sm text-body dark:text-muted">
        <svg class="mt-0.5 h-5 w-5 text-primary flex-shrink-0 dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 0 0118 0z" /></svg>
        <span>Keep detailed records of income, expenses, and supporting documents for easy verification.</span>
      </li>
      <li class="flex items-start gap-3 text-xs sm:text-sm text-body dark:text-muted">
        <svg class="mt-0.5 h-5 w-5 text-primary flex-shrink-0 dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 0 0118 0z" /></svg>
        <span>Use our interactive calculators to compare scenarios before making financial decisions.</span>
      </li>
      <li class="flex items-start gap-3 text-xs sm:text-sm text-body dark:text-muted">
        <svg class="mt-0.5 h-5 w-5 text-primary flex-shrink-0 dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 0 0118 0z" /></svg>
        <span>Consult a tax professional for complex situations involving multiple income sources or cross-border elements.</span>
      </li>
      <li class="flex items-start gap-3 text-xs sm:text-sm text-body dark:text-muted">
        <svg class="mt-0.5 h-5 w-5 text-primary flex-shrink-0 dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 0 0118 0z" /></svg>
        <span>File returns and payments on time to avoid penalties, interest, and compliance issues.</span>
      </li>
      <li class="flex items-start gap-3 text-xs sm:text-sm text-body dark:text-muted">
        <svg class="mt-0.5 h-5 w-5 text-primary flex-shrink-0 dark:text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 0 0118 0z" /></svg>
        <span>Claim all eligible deductions and credits; missing them increases your effective tax rate unnecessarily.</span>
      </li>
    </ul>
  </section>

  <section class="mt-8 rounded-2xl border border-hairline bg-canvas-soft p-6 sm:p-8 dark:border-overlay-light dark:bg-surface" aria-labelledby="category-resources">
    <h2 id="category-resources" class="text-2xl font-bold text-ink mb-4 dark:text-on-primary">Recommended Resources</h2>
    <p class="text-sm sm:text-base text-body leading-relaxed dark:text-muted">For the most accurate and up-to-date information on {category.name.toLowerCase()} in {country.name}, we recommend consulting the following resources. Official tax authority publications provide the definitive rules, while our guides and calculators offer practical explanations and instant estimates.</p>
    <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <a href={country.taxAuthorityUrl} target="_blank" rel="noopener" class="group rounded-2xl border border-hairline bg-canvas p-5 shadow-sm hover:border-primary hover:shadow-md hover:-translate-y-0.5 transition-all dark:border-overlay-lighter dark:bg-surface">
        <h3 class="font-bold text-base text-ink group-hover:text-primary transition-colors dark:text-on-primary">{country.officialTaxAuthority}</h3>
        <p class="text-xs text-muted mt-2 leading-relaxed dark:text-muted">Official forms, rates, guidance, and filing portals.</p>
      </a>
      <a href={`/countries/${country.slug}`} class="group rounded-2xl border border-hairline bg-canvas p-5 shadow-sm hover:border-primary hover:shadow-md hover:-translate-y-0.5 transition-all dark:border-overlay-lighter dark:bg-surface">
        <h3 class="font-bold text-base text-ink group-hover:text-primary transition-colors dark:text-on-primary">{country.name} Overview</h3>
        <p class="text-xs text-muted mt-2 leading-relaxed dark:text-muted">All tax categories, calculators, and guides for {country.name}.</p>
      </a>
      <a href="/knowledge" class="group rounded-2xl border border-hairline bg-canvas p-5 shadow-sm hover:border-primary hover:shadow-md hover:-translate-y-0.5 transition-all dark:border-overlay-lighter dark:bg-surface">
        <h3 class="font-bold text-base text-ink group-hover:text-primary transition-colors dark:text-on-primary">Knowledge Center</h3>
        <p class="text-xs text-muted mt-2 leading-relaxed dark:text-muted">Learn tax fundamentals, glossary terms, and planning strategies.</p>
      </a>
    </div>
  </section>

  <div class="mt-12">
    <AuthorBioCard
      name="Finsiva Financial Editorial Board"
      lastVerified={country.taxYear}
    />
  </div>
</CountryLayout>
