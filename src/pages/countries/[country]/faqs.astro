---
import CountryLayout from "../../../layouts/CountryLayout.astro";
import { countries, getCountryBySlug } from "../../../data/countries";
import FactCheckedBadge from "../../../components/FactCheckedBadge.astro";
import AuthorBioCard from "../../../components/AuthorBioCard.astro";

export function getStaticPaths() {
  return countries.map(country => ({
    params: { country: country.slug }
  }));
}

const country = getCountryBySlug(Astro.params.country!);

if (!country) {
  return Astro.redirect("/countries");
}

// Collect all FAQs for schema and count
const allFaqEntities: Array<{ question: string; answer: string; category?: string }> = [];

if (country.countryFAQs && country.countryFAQs.length > 0) {
  country.countryFAQs.forEach(faq => {
    allFaqEntities.push({
      question: faq.question,
      answer: faq.answer,
      category: "General & Overview"
    });
  });
}

country.taxCategories.forEach(category => {
  if (category.faqs && category.faqs.length > 0) {
    category.faqs.forEach(faq => {
      allFaqEntities.push({
        question: faq.question,
        answer: faq.answer,
        category: category.name
      });
    });
  }
});

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "name": `${country.name} Tax Frequently Asked Questions (${country.taxYear})`,
  "url": `https://finsiva.com/countries/${country.slug}/faqs/`,
  "description": `Comprehensive, expert-verified answers to common tax questions in ${country.name} for tax year ${country.taxYear}.`,
  "mainEntity": allFaqEntities.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

const categoriesWithFaqs = country.taxCategories.filter(c => c.faqs && c.faqs.length > 0);
---

<CountryLayout
  title={`${country.name} Tax FAQs (${country.taxYear}): Expert Answers & Calculations`}
  description={`Official tax FAQ hub for ${country.name} (${country.taxYear}). Authoritative answers on income tax brackets, filing deadlines, deductions, business tax, and calculator guides.`}
  canonical={`https://finsiva.com/countries/${country.slug}/faqs/`}
  breadcrumbs={[
    { label: "Countries", href: "/countries/" },
    { label: country.name, href: `/countries/${country.slug}/` },
    { label: "Tax FAQs" }
  ]}
  schema={faqSchema}
  robots="index,follow"
>
  <!-- HERO HEADER -->
  <header class="mb-10">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-primary/10 text-primary dark:bg-primary/20 dark:text-link border border-primary/20 mb-4">
      <span class="text-base leading-none">{country.flag}</span>
      <span>{country.name} Tax Intelligence Hub</span>
    </div>
    
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-ink dark:text-on-primary tracking-tight leading-tight">
      {country.name} Tax FAQs &amp; Expert Answers
    </h1>
    
    <p class="mt-4 text-base sm:text-lg text-body dark:text-muted max-w-3xl leading-relaxed">
      Navigating {country.name} tax compliance, progressive brackets, and statutory filing guidelines requires clear, definitive guidance. Below is our consolidated reference answering {allFaqEntities.length} frequently asked tax questions across all {country.name} tax categories for the {country.taxYear} fiscal year.
    </p>

    <div class="mt-4">
      <FactCheckedBadge
        lastChecked={`Tax Year ${country.taxYear}`}
        reviewerName="Finsiva Statutory Research"
        reviewerRole="International Tax Desk"
      />
    </div>

    <!-- QUICK STATS BAR -->
    <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4 p-5 rounded-2xl border border-hairline bg-canvas-soft dark:border-overlay-lighter dark:bg-surface/50">
      <div>
        <div class="text-xs uppercase tracking-wider text-muted font-medium">Tax Authority</div>
        <div class="font-bold text-sm sm:text-base text-ink dark:text-on-primary truncate mt-0.5" title={country.officialTaxAuthority}>
          <a href={country.taxAuthorityUrl} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
            {country.officialTaxAuthority} ↗
          </a>
        </div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-muted font-medium">Filing Deadline</div>
        <div class="font-bold text-sm sm:text-base text-ink dark:text-on-primary mt-0.5">
          {country.filingDeadline || "Check IRS / Local Calendar"}
        </div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-muted font-medium">Currency</div>
        <div class="font-bold text-sm sm:text-base text-ink dark:text-on-primary mt-0.5">
          {country.currency}
        </div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-muted font-medium">Questions Answered</div>
        <div class="font-bold text-sm sm:text-base text-ink dark:text-on-primary mt-0.5">
          {allFaqEntities.length} Verified Solutions
        </div>
      </div>
    </div>
  </header>

  <!-- CATEGORY JUMP SWITCHER -->
  <nav class="mb-12 p-4 rounded-2xl border border-hairline bg-canvas shadow-sm dark:border-overlay-lighter dark:bg-surface" aria-label="FAQ Category Navigation">
    <div class="flex items-center gap-2 mb-3">
      <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
      <span class="text-xs font-bold uppercase tracking-wider text-ink dark:text-on-primary">Jump to Tax Category:</span>
    </div>
    <div class="flex flex-wrap gap-2">
      {country.countryFAQs && country.countryFAQs.length > 0 && (
        <a
          href="#general-overview"
          class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-canvas-soft border border-hairline text-ink hover:border-primary hover:text-primary transition dark:bg-surface dark:text-on-primary dark:border-overlay-lighter"
        >
          General Overview ({country.countryFAQs.length})
        </a>
      )}
      {categoriesWithFaqs.map(cat => (
        <a
          href={`#${cat.slug}`}
          class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-canvas-soft border border-hairline text-ink hover:border-primary hover:text-primary transition dark:bg-surface dark:text-on-primary dark:border-overlay-lighter"
        >
          {cat.name} ({cat.faqs.length})
        </a>
      ))}
      <a
        href="#calculators"
        class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-canvas-soft border border-hairline text-ink hover:border-primary hover:text-primary transition dark:bg-surface dark:text-on-primary dark:border-overlay-lighter"
      >
        🧮 Interactive Calculators
      </a>
    </div>
  </nav>

  <!-- SECTION 1: GENERAL COUNTRY FAQS -->
  {country.countryFAQs && country.countryFAQs.length > 0 && (
    <section id="general-overview" class="mb-14 scroll-mt-24">
      <div class="flex items-center justify-between pb-4 mb-6 border-b border-hairline dark:border-overlay-lighter">
        <div>
          <h2 class="text-2xl font-bold text-ink dark:text-on-primary flex items-center gap-2">
            <span>🏛️</span> General {country.name} Tax Overview FAQs
          </h2>
          <p class="mt-1 text-sm text-body dark:text-muted">
            Foundational rules, residency criteria, and system architecture for taxpayers in {country.name}.
          </p>
        </div>
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-primary/10 text-primary dark:bg-primary/20 dark:text-link border border-primary/20 shrink-0 hidden sm:inline-block">
          {country.countryFAQs.length} FAQs
        </span>
      </div>

      <div class="space-y-4">
        {country.countryFAQs.map((faq, index) => (
          <details
            class="group rounded-2xl border border-hairline bg-canvas p-5 shadow-sm transition hover:border-primary/50 dark:border-overlay-lighter dark:bg-surface"
            id={`faq-general-${index}`}
            open={index === 0}
          >
            <summary class="flex cursor-pointer items-start justify-between gap-4 font-bold text-base sm:text-lg text-ink dark:text-on-primary list-none">
              <span class="flex items-start gap-3">
                <span class="text-primary font-black shrink-0">Q.</span>
                <span>{faq.question}</span>
              </span>
              <span class="ml-2 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-canvas-soft text-ink transition-transform duration-200 group-open:rotate-180 dark:bg-surface dark:text-on-primary border border-hairline">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 pt-4 border-t border-hairline/60 dark:border-overlay-lighter/60 pl-7 text-sm sm:text-base text-body leading-relaxed dark:text-muted">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  )}

  <!-- SECTION 2: CATEGORY-SPECIFIC FAQS -->
  {categoriesWithFaqs.map(category => (
    <section id={category.slug} class="mb-14 scroll-mt-24">
      <div class="rounded-3xl border border-hairline bg-canvas-soft/60 p-6 sm:p-8 dark:border-overlay-lighter dark:bg-surface/30">
        <!-- CATEGORY HEADER -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 mb-6 border-b border-hairline dark:border-overlay-lighter">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-primary dark:text-link mb-1">
              {country.name} Tax Category
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-ink dark:text-on-primary">
              {category.name} FAQs
            </h2>
            <p class="mt-2 text-sm sm:text-base text-body dark:text-muted max-w-2xl">
              {category.description}
            </p>
          </div>
          <div class="shrink-0 flex items-center gap-2">
            <a
              href={`/countries/${country.slug}/${category.slug}/`}
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-primary text-on-primary hover:opacity-90 transition shadow-sm dark:bg-on-primary dark:text-primary"
            >
              <span>Explore {category.name} Hub</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- CATEGORY CALCULATORS / DIRECT TOOLS CALLOUT (ISSUEBOX RULE 10) -->
        {category.calculators && category.calculators.length > 0 && (
          <div class="mb-6 p-4 rounded-2xl bg-canvas border border-hairline shadow-sm dark:bg-surface dark:border-overlay-lighter">
            <div class="text-xs font-bold uppercase tracking-wider text-muted dark:text-muted mb-2 flex items-center gap-1.5">
              <span>🧮</span> Direct Calculation Tools for {category.name}:
            </div>
            <div class="flex flex-wrap gap-2">
              {category.calculators.map(calc => (
                <a
                  href={`/countries/${country.slug}/${category.slug}/${calc.slug}/`}
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-canvas-soft border border-hairline text-ink hover:border-primary hover:text-primary transition dark:bg-surface dark:text-on-primary dark:border-overlay-lighter"
                >
                  <span>{calc.name}</span>
                  <span class="text-primary text-[10px]">↗</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- FAQ ACCORDIONS -->
        <div class="space-y-4">
          {category.faqs.map((faq, idx) => (
            <details
              class="group rounded-2xl border border-hairline bg-canvas p-5 shadow-sm transition hover:border-primary/50 dark:border-overlay-lighter dark:bg-surface"
              id={`${category.slug}-faq-${idx}`}
              open={idx === 0}
            >
              <summary class="flex cursor-pointer items-start justify-between gap-4 font-bold text-base sm:text-lg text-ink dark:text-on-primary list-none">
                <span class="flex items-start gap-3">
                  <span class="text-primary font-black shrink-0">Q.</span>
                  <span>{faq.question}</span>
                </span>
                <span class="ml-2 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-canvas-soft text-ink transition-transform duration-200 group-open:rotate-180 dark:bg-surface dark:text-on-primary border border-hairline">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="mt-4 pt-4 border-t border-hairline/60 dark:border-overlay-lighter/60 pl-7 text-sm sm:text-base text-body leading-relaxed dark:text-muted">
                <p>{faq.answer}</p>
                <div class="mt-4 pt-3 border-t border-hairline/40 flex flex-wrap items-center justify-between gap-2 text-xs">
                  <span class="text-muted">Category: {category.name}</span>
                  <a
                    href={`/countries/${country.slug}/${category.slug}/`}
                    class="font-semibold text-primary hover:underline dark:text-link"
                  >
                    View detailed {category.name} rules &amp; rates →
                  </a>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- SECTION 3: INTERACTIVE CALCULATORS SUITE -->
  <section id="calculators" class="mb-14 scroll-mt-24">
    <div class="p-6 sm:p-8 rounded-3xl border border-hairline bg-canvas shadow-sm dark:border-overlay-lighter dark:bg-surface">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-ink dark:text-on-primary flex items-center gap-2">
            <span>🧮</span> {country.name} Interactive Tax Calculators
          </h2>
          <p class="mt-2 text-sm sm:text-base text-body dark:text-muted">
            Model your specific tax scenarios and estimate take-home pay, business tax, or investment liability.
          </p>
        </div>
        <a
          href={`/countries/${country.slug}/`}
          class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:underline dark:text-link"
        >
          View All Country Calculators →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {country.taxCategories.flatMap(c => 
          c.calculators.map(calc => ({
            ...calc,
            categorySlug: c.slug,
            categoryName: c.name
          }))
        ).slice(0, 9).map(calc => (
          <a
            href={`/countries/${country.slug}/${calc.categorySlug}/${calc.slug}/`}
            class="group p-5 rounded-2xl border border-hairline bg-canvas-soft hover:border-primary hover:shadow-md transition dark:bg-surface dark:border-overlay-lighter flex flex-col justify-between"
          >
            <div>
              <div class="text-[11px] font-bold uppercase tracking-wider text-primary dark:text-link mb-1">
                {calc.categoryName}
              </div>
              <h3 class="font-bold text-base text-ink group-hover:text-primary transition-colors dark:text-on-primary">
                {calc.name}
              </h3>
              <p class="mt-2 text-xs text-muted leading-relaxed line-clamp-2">
                {calc.description}
              </p>
            </div>
            <div class="mt-4 text-xs font-bold text-primary dark:text-link flex items-center gap-1">
              <span>Calculate Now</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 4: STATUTORY AUTHORITY & FILING GUIDANCE -->
  <section class="mb-14">
    <div class="rounded-3xl border border-hairline bg-canvas-soft p-6 sm:p-8 dark:border-overlay-lighter dark:bg-surface/40">
      <h2 class="text-2xl font-bold text-ink dark:text-on-primary mb-4 flex items-center gap-2">
        <span>⚖️</span> Official Compliance &amp; Statutory Guidance
      </h2>
      <p class="text-sm sm:text-base text-body leading-relaxed dark:text-muted mb-6">
        Tax legislation in {country.name} is governed by statutory law and administrative rulings enforced by <strong>{country.officialTaxAuthority}</strong>. While Finsiva's calculators and FAQ repositories are regularly updated against current statutory schedules, individual circumstances (such as residency treaties, dual status, foreign asset disclosures, or specialized business structures) can affect your liability.
      </p>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl bg-canvas border border-hairline dark:bg-surface dark:border-overlay-lighter">
          <h3 class="font-bold text-sm text-ink dark:text-on-primary mb-1">Official Tax Authority Portal</h3>
          <p class="text-xs text-muted mb-3">Access statutory forms, official rulings, and primary source legislation directly.</p>
          <a
            href={country.taxAuthorityUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold text-primary hover:underline inline-flex items-center gap-1 dark:text-link"
          >
            Visit {country.officialTaxAuthority} Website ↗
          </a>
        </div>

        <div class="p-4 rounded-xl bg-canvas border border-hairline dark:bg-surface dark:border-overlay-lighter">
          <h3 class="font-bold text-sm text-ink dark:text-on-primary mb-1">Country Tax Guide</h3>
          <p class="text-xs text-muted mb-3">Review progressive brackets, standard deductions, and tax credits for {country.name}.</p>
          <a
            href={`/countries/${country.slug}/`}
            class="text-xs font-bold text-primary hover:underline inline-flex items-center gap-1 dark:text-link"
          >
            Open Complete {country.name} Tax Guide →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- AUTHOR & METHODOLOGY -->
  <AuthorBioCard />
</CountryLayout>
