---
import CountryLayout from "../../../layouts/CountryLayout.astro";
import { countries, getCountryBySlug } from "../../../data/countries";
import { countryFaqHubs } from "../../../data/countryFaqHubData";
import FactCheckedBadge from "../../../components/FactCheckedBadge.astro";
import AuthorBioCard from "../../../components/AuthorBioCard.astro";

export function getStaticPaths() {
  return countries.map(country => ({
    params: { country: country.slug }
  }));
}

const countrySlug = Astro.params.country!;
const country = getCountryBySlug(countrySlug);
const hub = countryFaqHubs[countrySlug];

if (!country || !hub) {
  return Astro.redirect("/countries");
}

// Flatten all questions for schema
const allFaqs = hub.sections.flatMap(s => s.faqs);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "name": hub.metaTitle,
  "description": hub.metaDescription,
  "url": `https://finsiva.com/countries/${hub.countrySlug}/faqs/`,
  "mainEntity": allFaqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": `${f.answer} ${f.keyPoints ? f.keyPoints.join(' ') : ''}`
    }
  }))
};
---

<CountryLayout
  title={hub.metaTitle}
  description={hub.metaDescription}
  canonical={`https://finsiva.com/countries/${hub.countrySlug}/faqs/`}
  breadcrumbs={[
    { label: "Countries", href: "/countries/" },
    { label: hub.countryName, href: `/countries/${hub.countrySlug}/` },
    { label: "Tax FAQs" }
  ]}
  schema={faqSchema}
  image={country.flag}
  imageAlt={`${hub.countryName} Statutory Tax Rates, Slabs and FAQ Guide`}
  robots="index,follow"
>
  <!-- HERO HEADER -->
  <header class="mb-10">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold bg-primary/10 text-primary dark:bg-primary/20 dark:text-link border border-primary/20 mb-4">
      <span class="text-base leading-none">{hub.flag}</span>
      <span>{hub.countryName} Statutory Tax Intelligence</span>
    </div>
    
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-ink dark:text-on-primary tracking-tight leading-tight">
      {hub.countryName} Tax FAQs &amp; Expert Guidance ({hub.taxYear})
    </h1>
    
    <p class="mt-4 text-base sm:text-lg text-body dark:text-muted max-w-3xl leading-relaxed">
      {hub.executiveSummary}
    </p>

    <div class="mt-4">
      <FactCheckedBadge
        lastChecked={`Tax Year ${hub.taxYear}`}
        reviewerName="Finsiva Statutory Research"
        reviewerRole="International Tax Desk"
      />
    </div>

    <!-- QUICK STATS BAR -->
    <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4 p-5 rounded-2xl border border-hairline bg-canvas-soft dark:border-overlay-lighter dark:bg-surface/50">
      <div>
        <div class="text-xs uppercase tracking-wider text-muted font-medium">Tax Authority</div>
        <div class="font-bold text-sm sm:text-base text-ink dark:text-on-primary truncate mt-0.5" title={hub.officialTaxAuthority}>
          <a href={hub.taxAuthorityUrl} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
            {hub.officialTaxAuthority} ↗
          </a>
        </div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-muted font-medium">Filing Deadline</div>
        <div class="font-bold text-sm sm:text-base text-ink dark:text-on-primary mt-0.5 truncate" title={hub.filingDeadline}>
          {hub.filingDeadline}
        </div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-muted font-medium">Currency</div>
        <div class="font-bold text-sm sm:text-base text-ink dark:text-on-primary mt-0.5">
          {hub.currency}
        </div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-wider text-muted font-medium">In-Depth Solutions</div>
        <div class="font-bold text-sm sm:text-base text-ink dark:text-on-primary mt-0.5">
          {allFaqs.length} Verified Answers
        </div>
      </div>
    </div>
  </header>

  <!-- JUMP NAVIGATION PILLS -->
  <nav class="mb-12 p-4 rounded-2xl border border-hairline bg-canvas shadow-sm dark:border-overlay-lighter dark:bg-surface" aria-label="FAQ Category Navigation">
    <div class="flex items-center gap-2 mb-3">
      <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
      <span class="text-xs font-bold uppercase tracking-wider text-ink dark:text-on-primary">Quick Navigation:</span>
    </div>
    <div class="flex flex-wrap gap-2">
      <a
        href="#tax-brackets"
        class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-canvas-soft border border-hairline text-ink hover:border-primary hover:text-primary transition dark:bg-surface dark:text-on-primary dark:border-overlay-lighter"
      >
        📊 Tax Slabs &amp; Brackets
      </a>
      <a
        href="#residency-rules"
        class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-canvas-soft border border-hairline text-ink hover:border-primary hover:text-primary transition dark:bg-surface dark:text-on-primary dark:border-overlay-lighter"
      >
        🌐 Residency Rules
      </a>
      {hub.sections.map(sec => (
        <a
          href={`#${sec.slug}`}
          class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-canvas-soft border border-hairline text-ink hover:border-primary hover:text-primary transition dark:bg-surface dark:text-on-primary dark:border-overlay-lighter"
        >
          {sec.name}
        </a>
      ))}
      <a
        href="#filing-process"
        class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-canvas-soft border border-hairline text-ink hover:border-primary hover:text-primary transition dark:bg-surface dark:text-on-primary dark:border-overlay-lighter"
      >
        📝 Filing &amp; Penalties
      </a>
      <a
        href="#calculators"
        class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-canvas-soft border border-hairline text-ink hover:border-primary hover:text-primary transition dark:bg-surface dark:text-on-primary dark:border-overlay-lighter"
      >
        🧮 Interactive Calculators
      </a>
    </div>
  </nav>

  <!-- SECTION 1: STATUTORY TAX SLABS & BRACKETS TABLE -->
  <section id="tax-brackets" class="mb-14 scroll-mt-24">
    <div class="rounded-3xl border border-hairline bg-canvas p-6 sm:p-8 shadow-sm dark:border-overlay-lighter dark:bg-surface">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 mb-6 border-b border-hairline dark:border-overlay-lighter">
        <div>
          <h2 class="text-2xl font-bold text-ink dark:text-on-primary flex items-center gap-2">
            <span>📊</span> Official {hub.countryName} Tax Brackets &amp; Rates ({hub.taxYear})
          </h2>
          <p class="mt-1 text-sm text-body dark:text-muted">
            {hub.taxBracketsIntro}
          </p>
        </div>
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shrink-0 self-start sm:self-auto">
          Current Statutory Rates
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <caption class="sr-only">Official {hub.countryName} Statutory Tax Brackets, Marginal Rates, and Thresholds for Tax Year {hub.taxYear}</caption>
          <thead>
            <tr class="border-b border-hairline bg-canvas-soft/70 dark:border-overlay-lighter dark:bg-surface/60">
              <th scope="col" class="py-3.5 px-4 font-bold text-ink dark:text-on-primary">Income Bracket / Threshold</th>
              <th scope="col" class="py-3.5 px-4 font-bold text-ink dark:text-on-primary">Marginal Tax Rate</th>
              <th scope="col" class="py-3.5 px-4 font-bold text-ink dark:text-on-primary">Taxpayer Scope &amp; Statutory Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline dark:divide-overlay-lighter">
            {hub.taxBrackets.map((row, idx) => (
              <tr class={idx % 2 === 0 ? "bg-canvas dark:bg-surface" : "bg-canvas-soft/30 dark:bg-surface/40"}>
                <td class="py-3.5 px-4 font-semibold text-ink dark:text-on-primary whitespace-nowrap">
                  {row.bracket}
                </td>
                <td class="py-3.5 px-4 font-bold text-primary dark:text-link whitespace-nowrap">
                  {row.rate}
                </td>
                <td class="py-3.5 px-4 text-body dark:text-muted">
                  {row.notes}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- SECTION 2: TAX RESIDENCY & JURISDICTION RULES -->
  <section id="residency-rules" class="mb-14 scroll-mt-24">
    <div class="rounded-3xl border border-hairline bg-canvas-soft/70 p-6 sm:p-8 dark:border-overlay-lighter dark:bg-surface/40">
      <div class="flex items-start gap-4">
        <div class="hidden sm:flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-primary/10 text-primary dark:bg-primary/20 dark:text-link text-2xl">
          🌐
        </div>
        <div>
          <h2 class="text-2xl font-bold text-ink dark:text-on-primary">
            {hub.countryName} Tax Residency &amp; Worldwide Scope
          </h2>
          <p class="mt-2 text-sm sm:text-base text-body dark:text-muted leading-relaxed">
            {hub.residencyRuleSummary}
          </p>
          <div class="mt-4 flex flex-wrap gap-3">
            {hub.residencyBadges && hub.residencyBadges.map(badge => (
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full bg-canvas border border-hairline text-ink dark:bg-surface dark:text-on-primary">
                ✓ {badge}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: CATEGORY DEEP FAQS WITH ISSUEBOX RULE 10 TOOL LINKING -->
  {hub.sections.map(section => (
    <section id={section.slug} class="mb-14 scroll-mt-24">
      <div class="rounded-3xl border border-hairline bg-canvas p-6 sm:p-8 shadow-sm dark:border-overlay-lighter dark:bg-surface">
        
        <!-- CATEGORY HEADER -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 mb-6 border-b border-hairline dark:border-overlay-lighter">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-primary dark:text-link mb-1">
              Core Tax Subject
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-ink dark:text-on-primary">
              {section.name}
            </h2>
            <p class="mt-2 text-sm sm:text-base text-body dark:text-muted max-w-2xl">
              {section.description}
            </p>
          </div>
          <a
            href={`/countries/${hub.countrySlug}/${section.slug}/`}
            class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-canvas-soft border border-hairline text-ink hover:border-primary hover:text-primary transition dark:bg-surface dark:text-on-primary"
          >
            <span>Browse {section.name} Hub</span>
            <span>→</span>
          </a>
        </div>

        <!-- ISSUEBOX RULE 10: DEEP TOOL LINKING CTA -->
        {section.calculator && (
          <div class="mb-8 p-5 rounded-2xl bg-gradient-to-r from-primary/5 via-canvas to-primary/10 border border-primary/20 dark:from-primary/10 dark:via-surface dark:to-primary/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-sm">
            <div>
              <div class="inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider text-primary dark:text-link mb-1">
                <span>🧮</span> Interactive Calculator Tool
              </div>
              <h3 class="font-bold text-base sm:text-lg text-ink dark:text-on-primary">
                {section.calculator.name}
              </h3>
              <p class="text-xs sm:text-sm text-body dark:text-muted mt-0.5">
                {section.calculator.description}
              </p>
            </div>
            <a
              href={`/countries/${hub.countrySlug}/${section.slug}/${section.calculator.slug}/`}
              class="shrink-0 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-primary text-on-primary hover:opacity-90 transition shadow-sm dark:bg-on-primary dark:text-primary"
            >
              <span>Calculate Now</span>
              <span>→</span>
            </a>
          </div>
        )}

        <!-- FAQS ACCORDIONS / DETAILED CARDS -->
        <div class="space-y-6">
          {section.faqs.map((faq, idx) => (
            <article class="p-6 rounded-2xl border border-hairline bg-canvas-soft/40 dark:border-overlay-lighter dark:bg-surface/50">
              <h3 class="text-lg sm:text-xl font-bold text-ink dark:text-on-primary flex items-start gap-3">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-primary text-on-primary text-xs font-black dark:bg-on-primary dark:text-primary">
                  Q.
                </span>
                <span>{faq.question}</span>
              </h3>

              <div class="mt-4 pl-10 text-sm sm:text-base text-body leading-relaxed dark:text-muted">
                <p>{faq.answer}</p>

                {faq.keyPoints && faq.keyPoints.length > 0 && (
                  <div class="mt-4 p-4 rounded-xl bg-canvas border border-hairline dark:bg-surface dark:border-overlay-lighter">
                    <div class="text-xs font-bold uppercase tracking-wider text-ink dark:text-on-primary mb-2 flex items-center gap-1.5">
                      <span>📌</span> Key Statutory Takeaways:
                    </div>
                    <ul class="space-y-1.5 text-xs sm:text-sm">
                      {faq.keyPoints.map(point => (
                        <li class="flex items-start gap-2 text-body dark:text-muted">
                          <span class="text-primary font-bold shrink-0">•</span>
                          <span>{point}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>
  ))}

  <!-- SECTION 4: OFFICIAL FILING PROCEDURES & PENALTIES -->
  <section id="filing-process" class="mb-14 scroll-mt-24">
    <div class="rounded-3xl border border-hairline bg-canvas p-6 sm:p-8 shadow-sm dark:border-overlay-lighter dark:bg-surface">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-ink dark:text-on-primary mb-3 flex items-center gap-2">
        <span>📝</span> How to File Taxes in {hub.countryName}: Step-by-Step
      </h2>
      <p class="text-sm sm:text-base text-body dark:text-muted mb-6 leading-relaxed">
        {hub.filingIntro}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="space-y-4">
          {hub.filingProcessSteps.map((step, idx) => (
            <div class="flex items-start gap-3 p-4 rounded-xl bg-canvas-soft border border-hairline dark:bg-surface dark:border-overlay-lighter">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary text-xs font-bold dark:bg-on-primary dark:text-primary">
                {idx + 1}
              </span>
              <p class="text-xs sm:text-sm text-body dark:text-muted leading-relaxed">
                {step}
              </p>
            </div>
          ))}
        </div>

        <div class="flex flex-col justify-between p-6 rounded-2xl bg-amber-500/5 border border-amber-500/20 dark:bg-amber-400/5 dark:border-amber-400/20">
          <div>
            <div class="flex items-center gap-2 text-amber-600 dark:text-amber-400 font-bold text-base mb-2">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>Late Filing &amp; Non-Compliance Penalties</span>
            </div>
            <p class="text-xs sm:text-sm text-body dark:text-muted leading-relaxed">
              {hub.penaltySummary}
            </p>
            <p class="mt-3 text-xs text-muted leading-relaxed">
              {hub.auditRiskNotice}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-amber-500/20">
            <a
              href={hub.filingPortalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-700 dark:text-amber-300 hover:underline"
            >
              <span>Access {hub.filingPortalName} Official Portal</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: INTERACTIVE CALCULATOR SUITE -->
  <section id="calculators" class="mb-14 scroll-mt-24">
    <div class="p-6 sm:p-8 rounded-3xl border border-hairline bg-canvas shadow-sm dark:border-overlay-lighter dark:bg-surface">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-ink dark:text-on-primary flex items-center gap-2">
            <span>🧮</span> Free {hub.countryName} Tax Calculators
          </h2>
          <p class="mt-2 text-sm sm:text-base text-body dark:text-muted">
            {hub.calculatorSuiteIntro}
          </p>
        </div>
        <a
          href={`/countries/${hub.countrySlug}/`}
          class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:underline dark:text-link"
        >
          View All Country Calculators →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {country.taxCategories.flatMap(c => 
          c.calculators.map(calc => ({
            ...calc,
            categorySlug: c.slug,
            categoryName: c.name
          }))
        ).slice(0, 9).map(calc => (
          <a
            href={`/countries/${hub.countrySlug}/${calc.categorySlug}/${calc.slug}/`}
            class="group p-5 rounded-2xl border border-hairline bg-canvas-soft hover:border-primary hover:shadow-md transition dark:bg-surface dark:border-overlay-lighter flex flex-col justify-between"
          >
            <div>
              <div class="text-[11px] font-bold uppercase tracking-wider text-primary dark:text-link mb-1">
                {calc.categoryName}
              </div>
              <h3 class="font-bold text-base text-ink group-hover:text-primary transition-colors dark:text-on-primary">
                {calc.name}
              </h3>
              <p class="mt-2 text-xs text-muted leading-relaxed line-clamp-2">
                {calc.description}
              </p>
            </div>
            <div class="mt-4 text-xs font-bold text-primary dark:text-link flex items-center gap-1">
              <span>Calculate Now</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- AUTHOR & METHODOLOGY -->
  <AuthorBioCard />
</CountryLayout>
