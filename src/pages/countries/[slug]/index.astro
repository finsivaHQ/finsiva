---
import CountryLayout from "../../../layouts/CountryLayout.astro";
import { countries, getCountryBySlug } from "../../../data/countries";
import { getBaseUrl } from "../../../utils/routing";
import CountryHero from "../../../components/country/CountryHero.astro";
import CountryOverview from "../../../components/country/CountryOverview.astro";
import ImportantTaxInfo from "../../../components/country/ImportantTaxInfo.astro";
import TaxBrackets from "../../../components/country/TaxBrackets.astro";
import CommonDeductions from "../../../components/country/CommonDeductions.astro";
import TaxCredits from "../../../components/country/TaxCredits.astro";
import WhoShouldUse from "../../../components/country/WhoShouldUse.astro";
import HowToUse from "../../../components/country/HowToUse.astro";
import TaxFAQ from "../../../components/country/TaxFAQ.astro";
import RelatedContent from "../../../components/country/RelatedContent.astro";
import TrustSection from "../../../components/country/TrustSection.astro";
import TaxCheatsheetCard from "../../../components/TaxCheatsheetCard.astro";
import SalaryTaxChart from "../../../components/SalaryTaxChart.astro";
import FactCheckedBadge from "../../../components/FactCheckedBadge.astro";

export function getStaticPaths() {
  return countries.map(country => ({
    params: { slug: country.slug }
  }));
}

const country = getCountryBySlug(Astro.params.slug!);

if (!country) {
  return Astro.redirect("/countries");
}

const baseUrl = getBaseUrl();

const allCalculators = [
  ...(country.salaryCalculators || []),
  ...(country.capitalGainsCalculators || []),
  ...(country.corporateCalculators || [])
];

const popularCalcs = country.popularCalculators || [];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${country.name} Tax Guide`,
  description: country.overview,
  url: `${baseUrl}/countries/${country.slug}`,
  about: {
    "@type": "Country",
    name: country.name,
    currency: country.currency
  }
};

const faqSchema = (country.countryFAQs || []).length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  name: `${country.name} Tax FAQs`,
  url: `${baseUrl}/countries/${country.slug}`,
  mainEntity: country.countryFAQs.map(faq => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer
    }
  }))
} : undefined;

const govOrgSchema = {
  "@context": "https://schema.org",
  "@type": "GovernmentOrganization",
  name: country.officialTaxAuthority,
  url: country.taxAuthorityUrl,
  description: `Official tax authority for ${country.name}`
};
---

<CountryLayout
  title={`${country.name} Tax Guide (${country.taxYear}) | Brackets & Calculators`}
  description={`${country.name} tax guide: ${country.taxYear} tax brackets, rates, deductions, credits, filing deadlines, and official government resources. Calculate your tax with our free ${country.name} tax calculators.`}
  keywords={`${country.name} tax, ${country.name} tax calculator, ${country.name} tax brackets, ${country.name} income tax, ${country.name} tax rates, ${country.name} tax deductions, ${country.name} tax credits, ${country.name} filing deadline, ${country.name} tax authority, ${country.name} tax guide`}
  breadcrumbs={[
    { label: "Countries", href: "/countries" },
    { label: country.name, href: `/countries/${country.slug}` }
  ]}
  canonical={`${baseUrl}/countries/${country.slug}`}
  schema={schema}
  image={country.flag}
  imageAlt={`${country.name} tax guide - ${country.taxYear} tax brackets, rates, deductions, and credits`}
  robots="index,follow"
>

{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
<script type="application/ld+json" set:html={JSON.stringify(govOrgSchema)} />

<!-- SECTION 1: HERO -->
<CountryHero
  country={{
    name: country.name,
    flag: country.flag,
    continent: country.continent,
    taxSystemSummary: country.taxSystemSummary,
    taxYear: country.taxYear,
    currency: country.currency,
    capital: country.capital,
    lastUpdated: country.lastUpdated,
    officialTaxAuthority: country.officialTaxAuthority,
    taxAuthorityUrl: country.taxAuthorityUrl,
    slug: country.slug,
  }}
  popularCalculators={popularCalcs}
  salaryCalculators={country.salaryCalculators || []}
/>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <FactCheckedBadge
    reviewerName="Finsiva Tax Compliance Board"
    reviewerTitle="Certified Tax Policy Analysts"
    sourceName={country.officialTaxAuthority}
    sourceUrl={country.taxAuthorityUrl}
    lastChecked={country.taxYear}
  />
  <TaxCheatsheetCard
    countryName={country.name}
    countryFlag={country.flag}
    currency={country.currency}
    topRate={country.slug === 'hong-kong' ? '17% / 15%' : country.slug === 'singapore' ? '24%' : country.slug === 'united-states' ? '37%' : country.slug === 'united-kingdom' ? '45%' : country.slug === 'india' ? '30%' : country.slug === 'pakistan' ? '35%' : 'Standard'}
    basicAllowance={country.slug === 'hong-kong' ? 'HK$ 132,000' : country.slug === 'singapore' ? 'S$ 20,000' : country.slug === 'united-states' ? '$ 14,600' : country.slug === 'united-kingdom' ? '£ 12,570' : country.slug === 'india' ? '₹ 75,000' : country.slug === 'pakistan' ? 'Rs 600,000' : 'Standard'}
    capitalGains={country.taxSystemOverview?.capitalGainsTax || '0% (Exempt)'}
    taxYear={country.taxYear}
  />
  <SalaryTaxChart
    currency={country.currency}
    title={`Standard ${country.name} Gross Salary vs Tax & Take-Home Visualizer`}
  />
</div>

<!-- PROMINENT TAX CATEGORIES & CALCULATORS GRID -->
<section id="tax-calculators" class="py-10 border-b border-hairline bg-canvas-soft dark:border-overlay-light dark:bg-canvas">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 text-center sm:text-left flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl font-bold text-ink dark:text-on-primary">{country.name} Tax Calculators & Categories</h2>
        <p class="mt-2 text-base text-body dark:text-muted">Select a category or calculator below to get instant, accurate estimates for {country.name}.</p>
      </div>
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-primary/10 text-primary dark:bg-on-primary/10 dark:text-on-primary shrink-0 self-start sm:self-auto">
        ✓ Updated for {country.taxYear}
      </span>
    </div>

    <!-- Category Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
      {country.taxCategories.map(cat => (
        <a 
          href={`/countries/${country.slug}/${cat.slug}`} 
          class="group card relative flex flex-col justify-between p-6 border border-hairline rounded-2xl bg-canvas transition-all duration-200 hover:-translate-y-1 hover:border-primary hover:shadow-md dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-semibold uppercase tracking-wider text-muted dark:text-muted">{cat.calculators.length} Calculators</span>
              <span class="h-2 w-2 rounded-full bg-primary dark:bg-on-primary"></span>
            </div>
            <h3 class="text-xl font-bold text-ink dark:text-on-primary group-hover:text-primary transition">{cat.name}</h3>
            <p class="mt-2 text-sm text-body dark:text-muted leading-relaxed line-clamp-3">{cat.description}</p>
          </div>
          <div class="mt-6 flex items-center gap-1.5 text-sm font-semibold text-link group-hover:underline dark:text-link-soft">
            <span>Explore {cat.name}</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7M3 12h18"/></svg>
          </div>
        </a>
      ))}
    </div>

    <!-- Direct Calculator Links Grid with Category Filter Tabs -->
    <div class="rounded-2xl border border-hairline bg-canvas p-6 sm:p-8 dark:border-overlay-lighter dark:bg-surface shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 pb-4 border-b border-hairline dark:border-overlay-lighter gap-4">
        <div>
          <h3 class="text-xl font-bold text-ink dark:text-on-primary flex items-center gap-2">
            <span>⚡</span>
            <span>All {country.name} Tax Calculators</span>
          </h3>
          <p class="text-xs text-muted mt-0.5">Filter by category or launch any tool directly</p>
        </div>

        <!-- Interactive Category Filter Pills -->
        <div class="flex flex-wrap items-center gap-2" id="calc-filter-tabs">
          <button 
            data-cat-filter="all"
            class="calc-tab-btn active px-3.5 py-1.5 rounded-full text-xs font-semibold bg-primary text-on-primary shadow-sm dark:bg-on-primary dark:text-primary transition cursor-pointer"
          >
            All Tools
          </button>
          {country.taxCategories.map(cat => (
            <button 
              data-cat-filter={cat.slug}
              class="calc-tab-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-canvas-soft border border-hairline text-ink hover:border-primary dark:bg-surface dark:text-on-primary dark:border-overlay-lighter transition cursor-pointer"
            >
              {cat.name}
            </button>
          ))}
        </div>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="calc-cards-grid">
        {country.taxCategories.flatMap(cat => cat.calculators.map(calc => ({ ...calc, categorySlug: cat.slug, categoryName: cat.name }))).map(calc => {
          const isPop = calc.isPopular || popularCalcs.some(p => p.slug === calc.slug);
          return (
            <a 
              href={`/countries/${country.slug}/${calc.categorySlug}/${calc.slug}`}
              data-category={calc.categorySlug}
              class="calc-item flex flex-col justify-between p-4 rounded-xl border border-hairline bg-canvas-soft hover:border-primary hover:bg-canvas transition-all duration-200 dark:border-overlay-lighter dark:bg-canvas dark:hover:bg-surface group"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-[11px] font-semibold uppercase tracking-wider text-muted dark:text-muted">{calc.categoryName}</span>
                  {isPop && (
                    <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-600 dark:bg-amber-400/20 dark:text-amber-300 border border-amber-500/30 shrink-0">
                      🔥 Most Searched
                    </span>
                  )}
                </div>
                <h4 class="text-base font-semibold text-ink dark:text-on-primary group-hover:text-primary transition">{calc.name}</h4>
                <p class="text-xs text-body dark:text-muted mt-1 leading-relaxed line-clamp-2">{calc.description}</p>
              </div>
              <div class="mt-4 flex items-center justify-between text-xs font-semibold text-link group-hover:underline dark:text-link-soft">
                <span>Launch Calculator</span>
                <div class="h-6 w-6 rounded-full bg-primary/10 text-primary group-hover:bg-primary group-hover:text-on-primary flex items-center justify-center transition dark:bg-on-primary/10 dark:text-on-primary dark:group-hover:bg-on-primary dark:group-hover:text-primary">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.calc-tab-btn');
    const calcItems = document.querySelectorAll('.calc-item');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-cat-filter');
        
        filterBtns.forEach(b => {
          b.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm', 'dark:bg-on-primary', 'dark:text-primary');
          b.classList.add('bg-canvas-soft', 'border', 'border-hairline', 'text-ink', 'dark:bg-surface', 'dark:text-on-primary', 'dark:border-overlay-lighter');
        });

        btn.classList.remove('bg-canvas-soft', 'border', 'border-hairline', 'text-ink', 'dark:bg-surface', 'dark:border-overlay-lighter');
        btn.classList.add('bg-primary', 'text-on-primary', 'shadow-sm', 'dark:bg-on-primary', 'dark:text-primary');

        calcItems.forEach(item => {
          if (cat === 'all' || item.getAttribute('data-category') === cat) {
            (item as HTMLElement).style.display = 'flex';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  });
</script>

<!-- SECTION 2: OVERVIEW -->
<CountryOverview country={country} />

<!-- SECTION 3: IMPORTANT TAX INFORMATION -->
<ImportantTaxInfo country={country} />

<!-- SECTION 4: TAX BRACKETS -->
<TaxBrackets country={country} />

<!-- SECTION 5: COMMON DEDUCTIONS -->
<CommonDeductions country={country} />

<!-- SECTION 6: TAX CREDITS -->
<TaxCredits country={country} />

<!-- SECTION 7: WHO SHOULD USE -->
<WhoShouldUse country={country} />

<!-- SECTION 8: HOW TO USE -->
<HowToUse country={country} />

<!-- SECTION 9: FAQS -->
<TaxFAQ country={country} />

<!-- SECTION 10: RELATED CONTENT -->
<RelatedContent
  country={{
    name: country.name,
    slug: country.slug,
    taxCategories: country.taxCategories,
    relatedCountries: country.relatedCountries,
    popularCalculators: popularCalcs,
    salaryCalculators: country.salaryCalculators || [],
    capitalGainsCalculators: country.capitalGainsCalculators || [],
    corporateCalculators: country.corporateCalculators || [],
  }}
  getCountryBySlug={getCountryBySlug}
/>

<!-- SECTION 11: TRUST & TRANSPARENCY -->
<TrustSection country={country} />

<!-- SECTION 12: COUNTRY TAX OVERVIEW -->
<div class="border-t border-hairline dark:border-overlay-light" aria-labelledby="country-tax-overview-heading">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 id="country-tax-overview-heading" class="text-3xl font-semibold text-ink mb-6 text-center dark:text-on-primary">Country Tax Overview</h2>
    <img src="https://images.unsplash.com/photo-1580519542036-c47de6196ba5?w=1200&q=80" alt={`${country.name} tax overview and financial planning`} class="mx-auto mb-10 w-full max-w-3xl rounded-lg object-cover max-h-80 sm:max-h-96" loading="lazy" />
    <h3 class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Key Takeaways</h3>
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <li class="card dark:border-overlay-lighter dark:bg-surface">
        <span class="font-semibold text-ink dark:text-on-primary">Tax Year:</span>
        <p class="mt-1 text-sm text-body dark:text-muted">{country.taxYear} — all rates and thresholds are current for this fiscal year.</p>
      </li>
      <li class="card dark:border-overlay-lighter dark:bg-surface">
        <span class="font-semibold text-ink dark:text-on-primary">Currency:</span>
        <p class="mt-1 text-sm text-body dark:text-muted">{country.currency} — all calculations are presented in the local currency for easy comparison.</p>
      </li>
      <li class="card dark:border-overlay-lighter dark:bg-surface">
        <span class="font-semibold text-ink dark:text-on-primary">Official Authority:</span>
        <p class="mt-1 text-sm text-body dark:text-muted">{country.officialTaxAuthority} — verify filings directly with the official tax authority.</p>
      </li>
      <li class="card dark:border-overlay-lighter dark:bg-surface">
        <span class="font-semibold text-ink dark:text-on-primary">Deductions & Credits:</span>
        <p class="mt-1 text-sm text-body dark:text-muted">Review the Common Deductions and Tax Credits sections to maximize your refund or minimize your payment.</p>
      </li>
      <li class="card dark:border-overlay-lighter dark:bg-surface">
        <span class="font-semibold text-ink dark:text-on-primary">Filing Deadlines:</span>
        <p class="mt-1 text-sm text-body dark:text-muted">Check Important Tax Information for key dates and avoid late penalties or interest charges.</p>
      </li>
      <li class="card dark:border-overlay-lighter dark:bg-surface">
        <span class="font-semibold text-ink dark:text-on-primary">Privacy First:</span>
        <p class="mt-1 text-sm text-body dark:text-muted">All calculations run locally in your browser. Your financial data is never collected, stored, or transmitted.</p>
      </li>
    </ul>

    <div class="mt-12 rounded-xl border border-hairline bg-canvas-soft p-8 dark:border-overlay-light dark:bg-surface">
      <h3 class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Recent Updates</h3>
      <p class="text-body leading-relaxed dark:text-muted">Tax laws in {country.name} are updated regularly to reflect economic conditions, government policy changes, and international agreements. The {country.taxYear} tax year introduced several important adjustments to brackets, thresholds, and reliefs. We update our calculators and guides whenever official changes are published by {country.officialTaxAuthority}. Bookmark this page and check back throughout the year for the latest information.</p>
    </div>

    <div class="mt-8 rounded-xl border border-hairline bg-canvas p-8 dark:border-overlay-lighter dark:bg-surface">
      <h3 class="text-2xl font-semibold text-ink mb-4 dark:text-on-primary">Further Reading</h3>
      <p class="text-body leading-relaxed dark:text-muted">To deepen your understanding of {country.name} taxation, explore our curated collection of guides and tools. Whether you are preparing your annual return, planning investments, or comparing jurisdictions, these resources provide clear explanations and instant estimates.</p>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href={`/countries/${country.slug}`} class="card hover:border-primary transition dark:border-overlay-lighter dark:bg-surface">
          <h4 class="font-semibold text-ink dark:text-on-primary">{country.name} Calculators</h4>
          <p class="text-sm text-muted mt-2 dark:text-muted">All interactive tax estimators for {country.name} in one place.</p>
        </a>
        <a href="/knowledge" class="card hover:border-primary transition dark:border-overlay-lighter dark:bg-surface">
          <h4 class="font-semibold text-ink dark:text-on-primary">Tax Knowledge Center</h4>
          <p class="text-sm text-muted mt-2 dark:text-muted">Learn core tax concepts with expert-written guides and a searchable glossary.</p>
        </a>
        <a href="/blogs" class="card hover:border-primary transition dark:border-overlay-lighter dark:bg-surface">
          <h4 class="font-semibold text-ink dark:text-on-primary">Tax Blog</h4>
          <p class="text-sm text-muted mt-2 dark:text-muted">Latest tips, updates, and country-specific tax strategies.</p>
        </a>
      </div>
    </div>
  </div>
</div>
</CountryLayout>
