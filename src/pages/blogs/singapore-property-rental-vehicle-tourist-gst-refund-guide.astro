---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "Singapore Property, Vehicle Expenses & Tourist GST Refund (Changi) Guide 2026";
const description = "Complete 2026 guide to Singapore GST on property (commercial vs residential exemption), claiming motor vehicle expense GST, and tourist GST refunds at Changi Airport via eTRS (touristrefund.sg).";
const image = "https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=1200&q=80";
const author = "Michael Tang, Senior Tax & Corporate Advisory Lead";
const authorBio = "Corporate tax advisor specializing in Singapore Goods and Services Tax (GST), real estate stamp duty, corporate vehicle fleet tax claims, and tourist tax refund clearance.";
const canonical = "https://finsiva.com/blogs/singapore-property-rental-vehicle-tourist-gst-refund-guide";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is GST charged on residential property sales and rental in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>No. Sale and lease of residential properties (HDB flats, private condominiums, landed homes) are strictly exempt from GST in Singapore. No GST is charged on residential rental income or purchase price.</p>"
      }
    },
    {
      "@type": "Question",
      name: "How does GST apply to commercial property purchases and rent in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>Sale and lease of commercial properties (offices, retail shops, industrial warehouses) are standard-rated (9% GST). GST-registered businesses renting or purchasing commercial real estate can claim back the 9% GST as Input Tax.</p>"
      }
    },
    {
      "@type": "Question",
      name: "Can businesses claim GST on motor vehicle expenses and cars in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>Under Regulation 27 of the GST Regulations, Input Tax claims on passenger cars (E-plate or S-plate private cars), vehicle maintenance, fuel, and parking expenses are strictly blocked. Input GST can only be claimed for commercial vehicles (goods vans, lorries, buses) registered under G/W/X plates.</p>"
      }
    },
    {
      "@type": "Question",
      name: "How do tourists claim GST refund at Changi Airport in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>Tourists spending at least S$100 at participating eTRS retail stores can claim a GST refund at Changi Airport using eTRS self-service kiosks or the Global Blue mobile app prior to checking in bags.</p>"
      }
    },
    {
      "@type": "Question",
      name: "What is touristrefund.sg and eTRS in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>eTRS (Electronic Tourist Refund Scheme), accessible via official portals like touristrefund.sg and Global Blue, connects retail purchase passports electronically so tourists do not need paper tax refund vouchers.</p>"
      }
    }
  ]
};
---

<BlogLayout
  title={title}
  description={description}
  image={image}
  author={author}
  authorBio={authorBio}
  lastUpdated="August 2026"
  readTime="21 min read"
  canonical={canonical}
  schema={faqSchema}
>
  <div class="mt-8 space-y-8 text-body dark:text-muted">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- Intro Banner -->
    <p class="text-xl leading-relaxed font-light text-ink dark:text-on-primary">
      Navigating specialized tax treatments under the <a href="https://www.iras.gov.sg" target="_blank" rel="noopener noreferrer" class="text-link hover:underline">Inland Revenue Authority of Singapore (IRAS)</a> requires understanding distinct statutory exemptions. Whether evaluating <strong>GST on property in Singapore</strong> (commercial rent vs residential exemption), rules for <strong>claiming GST on motor vehicle expenses</strong>, or departing visitors <strong>claiming GST at Changi Airport</strong> via <em>touristrefund.sg / eTRS</em>, this 2026 guide breaks down exact legal requirements.
    </p>

    <!-- Key Takeaways Card -->
    <div class="rounded-2xl border border-primary/20 bg-primary/5 p-6 dark:border-primary/30 dark:bg-primary/10">
      <div class="flex items-center gap-3 mb-3">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary text-white font-bold text-sm">🏢</span>
        <h3 class="text-lg font-bold text-ink dark:text-on-primary">Property, Vehicle & Tourist Refund Highlights</h3>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
        <li class="flex items-start gap-2">
          <span class="text-primary font-bold">•</span>
          <span><strong>Residential Real Estate:</strong> 100% GST-Exempt (no GST on HDB/condo rent or purchase).</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary font-bold">•</span>
          <span><strong>Commercial Real Estate:</strong> Standard 9% GST applies to office/retail rent and property sales.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary font-bold">•</span>
          <span><strong>Motor Vehicles & Cars:</strong> Input GST strictly blocked for passenger cars; allowed for commercial vans/trucks.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary font-bold">•</span>
          <span><strong>Changi Airport eTRS Refund:</strong> Tourists claim 9% GST back on S$100+ purchases via <a href="https://www.touristrefund.sg" target="_blank" rel="noopener noreferrer" class="text-link hover:underline">touristrefund.sg</a>.</span>
        </li>
      </ul>
    </div>

    <!-- Table of Contents -->
    <div class="rounded-xl border border-hairline bg-canvas-soft p-6 dark:border-overlay-light dark:bg-surface">
      <h2 class="text-xl font-semibold text-ink mb-4 dark:text-on-primary">Guide Navigation</h2>
      <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2 text-sm">
        <li><a href="#property-gst-residential-vs-commercial" class="text-link hover:underline">1. GST on Property: Commercial Rent vs Residential Exemption</a></li>
        <li><a href="#claiming-gst-motor-vehicle-expenses" class="text-link hover:underline">2. Claiming GST on Motor Vehicle Expenses & Cars</a></li>
        <li><a href="#tourist-gst-refund-changi" class="text-link hover:underline">3. Claiming Tourist GST Refund at Changi Airport (eTRS)</a></li>
        <li><a href="#touristrefund-sg-app-kiosks" class="text-link hover:underline">4. How touristrefund.sg & eTRS Kiosks Work</a></li>
        <li><a href="#property-stamp-duty-vs-gst" class="text-link hover:underline">5. Comparing Property GST vs Buyer's Stamp Duty (BSD)</a></li>
        <li><a href="#faqs" class="text-link hover:underline">6. Frequently Asked Questions (FAQ)</a></li>
      </ul>
    </div>

    <!-- Section 1 -->
    <h2 id="property-gst-residential-vs-commercial" class="text-2xl font-semibold text-ink dark:text-on-primary">1. GST on Property: Commercial Rent vs Residential Exemption</h2>
    <p>
      In Singapore real estate, the application of GST depends strictly on whether the property is classified as <strong>residential</strong> or <strong>commercial/industrial</strong>:
    </p>

    <!-- Table of Property Tax Matrix -->
    <div class="overflow-x-auto my-6">
      <table class="min-w-full border border-hairline text-left text-sm dark:border-overlay-lighter">
        <thead class="bg-canvas-soft font-semibold text-ink dark:bg-surface dark:text-on-primary">
          <tr>
            <th class="border p-3">Property Classification</th>
            <th class="border p-3">Sale / Purchase Tax Treatment</th>
            <th class="border p-3">Rental / Lease Tax Treatment</th>
            <th class="border p-3">Input Tax Claimability</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline dark:divide-overlay-lighter">
          <tr>
            <td class="p-3 font-bold text-emerald-600">Residential Property (HDB, Condo, Landed)</td>
            <td class="p-3 font-medium">Exempt Supply (0% GST)</td>
            <td class="p-3 font-medium">Exempt Supply (0% GST)</td>
            <td class="p-3 text-red-600">Input tax incurred on residential property cannot be claimed.</td>
          </tr>
          <tr class="bg-primary/5 font-medium dark:bg-primary/10">
            <td class="p-3 font-bold text-primary">Commercial Property (Office, Retail Shop)</td>
            <td class="p-3 font-bold text-primary">Standard-Rated (9% GST)</td>
            <td class="p-3 font-bold text-primary">Standard-Rated (9% GST)</td>
            <td class="p-3 text-primary font-bold">GST-registered businesses can claim back 9% Input Tax.</td>
          </tr>
          <tr>
            <td class="p-3 font-bold text-slate-700 dark:text-slate-300">Industrial Property (B1/B2 Factory, Warehouse)</td>
            <td class="p-3 font-medium">Standard-Rated (9% GST)</td>
            <td class="p-3 font-medium">Standard-Rated (9% GST)</td>
            <td class="p-3 text-primary font-bold">GST-registered businesses can claim back 9% Input Tax.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p>
      For property buyers calculating stamp duties alongside GST, estimate your BSD & ABSD liabilities using our <a href="/countries/singapore/stamp-duty/stamp-duty-calculator/" class="text-link font-semibold hover:underline">Singapore Property Stamp Duty Calculator</a>.
    </p>

    <!-- Section 2 -->
    <h2 id="claiming-gst-motor-vehicle-expenses" class="text-2xl font-semibold text-ink dark:text-on-primary">2. Claiming GST on Motor Vehicle Expenses & Cars</h2>
    <p>
      A common area of IRAS audit non-compliance involves businesses searching <em>"claiming gst on motor vehicle expenses singapore"</em> or <em>"gst on cars singapore"</em>.
    </p>
    <p>
      Under <strong>Regulation 27 of the Singapore Goods and Services Tax Regulations</strong>, Input Tax claims on passenger motor cars are strictly <strong>blocked</strong>:
    </p>

    <!-- Blocked vs Allowed Vehicle Matrix -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
      <div class="rounded-xl border border-red-500/20 bg-red-500/5 p-5 dark:border-red-500/30 dark:bg-red-500/10">
        <span class="rounded bg-red-600 text-white px-2.5 py-1 text-xs font-bold">STRICTLY BLOCKED</span>
        <h4 class="font-bold text-ink mt-2 mb-1 dark:text-on-primary">Passenger Motor Cars (E/S-Plates)</h4>
        <p class="text-sm text-body dark:text-muted">
          Input GST <strong>cannot be claimed</strong> on the purchase, lease, COE, insurance, petrol, parking, ERP, or repair expenses of sedan cars, SUVs, or corporate executive passenger vehicles.
        </p>
      </div>

      <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-5 dark:border-emerald-500/30 dark:bg-emerald-500/10">
        <span class="rounded bg-emerald-600 text-white px-2.5 py-1 text-xs font-bold">ALLOWED CLAIMS</span>
        <h4 class="font-bold text-ink mt-2 mb-1 dark:text-on-primary">Commercial Vehicles (G/W/X-Plates)</h4>
        <p class="text-sm text-body dark:text-muted">
          Input GST <strong>can be claimed</strong> for commercial vehicles registered exclusively for goods transport (goods vans, lorries, trucks, buses, heavy vehicles).
        </p>
      </div>
    </div>

    <!-- Section 3 -->
    <h2 id="tourist-gst-refund-changi" class="text-2xl font-semibold text-ink dark:text-on-primary">3. Claiming Tourist GST Refund at Changi Airport (eTRS)</h2>
    <p>
      Tourists visiting Singapore can claim back the <strong>9% GST</strong> paid on retail purchases under the <strong>Electronic Tourist Refund Scheme (eTRS)</strong> upon departure from Singapore Changi Airport or Seletar Airport.
    </p>

    <h3 class="text-xl font-semibold text-ink dark:text-on-primary">Tourist Eligibility Criteria for eTRS GST Refund</h3>
    <ul class="list-disc pl-6 space-y-2 text-sm">
      <li><strong>Foreign Passport Holder:</strong> Must not be a Singapore Citizen, Permanent Resident, or work pass holder.</li>
      <li><strong>Minimum Purchase:</strong> Spend at least <strong>S$100</strong> (inclusive of GST) at participating eTRS retailers. Up to 3 receipts from the same shop on the same day can be combined.</li>
      <li><strong>Departure Timeline:</strong> Depart Singapore via Changi Airport or Seletar Airport within 2 months from purchase date.</li>
    </ul>

    <!-- Section 4 -->
    <h2 id="touristrefund-sg-app-kiosks" class="text-2xl font-semibold text-ink dark:text-on-primary">4. How touristrefund.sg & eTRS Kiosks Work</h2>
    <p>
      The digital <strong>eTRS framework</strong> (managed through platforms like <a href="https://www.touristrefund.sg" target="_blank" rel="noopener noreferrer" class="text-link hover:underline">touristrefund.sg</a> and Global Blue) links purchases directly to the tourist's passport number at the retail point of sale.
    </p>

    <!-- Workflow Diagram -->
    <div class="my-6 rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
      <h3 class="text-lg font-semibold text-ink mb-4 text-center dark:text-on-primary">4-Step Changi Airport Tourist GST Refund Process</h3>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-3 text-center text-sm">
        <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-800">
          <div class="font-bold text-primary mb-1">1. Shop & Scan Passport</div>
          <p class="text-xs text-muted dark:text-muted">Present passport at store checkout when spending S$100+. Transaction logged to eTRS.</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-800">
          <div class="font-bold text-primary mb-1">2. Arrive at Changi</div>
          <p class="text-xs text-muted dark:text-muted">Head to eTRS Self-Service Kiosks in Departure Hall <strong>before checking in luggage</strong>.</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-800">
          <div class="font-bold text-primary mb-1">3. Scan Passport at Kiosk</div>
          <p class="text-xs text-muted dark:text-muted">Scan passport to retrieve purchases. Select credit card or Alipay for instant refund payout.</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-800">
          <div class="font-bold text-primary mb-1">4. Customs Inspection</div>
          <p class="text-xs text-muted dark:text-muted">If prompted, present purchased items and receipts at Singapore Customs inspection counter.</p>
        </div>
      </div>
    </div>

    <!-- Section 5 -->
    <h2 id="property-stamp-duty-vs-gst" class="text-2xl font-semibold text-ink dark:text-on-primary">5. Comparing Property GST vs Buyer's Stamp Duty (BSD)</h2>
    <p>
      Property transactions in Singapore incur two separate statutory taxes: <strong>GST (9%)</strong> administered by IRAS Goods & Services Tax Division, and <strong>Buyer's Stamp Duty (BSD / ABSD)</strong> administered by IRAS Stamp Duty Branch.
    </p>

    <p>
      For commercial properties, 9% GST is charged on the purchase price, while BSD (up to 5% on commercial properties) is calculated separately on the total purchase value. Calculate your exact tax obligations with our <a href="/countries/singapore/gst/gst-calculator/" class="text-link font-semibold hover:underline">Singapore GST Calculator</a>.
    </p>

    <!-- Section 6 FAQs -->
    <h2 id="faqs" class="text-2xl font-semibold text-ink dark:text-on-primary">6. Frequently Asked Questions (FAQ)</h2>
    <div class="space-y-4">
      <div class="rounded-lg border border-hairline bg-canvas p-4 dark:border-overlay-lighter dark:bg-surface">
        <h3 class="text-lg font-semibold text-ink dark:text-on-primary">Is GST charged on residential property sales or rental in Singapore?</h3>
        <p class="mt-1 text-sm">No. Residential property sales and rentals are 100% exempt from GST in Singapore.</p>
      </div>

      <div class="rounded-lg border border-hairline bg-canvas p-4 dark:border-overlay-lighter dark:bg-surface">
        <h3 class="text-lg font-semibold text-ink dark:text-on-primary">Does commercial property attract GST in Singapore?</h3>
        <p class="mt-1 text-sm">Yes. Sale and lease of commercial properties (offices, retail shops, industrial units) attract standard 9% GST.</p>
      </div>

      <div class="rounded-lg border border-hairline bg-canvas p-4 dark:border-overlay-lighter dark:bg-surface">
        <h3 class="text-lg font-semibold text-ink dark:text-on-primary">Can companies claim GST on car expenses?</h3>
        <p class="mt-1 text-sm">No. Input tax on passenger cars (petrol, parking, COE, repairs) is strictly blocked under Regulation 27. Claims are allowed only for commercial goods vehicles.</p>
      </div>

      <div class="rounded-lg border border-hairline bg-canvas p-4 dark:border-overlay-lighter dark:bg-surface">
        <h3 class="text-lg font-semibold text-ink dark:text-on-primary">How do tourists claim GST refund at Changi Airport?</h3>
        <p class="mt-1 text-sm">Spend S$100+ at participating eTRS stores, scan your passport at eTRS kiosks in Departure Hall prior to checking luggage, and select your refund payout option.</p>
      </div>
    </div>

    <!-- Related Links / Suggested Content -->
    <div class="mt-12 rounded-xl border border-hairline bg-canvas-soft p-6 dark:border-overlay-light dark:bg-surface">
      <h3 class="text-xl font-semibold text-ink mb-3 dark:text-on-primary">Related Singapore Tax & Property Calculators</h3>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 text-sm">
        <a href="/countries/singapore/gst/gst-calculator/" class="text-link hover:underline font-medium">Singapore GST Calculator (9%)</a>
        <a href="/countries/singapore/stamp-duty/stamp-duty-calculator/" class="text-link hover:underline font-medium">Property Stamp Duty Calculator (BSD/ABSD)</a>
        <a href="/blogs/singapore-gst-rate-2026-guide/" class="text-link hover:underline font-medium">Singapore GST Rate 2026 Guide</a>
        <a href="/blogs/singapore-ecommerce-low-value-goods-gst-guide/" class="text-link hover:underline font-medium">Overseas Shopping & LVG GST Guide</a>
        <a href="/blogs/singapore-zero-gst-warehouse-wgst-customs-guide/" class="text-link hover:underline font-medium">Zero-GST Warehouse (ZGW) Scheme</a>
        <a href="/blogs/singapore-gst-registration-accounting-compliance-guide/" class="text-link hover:underline font-medium">GST Business Accounting & Audit Guide</a>
      </div>
    </div>
  </div>
</BlogLayout>
