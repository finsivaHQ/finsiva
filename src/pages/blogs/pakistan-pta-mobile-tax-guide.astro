---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "Pakistan PTA Mobile Tax List 2026: iPhone & Samsung Tax Rates";
const description = "Complete guide to Pakistan PTA mobile phone tax rates and FBR customs duty. Check PTA approval tax on iPhone 12 Pro Max, iPhone 12 Pro, iPhone 7, 6, SE, and Samsung A51, A70, S21, A03s.";
const image = "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=1200&q=80";
const canonical = "https://finsiva.com/blogs/pakistan-pta-mobile-tax-guide";
const author = "Sana Chaudhry";
const authorBio = "Tech policy and customs duty analyst specializing in PTA regulations, mobile device registration (DIRBS), and import tariffs in Pakistan.";
const lastUpdated = "August 2026";
const readTime = "14 min read";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How is PTA mobile tax calculated in Pakistan?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "PTA mobile tax is calculated based on the C&F dollar value of the mobile phone, applying FBR customs duty, sales tax, regulatory duty, and income tax withholding. Registration rates differ for Passport vs CNIC."
      }
    },
    {
      "@type": "Question",
      "name": "What is the PTA tax on iPhone 12 Pro Max in Pakistan for 2026?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The PTA tax on iPhone 12 Pro Max 256GB is approximately PKR 125,000 to PKR 135,000 on CNIC registration, and slightly lower on Passport registration within 60 days of arrival."
      }
    },
    {
      "@type": "Question",
      "name": "What is the PTA tax on Samsung Galaxy A51 and A70?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The PTA approval tax on Samsung A51 and Samsung A70 ranges between PKR 22,000 and PKR 28,000 depending on passport vs CNIC registration."
      }
    },
    {
      "@type": "Question",
      "name": "Is PTA registration tax lower on Passport than CNIC?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, travelers registering a mobile device on their valid international passport within 60 days of arrival in Pakistan pay lower customs duty and tax than CNIC registration."
      }
    },
    {
      "@type": "Question",
      "name": "How to pay PTA tax online in Pakistan?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Generate a PSID via the PTA DIRBS portal (dirbs.pta.gov.pk) or dial *8484#, then pay through mobile banking apps, ATMs, or bank branches."
      }
    }
  ]
};
---

<BlogLayout title={title} description={description} image={image} canonical={canonical} author={author} authorBio={authorBio} lastUpdated={lastUpdated} readTime={readTime}>
  <div class="mt-8 space-y-6 text-body dark:text-muted leading-relaxed">
            <p>
              When importing or bringing a smartphone into Pakistan, international travelers and residents must register their IMEI numbers through the <strong>Device Identification Registration and Blocking System (DIRBS)</strong> administered by the <strong>Pakistan Telecommunication Authority (PTA)</strong> and the <strong>Federal Board of Revenue (FBR)</strong>.
            </p>
            <p>
              Failure to pay <strong>PTA mobile tax</strong> within 60 days of inserting a local SIM results in the automatic blocking of SIM services on non-compliant devices.
            </p>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">PTA Mobile Tax Slab Structure (C&F Value in USD)</h2>
            <p>
              PTA tax rates are determined by the C&F (Cost & Freight) dollar value of the device, assessed under FBR customs regulations:
            </p>

            <div class="my-6 overflow-x-auto rounded-xl border border-hairline bg-canvas dark:border-overlay-lighter dark:bg-surface">
              <table class="w-full text-left text-sm">
                <thead class="bg-canvas-soft border-b border-hairline dark:bg-surface/80 dark:border-overlay-lighter text-ink dark:text-on-primary font-bold">
                  <tr>
                    <th class="p-3">Device USD Value</th>
                    <th class="p-3">Passport Tax (PKR Approx)</th>
                    <th class="p-3">CNIC Tax (PKR Approx)</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-hairline dark:divide-overlay-lighter">
                  <tr><td class="p-3 font-medium">Up to $30 USD</td><td class="p-3 font-bold text-emerald-600">PKR 430</td><td class="p-3 font-bold text-emerald-600">PKR 550</td></tr>
                  <tr><td class="p-3 font-medium">$31 to $100 USD</td><td class="p-3 font-medium">PKR 3,200</td><td class="p-3 font-medium">PKR 4,300</td></tr>
                  <tr><td class="p-3 font-medium">$101 to $200 USD</td><td class="p-3 font-medium">PKR 11,500</td><td class="p-3 font-medium">PKR 13,800</td></tr>
                  <tr><td class="p-3 font-medium">$201 to $350 USD</td><td class="p-3 font-medium">PKR 25,000</td><td class="p-3 font-medium">PKR 29,500</td></tr>
                  <tr><td class="p-3 font-medium">$351 to $500 USD</td><td class="p-3 font-medium">PKR 32,500</td><td class="p-3 font-medium">PKR 38,000</td></tr>
                  <tr><td class="p-3 font-medium">Above $500 USD (Flagships)</td><td class="p-3 font-bold text-primary dark:text-on-primary">PKR 115,000 – 135,000+</td><td class="p-3 font-bold text-rose-600">PKR 125,000 – 145,000+</td></tr>
                </tbody>
              </table>
            </div>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">iPhone PTA Tax List 2026</h2>
            <p>
              Apple iPhones fall into upper customs valuation tiers due to high dollar values:
            </p>
            <ul>
              <li><strong>iPhone 12 Pro Max (128GB / 256GB / 512GB)</strong>: PTA tax ranges between <strong>PKR 125,000 and PKR 138,000</strong> on CNIC (approx PKR 115,000 on Passport).</li>
              <li><strong>iPhone 12 Pro</strong>: PTA tax ranges between <strong>PKR 118,000 and PKR 128,000</strong>.</li>
              <li><strong>iPhone 7 & 7 Plus (32GB / 128GB)</strong>: PTA tax ranges between <strong>PKR 10,500 and PKR 14,500</strong>.</li>
              <li><strong>iPhone 6 & 6s (16GB / 64GB)</strong>: PTA tax ranges between <strong>PKR 4,800 and PKR 7,200</strong>.</li>
              <li><strong>iPhone SE (2020 / 2022)</strong>: PTA tax ranges between <strong>PKR 26,000 and PKR 32,000</strong>.</li>
            </ul>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">Samsung PTA Tax List 2026</h2>
            <p>
              Samsung Galaxy devices vary across mid-range and flagship tiers:
            </p>
            <ul>
              <li><strong>Samsung Galaxy A51</strong>: PTA tax is approximately <strong>PKR 22,500 to PKR 25,800</strong>.</li>
              <li><strong>Samsung Galaxy A70</strong>: PTA tax is approximately <strong>PKR 24,000 to PKR 28,000</strong>.</li>
              <li><strong>Samsung Galaxy A03 / A03s</strong>: PTA tax is approximately <strong>PKR 3,500 to PKR 5,200</strong>.</li>
              <li><strong>Samsung Galaxy S21 / S21 Ultra</strong>: PTA tax ranges between <strong>PKR 105,000 and PKR 125,000</strong>.</li>
              <li><strong>Samsung Galaxy S8 / S8 Plus</strong>: PTA tax ranges between <strong>PKR 14,000 and PKR 18,500</strong>.</li>
            </ul>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">How to Pay PTA Tax Online Step-by-Step</h2>
            <ol class="list-decimal pl-6 space-y-2">
              <li>Dial <code>*8484#</code> from any Pakistani mobile SIM or visit <a href="https://dirbs.pta.gov.pk" target="_blank" rel="noopener noreferrer" class="text-link hover:underline">dirbs.pta.gov.pk</a>.</li>
              <li>Select <em>Register Mobile Device</em> and enter your 15-digit IMEI numbers.</li>
              <li>Choose <em>Passport Registration</em> (for international travelers within 60 days) or <em>CNIC Registration</em>.</li>
              <li>Receive a 17-digit PSID payment tracking number via SMS/Email.</li>
              <li>Pay online using mobile banking apps (1Bill), ATMs, or bank branches.</li>
            </ol>
            <p>
              For additional tax guides and calculation tools, explore our <a href="/knowledge/pakistan-income-tax" class="text-link hover:underline">Pakistan Income Tax Hub</a> and <a href="/blogs/pakistan-sales-tax-guide" class="text-link hover:underline">Pakistan Sales Tax Guide</a>.
            </p>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">Frequently Asked Questions</h2>
          </div>

          <div class="mt-8 space-y-4">
            {faqSchema.mainEntity.map(faq => (
              <div class="rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
                <h3 class="text-lg font-semibold text-ink dark:text-on-primary">{faq.name}</h3>
                <p class="mt-2 text-sm text-body dark:text-muted leading-relaxed">{faq.acceptedAnswer.text}</p>
              </div>
            ))}
          </div>

          <div class="mt-12 p-6 rounded-2xl bg-canvas-soft border border-hairline dark:border-overlay-lighter dark:bg-surface">
            <h3 class="text-xl font-bold text-ink dark:text-on-primary">About the Author</h3>
            <p class="mt-2 text-sm font-semibold text-primary dark:text-on-primary">{author}</p>
            <p class="mt-1 text-sm text-body dark:text-muted">{authorBio}</p>
  </div>
</BlogLayout>
