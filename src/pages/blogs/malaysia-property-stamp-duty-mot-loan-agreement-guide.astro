---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "Malaysia Property Stamp Duty Guide 2026: MOT Tiers, Loan Agreements & First Home Relief";
const description = "Comprehensive 2026 guide to Malaysia property stamp duty under the Stamp Act 1949. Learn Memorandum of Transfer (MOT) tiered rates (1% to 4%), 0.5% loan agreement stamp duty, first home buyer exemptions, and property transfer through wills.";
const image = "https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=1200&q=80";
const author = "Michael Tang, Senior Tax & Corporate Advisory Lead";
const authorBio = "Senior tax consultant specializing in Malaysian real estate stamp duty (Stamp Act 1949), Memorandum of Transfer (MOT) legal stamping, loan document duty exemptions, and property conveyancing tax structure.";
const canonical = "https://finsiva.com/blogs/malaysia-property-stamp-duty-mot-loan-agreement-guide";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What are the Memorandum of Transfer (MOT) stamp duty rates in Malaysia for 2026?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>MOT stamp duty in Malaysia is calculated on a tiered rate scale based on the property price or market value: 1% on the first RM 100,000; 2% on the next RM 400,000 (RM 100,001 to RM 500,000); 3% on the next RM 500,000 (RM 500,001 to RM 1,000,000); and 4% on amounts exceeding RM 1,000,000.</p>"
      }
    },
    {
      "@type": "Question",
      name: "What is the stamp duty exemption for first-time home buyers in Malaysia?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>Under Malaysian Budget initiatives, first-time home buyers purchasing a residential property priced up to RM 500,000 enjoy a 100% full stamp duty exemption on both the Memorandum of Transfer (MOT) and the housing loan agreement.</p>"
      }
    },
    {
      "@type": "Question",
      name: "How is stamp duty calculated on a housing loan agreement in Malaysia?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>Stamp duty on housing loan agreements in Malaysia is charged at a flat rate of 0.5% of the total loan amount approved by the commercial bank or financial institution.</p>"
      }
    },
    {
      "@type": "Question",
      name: "Is there estate duty or inheritance tax in Malaysia?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>No. Malaysia repealed Estate Duty under the Estate Duty Repeal Act 1991. There is zero estate tax or inheritance tax in Malaysia when transferring property assets to heirs upon death.</p>"
      }
    },
    {
      "@type": "Question",
      name: "What is the stamp duty for transferring property through a will or love & affection?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>Transferring property pursuant to a Will or distribution order attracts a nominal stamp duty of RM 10. Transfers between husband and wife enjoy 100% full stamp duty exemption. Transfers between parent and child enjoy a 50% or 100% exemption depending on statutory conditions.</p>"
      }
    }
  ]
};
---

<BlogLayout
  title={title}
  description={description}
  image={image}
  author={author}
  authorBio={authorBio}
  lastUpdated="August 2026"
  readTime="22 min read"
  canonical={canonical}
  schema={faqSchema}
>
  <div class="mt-8 space-y-8 text-body dark:text-muted">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- Intro Banner -->
    <p class="text-xl leading-relaxed font-light text-ink dark:text-on-primary">
      Acquiring real estate in Malaysia involves statutory legal stamping duties administered under the <strong>Stamp Act 1949 (Act 378)</strong> by the <a href="https://www.hasil.gov.my" target="_blank" rel="noopener noreferrer" class="text-link hover:underline">LHDN Stamp Duty Division</a>. Whether you are searching <em>"stamp duty on mot malaysia"</em>, <em>"first home buyer malaysia stamp duty"</em>, <em>"stamp duty on loan agreement malaysia"</em>, or <em>"duty stamp malaysia calculation"</em>, this 2026 guide covers tiered MOT rates, loan agreement duties, and statutory exemptions.
    </p>

    <!-- Key Takeaways Card -->
    <div class="rounded-2xl border border-primary/20 bg-primary/5 p-6 dark:border-primary/30 dark:bg-primary/10">
      <div class="flex items-center gap-3 mb-3">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary text-white font-bold text-sm">📜</span>
        <h3 class="text-lg font-bold text-ink dark:text-on-primary">Stamp Duty Key Highlights 2026</h3>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
        <li class="flex items-start gap-2">
          <span class="text-primary font-bold">•</span>
          <span><strong>MOT Tiered Rates:</strong> 1% (first RM100k) → 2% (next RM400k) → 3% (next RM500k) → 4% (&gt;RM1m).</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary font-bold">•</span>
          <span><strong>Loan Agreement Duty:</strong> Flat 0.5% of total bank loan amount.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary font-bold">•</span>
          <span><strong>First Home Relief:</strong> 100% Stamp Duty Exemption on MOT & Loan for homes ≤ RM 500,000.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary font-bold">•</span>
          <span><strong>Zero Estate Duty:</strong> Estate Tax was repealed in 1991 (RM 10 nominal duty on Will transfers).</span>
        </li>
      </ul>
    </div>

    <!-- Table of Contents -->
    <div class="rounded-xl border border-hairline bg-canvas-soft p-6 dark:border-overlay-light dark:bg-surface">
      <h2 class="text-xl font-semibold text-ink mb-4 dark:text-on-primary">Guide Navigation</h2>
      <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2 text-sm">
        <li><a href="#mot-tiered-stamp-duty-rates" class="text-link hover:underline">1. Memorandum of Transfer (MOT) Tiered Rate Schedule</a></li>
        <li><a href="#loan-agreement-stamp-duty-05" class="text-link hover:underline">2. Housing Loan Agreement Stamp Duty (0.5% Rate)</a></li>
        <li><a href="#first-home-buyer-exemptions" class="text-link hover:underline">3. First-Time Home Buyer Stamp Duty Exemptions</a></li>
        <li><a href="#property-transfers-wills-love-affection" class="text-link hover:underline">4. Property Transfers via Wills, Gifts & Family Love and Affection</a></li>
        <li><a href="#estate-duty-status-malaysia" class="text-link hover:underline">5. Estate Duty & Inheritance Tax Status in Malaysia</a></li>
        <li><a href="#worked-stamp-duty-calculation" class="text-link hover:underline">6. Worked Calculation Example: RM 750,000 Property</a></li>
        <li><a href="#faqs" class="text-link hover:underline">7. Frequently Asked Questions (FAQ)</a></li>
      </ul>
    </div>

    <!-- Section 1 -->
    <h2 id="mot-tiered-stamp-duty-rates" class="text-2xl font-semibold text-ink dark:text-on-primary">1. Memorandum of Transfer (MOT) Tiered Rate Schedule</h2>
    <p>
      When purchasing property in Malaysia, the <strong>Memorandum of Transfer (MOT / Form 14A)</strong> or Deed of Assignment transfers legal ownership from seller to buyer. MOT stamp duty is calculated on the property price or market value (whichever is higher) using a progressive tiered scale:
    </p>

    <!-- MOT Tiered Table -->
    <div class="overflow-x-auto my-6">
      <table class="min-w-full border border-hairline text-left text-sm dark:border-overlay-lighter">
        <thead class="bg-canvas-soft font-semibold text-ink dark:bg-surface dark:text-on-primary">
          <tr>
            <th class="border p-3">Property Value Tiers (MYR)</th>
            <th class="border p-3">Statutory MOT Stamp Duty Rate</th>
            <th class="border p-3">Max Duty per Tier (MYR)</th>
            <th class="border p-3">Cumulative Duty (MYR)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline dark:divide-overlay-lighter">
          <tr>
            <td class="p-3 font-medium">First RM 100,000</td>
            <td class="p-3 font-bold text-emerald-600">1%</td>
            <td class="p-3">RM 1,000</td>
            <td class="p-3 font-medium">RM 1,000</td>
          </tr>
          <tr>
            <td class="p-3 font-medium">Next RM 400,000 (RM 100,001 – RM 500,000)</td>
            <td class="p-3 font-bold text-slate-700 dark:text-slate-300">2%</td>
            <td class="p-3">RM 8,000</td>
            <td class="p-3 font-medium">RM 9,000</td>
          </tr>
          <tr>
            <td class="p-3 font-medium">Next RM 500,000 (RM 500,001 – RM 1,000,000)</td>
            <td class="p-3 font-bold text-slate-700 dark:text-slate-300">3%</td>
            <td class="p-3">RM 15,000</td>
            <td class="p-3 font-medium">RM 24,000</td>
          </tr>
          <tr class="bg-primary/5 font-semibold dark:bg-primary/10">
            <td class="p-3 text-primary">Above RM 1,000,000</td>
            <td class="p-3 font-extrabold text-primary text-base">4%</td>
            <td class="p-3">—</td>
            <td class="p-3 text-primary font-bold">4% on Balance Value</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Section 2 -->
    <h2 id="loan-agreement-stamp-duty-05" class="text-2xl font-semibold text-ink dark:text-on-primary">2. Housing Loan Agreement Stamp Duty (0.5% Rate)</h2>
    <p>
      In addition to the MOT, property buyers taking out a bank mortgage loan must pay stamp duty on the facility agreement.
    </p>
    <p>
      Under Item 27, First Schedule of the Stamp Act 1949, loan agreement stamp duty is charged at a flat rate of <strong>0.5% of the total loan amount</strong>. For example, a bank loan of RM 600,000 incurs <code>RM 600,000 × 0.5% = RM 3,000</code> in loan agreement stamp duty.
    </p>

    <!-- Section 3 -->
    <h2 id="first-home-buyer-exemptions" class="text-2xl font-semibold text-ink dark:text-on-primary">3. First-Time Home Buyer Stamp Duty Exemptions</h2>
    <p>
      To assist Malaysian citizens in owning their first residential property, the Ministry of Finance grants statutory stamp duty exemptions:
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6 text-sm">
      <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-5 dark:border-emerald-500/30 dark:bg-emerald-500/10">
        <span class="rounded bg-emerald-600 text-white px-2.5 py-1 text-xs font-bold">100% FULL EXEMPTION</span>
        <h4 class="font-bold text-ink mt-2 mb-1 dark:text-on-primary">Homes Priced Up To RM 500,000</h4>
        <p class="text-sm text-body dark:text-muted">
          First-time Malaysian home buyers purchasing a residential home priced up to RM 500,000 pay <strong>RM 0 stamp duty</strong> on both MOT and Loan Agreement (saving up to RM 11,500).
        </p>
      </div>

      <div class="rounded-xl border border-primary/20 bg-primary/5 p-5 dark:border-primary/30 dark:bg-primary/10">
        <span class="rounded bg-primary text-white px-2.5 py-1 text-xs font-bold">PARTIAL EXEMPTION</span>
        <h4 class="font-bold text-ink mt-2 mb-1 dark:text-on-primary">Homes Priced RM 500,001 to RM 1,000,000</h4>
        <p class="text-sm text-body dark:text-muted">
          First-time home buyers purchasing properties priced between RM 500,001 and RM 1,000,000 receive a <strong>75% stamp duty remittal</strong> on the MOT.
        </p>
      </div>
    </div>

    <!-- Section 4 -->
    <h2 id="property-transfers-wills-love-affection" class="text-2xl font-semibold text-ink dark:text-on-primary">4. Property Transfers via Wills, Gifts & Family Love and Affection</h2>
    <p>
      When property is transferred between family members without a commercial sale, special stamp duty rules apply under LHDN guidelines:
    </p>
    <ul class="list-disc pl-6 space-y-2 text-sm">
      <li><strong>Spouse to Spouse (Husband/Wife):</strong> <strong>100% Full Exemption</strong> on MOT stamp duty under Stamp Duty (Remission) Order.</li>
      <li><strong>Parent to Child / Child to Parent:</strong> <strong>100% Full Exemption</strong> on the first RM 1,000,000 of property value, and 50% remittal on the balance value.</li>
      <li><strong>Transfer Pursuant to a Will:</strong> Nominal stamp duty of <strong>RM 10 per document</strong> under Item 32(i), First Schedule.</li>
    </ul>

    <!-- Section 5 -->
    <h2 id="estate-duty-status-malaysia" class="text-2xl font-semibold text-ink dark:text-on-primary">5. Estate Duty & Inheritance Tax Status in Malaysia</h2>
    <p>
      Many international investors inquire about <em>"estate duty malaysia"</em> or <em>"malaysia estate tax"</em>.
    </p>
    <p>
      In Malaysia, <strong>Estate Duty was completely repealed</strong> under the Estate Duty Repeal Act 1991 (effective 1 November 1991). Malaysia levies <strong>zero inheritance tax</strong> on money, shares, or property passed to beneficiaries upon death!
    </p>

    <!-- Section 6 Worked Example -->
    <h2 id="worked-stamp-duty-calculation" class="text-2xl font-semibold text-ink dark:text-on-primary">6. Worked Calculation Example: RM 750,000 Property</h2>
    <p>
      Consider a non-first-time home buyer purchasing a residential house for RM 750,000 with an 80% bank loan (RM 600,000):
    </p>

    <!-- Worked Example Card -->
    <div class="rounded-xl border border-hairline bg-canvas-soft p-6 dark:border-overlay-light dark:bg-surface my-6">
      <h3 class="text-lg font-bold text-ink mb-4 dark:text-on-primary">Step-by-Step Legal Stamping Breakdown</h3>
      <div class="space-y-3 text-sm font-mono">
        <div class="flex justify-between border-b border-hairline pb-2 dark:border-overlay-lighter">
          <span>1% on First RM 100,000:</span>
          <span class="font-bold">RM 1,000.00</span>
        </div>
        <div class="flex justify-between border-b border-hairline pb-2 dark:border-overlay-lighter">
          <span>2% on Next RM 400,000 (RM 100k – RM 500k):</span>
          <span class="font-bold">RM 8,000.00</span>
        </div>
        <div class="flex justify-between border-b border-hairline pb-2 dark:border-overlay-lighter">
          <span>3% on Remaining RM 250,000 (RM 500k – RM 750k):</span>
          <span class="font-bold">RM 7,500.00</span>
        </div>
        <div class="flex justify-between border-b border-hairline pb-2 dark:border-overlay-lighter font-bold text-primary">
          <span>TOTAL MOT STAMP DUTY PAYABLE:</span>
          <span>RM 16,500.00</span>
        </div>
        <div class="flex justify-between border-b border-hairline pb-2 dark:border-overlay-lighter pt-2">
          <span>Loan Agreement Duty (0.5% of RM 600,000 Loan):</span>
          <span class="font-bold">RM 3,000.00</span>
        </div>
        <div class="flex justify-between text-base font-extrabold text-ink dark:text-on-primary pt-1">
          <span>TOTAL COMBINED LEGAL STAMPING DUTY:</span>
          <span class="text-primary">RM 19,500.00</span>
        </div>
      </div>
    </div>

    <p class="mt-4">
      Estimate your income tax and property tax deductions using our <a href="/countries/malaysia/income-tax/income-tax-calculator/" class="text-link font-semibold hover:underline">Malaysia Income Tax Calculator</a>.
    </p>

    <!-- Section 7 FAQs -->
    <h2 id="faqs" class="text-2xl font-semibold text-ink dark:text-on-primary">7. Frequently Asked Questions (FAQ)</h2>
    <div class="space-y-4">
      <div class="rounded-lg border border-hairline bg-canvas p-4 dark:border-overlay-lighter dark:bg-surface">
        <h3 class="text-lg font-semibold text-ink dark:text-on-primary">What is the MOT stamp duty rate for property exceeding RM 1 million?</h3>
        <p class="mt-1 text-sm">Portions of property value exceeding RM 1,000,000 attract the top 4% MOT stamp duty rate.</p>
      </div>

      <div class="rounded-lg border border-hairline bg-canvas p-4 dark:border-overlay-lighter dark:bg-surface">
        <h3 class="text-lg font-semibold text-ink dark:text-on-primary">Do first-time buyers pay stamp duty on housing loans?</h3>
        <p class="mt-1 text-sm">First-time Malaysian home buyers purchasing a residential property priced up to RM 500,000 receive 100% full exemption on both MOT and loan agreement stamp duty.</p>
      </div>

      <div class="rounded-lg border border-hairline bg-canvas p-4 dark:border-overlay-lighter dark:bg-surface">
        <h3 class="text-lg font-semibold text-ink dark:text-on-primary">Is there inheritance tax or estate duty in Malaysia?</h3>
        <p class="mt-1 text-sm">No. Estate Duty was repealed in 1991. Malaysia levies zero inheritance tax when transferring assets to beneficiaries.</p>
      </div>
    </div>

    <!-- Related Links -->
    <div class="mt-12 rounded-xl border border-hairline bg-canvas-soft p-6 dark:border-overlay-light dark:bg-surface">
      <h3 class="text-xl font-semibold text-ink mb-3 dark:text-on-primary">Related Malaysia Property & Tax Resources</h3>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 text-sm">
        <a href="/blogs/malaysia-rpgt-real-property-gains-tax-2026-guide/" class="text-link hover:underline font-medium">Real Property Gains Tax (RPGT) Guide</a>
        <a href="/blogs/malaysia-property-tax-cukai-pintu-quit-rent-digital-services-guide/" class="text-link hover:underline font-medium">Cukai Pintu & Quit Rent Tax Guide</a>
        <a href="/blogs/malaysia-freelancer-rental-airbnb-dividend-tax-guide/" class="text-link hover:underline font-medium">Rental Income & Airbnb Tax Guide</a>
        <a href="/blogs/malaysia-personal-income-tax-rates-brackets-2026-guide/" class="text-link hover:underline font-medium">Personal Income Tax Rates 2026</a>
        <a href="/blogs/malaysia-expats-foreigners-non-resident-tax-guide-2026/" class="text-link hover:underline font-medium">Expats & Foreigners Tax Guide</a>
        <a href="/countries/malaysia/" class="text-link hover:underline font-medium">Finsiva Malaysia Tax Hub</a>
      </div>
    </div>
  </div>
</BlogLayout>
