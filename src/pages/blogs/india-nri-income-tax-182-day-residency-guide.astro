---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "NRI Tax in India Guide: 182-Day Rule, NRE vs NRO & DTAA Relief";
const description = "Complete 2026 guide to NRI taxation in India. Understand the 182-day residency rule, RNOR status, NRE vs NRO bank interest, Section 195 property TDS, and DTAA foreign tax relief.";
const image = "https://images.unsplash.com/photo-1526304640581-d334cdbbf45e?w=1200&q=80";
const canonical = "https://finsiva.com/blogs/india-nri-income-tax-182-day-residency-guide/";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How is NRI tax residency determined under the 182-day rule in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An individual is classified as an Indian tax resident under Section 6 of the Income-tax Act if they stay in India for 182 days or more during the financial year, or stay for at least 60 days in the current year and 365 days or more across the preceding 4 financial years. For Indian citizens leaving India for employment abroad or visiting citizens with Indian income under ₹15 Lakhs, the 60-day threshold is substituted with 182 days."
      }
    },
    {
      "@type": "Question",
      "name": "Is foreign income earned by an NRI taxable in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Income earned, accrued, or received outside India by a Non-Resident Indian (NRI) is completely exempt from Indian income tax. NRIs are taxed in India strictly on income that is earned, accrued, or received within the territory of India, such as Indian rental income, capital gains from Indian shares or mutual funds, and interest from NRO bank deposits."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference in taxation between NRE and NRO bank accounts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Interest earned on a Non-Resident External (NRE) savings or fixed deposit account is 100% tax-free in India under Section 10(4) and fully repatriable abroad. In contrast, interest earned on a Non-Resident Ordinary (NRO) account is subject to Indian income tax and withheld at source (TDS) at 30% plus applicable cess and surcharge, unless reduced under a Double Taxation Avoidance Agreement (DTAA)."
      }
    },
    {
      "@type": "Question",
      "name": "What is the TDS rate when an NRI sells residential property in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When an NRI sells an immovable property in India, the buyer must deduct TDS under Section 195 at 20% (plus surcharge and cess) on long-term capital gains, or at 30% (plus surcharge and cess) on short-term capital gains. Because buyers often withhold tax on the gross sale consideration rather than the net capital gain, NRIs should apply for a Lower Deduction Certificate (Form 13) from the Income Tax Department prior to executing the sale."
      }
    },
    {
      "@type": "Question",
      "name": "How does an NRI claim DTAA benefits to avoid double taxation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To claim treaty benefits under a Double Taxation Avoidance Agreement (DTAA) under Section 90, an NRI must obtain a Tax Residency Certificate (TRC) from the tax authority of their country of residence, file self-declaration Form 10F electronically on the Indian e-filing portal, and submit Form 67 to claim Foreign Tax Credit (FTC) before filing their annual ITR."
      }
    }
  ]
};
---

<BlogLayout
