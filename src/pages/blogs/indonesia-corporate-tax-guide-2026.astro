---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "Indonesia Corporate Income Tax Guide 2026: 22% Rate & SME Discounts";
const description = "Complete guide to Indonesia corporate income tax (PPh Badan). Learn the 22% corporate tax rate, Article 31E 50% SME tax discount, 0.5% turnover tax, and annual corporate SPT 1771 filing.";
const image = "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=1200&q=80";
const author = "Bambang Santoso, Certified Indonesian Tax Consultant";
const authorBio = "Certified Indonesian Tax Consultant specializing in corporate tax compliance, PT PMA entity structuring, Article 31E SME tax reductions, and DJP audit defense.";
const canonical = "https://finsiva.com/blogs/indonesia-corporate-tax-guide-2026";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is the standard corporate income tax rate in Indonesia for 2026?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The standard corporate income tax rate in Indonesia is a flat 22% applied to the net taxable income of domestic companies and permanent establishments (BUT)."
      }
    },
    {
      "@type": "Question",
      name: "How does the Article 31E SME tax discount work?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Domestic corporate taxpayers with an annual gross turnover up to IDR 50 billion are eligible for a 50% reduction on the standard 22% rate. This effective 11% rate applies proportionally to the taxable income attributed to the first IDR 4.8 billion of gross turnover."
      }
    },
    {
      "@type": "Question",
      name: "Who qualifies for the 0.5% final turnover tax?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Micro, small, and medium enterprises (MSMEs) with an annual gross turnover not exceeding IDR 4.8 billion can elect to pay a 0.5% final income tax on their monthly gross turnover under PP 55/2022. This applies for up to 3 years for limited liability companies (PT) and 4 years for cooperatives, CVs, or firms."
      }
    },
    {
      "@type": "Question",
      name: "What is the deadline for filing the annual corporate tax return (SPT Tahunan 1771)?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The annual corporate tax return (SPT Tahunan PPh Badan 1771) must be filed electronically via DJP Online by April 30, which is the end of the fourth month after the close of the financial year. Late filing incurs an administrative penalty of IDR 1,000,000."
      }
    },
    {
      "@type": "Question",
      name: "What are the common withholding taxes for corporations in Indonesia?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Corporations must act as withholding agents for various transactions. Key withholding taxes include PPh 23 (2% on services and rent of assets, 15% on dividends/interest/royalties), PPh 4(2) (10% final tax on land/building rent), and PPh 26 (20% on payments to foreign entities, subject to tax treaty reductions)."
      }
    }
  ]
};
---

