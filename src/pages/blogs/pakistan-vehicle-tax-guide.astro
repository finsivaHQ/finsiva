---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "Pakistan Vehicle Tax Guide 2026: Token Tax, Customs & Car Registration";
const description = "Complete guide to vehicle tax in Pakistan. Learn provincial motor vehicle token tax across Punjab, Sindh, KPK & Islamabad, customs duty on Toyota Aqua/Honda Civic/Vezel, and luxury car taxes.";
const image = "https://images.unsplash.com/photo-1549399542-7e3f8b79c341?w=1200&q=80";
const canonical = "https://finsiva.com/blogs/pakistan-vehicle-tax-guide";
const author = "Sana Chaudhry";
const authorBio = "Automotive tax analyst specializing in provincial motor vehicle taxation, ePay online systems, and FBR custom duties.";
const lastUpdated = "August 2026";
const readTime = "15 min read";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How is vehicle token tax calculated in Pakistan?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Vehicle token tax is calculated annually based on engine displacement capacity (CC), vehicle age, province of registration (Punjab, Sindh, ICT, KPK), and FBR Active Taxpayer (filer) status."
      }
    },
    {
      "@type": "Question",
      "name": "What is the custom duty on imported cars like Toyota Aqua, Honda Civic, and Vezel?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Custom duty on imported vehicles is assessed under FBR customs valuation based on engine CC capacity (e.g., 1300cc, 1500cc, 1800cc), hybrid concessions, regulatory duty, and sales tax."
      }
    },
    {
      "@type": "Question",
      "name": "How to pay motor vehicle token tax online in Sindh and Punjab?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "In Punjab, generate a PSID via ePay Punjab. In Sindh, generate a PSID on e-Payment GOS (excise.gos.pk) or MTMIS Sindh and pay via mobile banking apps."
      }
    },
    {
      "@type": "Question",
      "name": "What is the advance withholding tax discount for active tax filers on vehicle purchases?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "FBR active tax filers pay 50% or lower advance withholding tax on new motor vehicle registration and transfer compared to non-filers under Section 231B."
      }
    }
  ]
};
---

<BlogLayout title={title} description={description} image={image} canonical={canonical} author={author} authorBio={authorBio} lastUpdated={lastUpdated} readTime={readTime}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="min-h-screen bg-canvas dark:bg-canvas">
    <main class="min-h-screen">
      <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb" class="mb-6 text-sm">
          <ol class="flex flex-wrap items-center gap-2">
            <li class="flex items-center gap-2"><a href="/" class="text-link hover:underline dark:text-link">Home</a></li>
            <li class="flex items-center gap-2"><span class="text-muted" aria-hidden="true">/</span><a href="/blogs" class="text-link hover:underline dark:text-link">Blogs</a></li>
            <li class="flex items-center gap-2"><span class="text-muted" aria-hidden="true">/</span><span class="font-medium text-ink dark:text-on-primary" aria-current="page">Pakistan Vehicle Tax Guide</span></li>
          </ol>
        </nav>

        <article class="prose max-w-none">
          <h1 class="text-3xl sm:text-4xl font-bold text-ink mb-4 dark:text-on-primary">Pakistan Vehicle Tax Guide 2026: Token Tax, Customs & Car Registration</h1>
          <p class="text-lg text-body dark:text-muted">Last updated: August 2026 | Verified FBR & Provincial Excise Guidelines | 15 min read</p>

          <img src="https://images.unsplash.com/photo-1549399542-7e3f8b79c341?w=1200&q=80" alt="Automobile vehicle taxation and online token tax payment in Pakistan" class="mb-6 w-full rounded-lg object-cover max-h-80 sm:max-h-96" loading="lazy" />

          <!-- Early Calculator CTA -->
          <div class="my-6 p-6 rounded-2xl border border-primary/30 bg-primary/5 dark:border-primary/20 dark:bg-primary/5 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <h3 class="text-xl font-bold text-ink dark:text-on-primary">Calculate Vehicle Token Tax Instantly</h3>
              <p class="text-sm text-body dark:text-muted mt-1">Check engine CC token tax across Punjab, Sindh, Islamabad, and KPK.</p>
            </div>
            <a href="/countries/pakistan/vehicle-tax/vehicle-tax-calculator" class="btn btn-primary text-sm font-semibold shrink-0 px-5 py-2.5">
              Launch Vehicle Tax Calculator →
            </a>
          </div>

          <div class="mt-8 space-y-6 text-body dark:text-muted leading-relaxed">
            <p>
              Understanding <strong>pakistan vehicle tax</strong>, <strong>car tax rates karachi</strong>, <strong>sindh motor vehicle tax</strong>, and federal customs duties is essential for car buyers, vehicle owners, and commercial fleet operators.
            </p>
            <p>
              Vehicle taxation in Pakistan involves two distinct administrative levels: <strong>Provincial Excise & Taxation Departments</strong> (Punjab, Sindh, ICT, KPK, Balochistan) collecting annual token taxes and transfer fees, and <strong>Federal FBR</strong> collecting advance withholding taxes under Section 231B/234 and customs duties on vehicle imports.
            </p>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">1. Provincial Excise Department Systems & Portals</h2>
            <p>
              Provincial excise departments collect annual token tax through integrated online portals:
            </p>
            <ul>
              <li><strong>Excise and Taxation Punjab (Lahore, Multan, Faisalabad, Rawalpindi)</strong>: Payments handled via <em>ePay Punjab</em> app generating 17-digit PSID numbers for online mobile banking.</li>
              <li><strong>Excise and Taxation Sindh (Karachi, Hyderabad)</strong>: Online verification via MTMIS Sindh and payment via e-Payment GOS (<code>excise.gos.pk</code>).</li>
              <li><strong>Excise and Taxation Islamabad (ICT)</strong>: Online token tax payments processed through the City Islamabad App.</li>
              <li><strong>Excise and Taxation KPK (Peshawar)</strong>: Online token tax verification via Zameen Dang / KP Excise portal.</li>
            </ul>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">2. Annual Engine CC Token Tax Rates (2026)</h2>
            <p>
              Token tax schedules depend on engine displacement (CC):
            </p>

            <div class="my-6 overflow-x-auto rounded-xl border border-hairline bg-canvas dark:border-overlay-lighter dark:bg-surface">
              <table class="w-full text-left text-sm">
                <thead class="bg-canvas-soft border-b border-hairline dark:bg-surface/80 dark:border-overlay-lighter text-ink dark:text-on-primary font-bold">
                  <tr>
                    <th class="p-3">Engine Capacity (CC)</th>
                    <th class="p-3">Punjab / ICT Rate (Approx)</th>
                    <th class="p-3">Sindh Rate (Approx)</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-hairline dark:divide-overlay-lighter">
                  <tr><td class="p-3 font-medium">Below 1000 CC (Alto, Cultus, WagonR)</td><td class="p-3 font-bold text-emerald-600">Lifetime Token Tax (PKR 10,000 - 15,000)</td><td class="p-3 font-bold text-emerald-600">Lifetime Token Tax</td></tr>
                  <tr><td class="p-3 font-medium">1001 CC to 1300 CC (Yaris, City)</td><td class="p-3">PKR 1,800 – 3,000 / year</td><td class="p-3">PKR 2,500 – 4,000 / year</td></tr>
                  <tr><td class="p-3 font-medium">1301 CC to 1500 CC (Civic, Elantra)</td><td class="p-3">PKR 3,500 – 6,000 / year</td><td class="p-3">PKR 4,500 – 7,500 / year</td></tr>
                  <tr><td class="p-3 font-medium">1501 CC to 2500 CC (Sportage, Tucson, Fortuner)</td><td class="p-3 font-bold text-primary dark:text-on-primary">PKR 9,000 – 18,000 / year</td><td class="p-3 font-bold text-primary dark:text-on-primary">PKR 10,000 – 22,000 / year</td></tr>
                </tbody>
              </table>
            </div>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">3. Custom Duty on Imported Cars (Toyota Aqua, Civic, Vezel)</h2>
            <p>
              FBR levies heavy customs duties, regulatory duties, sales tax, and advance income tax on imported vehicles:
            </p>
            <ul>
              <li><strong>Custom Duty on Toyota Aqua (1500cc Hybrid)</strong>: Benefits from statutory hybrid concessions (50% concession for 1800cc hybrids under baggage/gift schemes), but total duty payable typically ranges between <strong>PKR 2.2M and PKR 3.0M</strong> depending on model year and grade.</li>
              <li><strong>Honda Vezel Custom Duty (1500cc Hybrid SUV)</strong>: Total import duty and taxes range between <strong>PKR 2.8M and PKR 3.6M</strong>.</li>
              <li><strong>Honda Civic Custom Duty (1500cc Turbo / 1800cc)</strong>: Commercial import duties exceed 100% of C&F value.</li>
            </ul>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">4. FBR Advance Tax on New Car Registration (Section 231B)</h2>
            <p>
              When purchasing or registering a new motor vehicle, FBR collects advance withholding tax under Section 231B. Active tax filers enjoy a <strong>50% discount</strong> compared to non-filers.
            </p>
            <p>
              Calculate your vehicle token tax on our <a href="/countries/pakistan/vehicle-tax/vehicle-tax-calculator" class="text-link hover:underline">Vehicle Tax Calculator</a>, read our <a href="/blogs/pakistan-token-tax-guide" class="text-link hover:underline">Pakistan Token Tax Guide</a>, or visit the main <a href="/knowledge/pakistan-income-tax" class="text-link hover:underline">Pakistan Income Tax Hub</a>.
            </p>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">Frequently Asked Questions</h2>
          </div>

          <div class="mt-8 space-y-4">
            {faqSchema.mainEntity.map(faq => (
              <div class="rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
                <h3 class="text-lg font-semibold text-ink dark:text-on-primary">{faq.name}</h3>
                <p class="mt-2 text-sm text-body dark:text-muted leading-relaxed">{faq.acceptedAnswer.text}</p>
              </div>
            ))}
          </div>

          <div class="mt-12 p-6 rounded-2xl bg-canvas-soft border border-hairline dark:border-overlay-lighter dark:bg-surface">
            <h3 class="text-xl font-bold text-ink dark:text-on-primary">About the Author</h3>
            <p class="mt-2 text-sm font-semibold text-primary dark:text-on-primary">{author}</p>
            <p class="mt-1 text-sm text-body dark:text-muted">{authorBio}</p>
          </div>
        </article>
      </div>
    </main>
  </div>
</BlogLayout>