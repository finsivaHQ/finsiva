// FAQ Schema Data
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is the Hong Kong corporate tax strictly 16.5%?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For standard corporations, yes, the flat rate is 16.5%. However, under the two-tiered profits tax regime, the first HK$2 million of assessable profits is taxed at just 8.25%, with the remainder at 16.5%."
      }
    },
    {
      "@type": "Question",
      "name": "What is a connected entity and why does it matter?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A connected entity is a business under the same control or ownership group. The HK$2 million concession is restricted to only one entity within a connected group, meaning you cannot spawn multiple companies just to claim the 8.25% rate on each."
      }
    },
    {
      "@type": "Question",
      "name": "How does the IRD determine if my profits are sourced in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The IRD uses the 'broad guiding principle' to see what the taxpayer has done to earn the profit and where it was done. This includes where contracts were negotiated, where the board meets, and where physical operations take place."
      }
    },
    {
      "@type": "Question",
      "name": "Are there any capital gains taxes for companies in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Hong Kong does not levy capital gains tax. Profits derived from the sale of capital assets are typically tax-free, though the IRD heavily scrutinizes whether a transaction is truly capital in nature or actually trading activity."
      }
    },
    {
      "@type": "Question",
      "name": "What are provisional profits taxes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Because taxes are assessed on the current year's profits but paid later, the IRD requires a provisional tax payment based on the prior year's profits. This essentially pre-pays your tax for the upcoming year."
      }
    },
    {
      "@type": "Question",
      "name": "Can offshore profits be remitted tax-free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. If the profits are genuinely sourced outside of Hong Kong and the IRD has granted an offshore exemption, you can remit those funds into a Hong Kong bank account without triggering any tax liability."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need audited accounts to file?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Unlike many offshore jurisdictions, Hong Kong requires every registered company to submit audited financial statements along with their profits tax return, regardless of whether they traded or claimed an offshore exemption."
      }
    }
  ]
};
