---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "Singapore Tax Reliefs, Deductions & Rebates Guide 2026";
const description = "Complete guide to reducing personal income tax legally in Singapore. Learn Earned Income Relief, CPF top-ups, SRS deductions, Parent/Spouse relief, and the S$80,000 overall relief cap.";
const image = "https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?w=1200&q=80";
const author = "Tan Wei Ming, Accredited Tax Practitioner";
const authorBio = "Accredited Tax Practitioner (Singapore) specializing in personal wealth structuring, SRS retirement planning, and IRAS tax deduction optimization.";
const canonical = "https://finsiva.com/blogs/singapore-tax-reliefs-deductions-rebates-guide";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is the maximum tax relief cap in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The total aggregate personal income tax relief an individual can claim is capped at S$80,000 per Year of Assessment. This cap applies to all personal tax reliefs, including CPF top-ups, SRS contributions, and family reliefs."
      }
    },
    {
      "@type": "Question",
      name: "How does Supplementary Retirement Scheme (SRS) reduce tax in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Contributions to an SRS account provide a 100% dollar-for-dollar tax deduction, up to S$15,300 per year for Singapore Citizens/PRs and S$35,700 for foreign Employment Pass holders. The amount contributed lowers your chargeable income."
      }
    },
    {
      "@type": "Question",
      name: "Can foreign Employment Pass holders claim CPF relief?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Foreigners do not contribute to mandatory CPF and cannot claim CPF tax relief. However, foreigners can claim SRS contribution relief up to S$35,700 annually, making it the most significant tax-saving tool for expats."
      }
    },
    {
      "@type": "Question",
      name: "How is the Working Mother's Child Relief (WMCR) calculated?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "WMCR is calculated as a percentage of the mother's earned income. For a Singapore Citizen child born or adopted before 1 Jan 2024, it's 15% for the 1st child, 20% for the 2nd, and 25% for the 3rd and subsequent children. For children born on or after 1 Jan 2024, WMCR is a fixed dollar amount: $8,000, $10,000, and $12,000 respectively."
      }
    }
  ]
};
---

<BlogLayout
  title={title}
