---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "Hong Kong Stamp Duty Guide: Property & Tenancy Stamp Duty Rates";
const description = "Hong Kong stamp duty guide for property buyers, landlords & investors. Learn Scale 2 AVD rates, BSD, SSD rules, first-time buyer concessions, and calculate duty.";
const image = "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=1200&q=80";
const canonical = "https://finsiva.com/blogs/hong-kong-stamp-duty-guide";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the Ad Valorem Stamp Duty (AVD) rate in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For Hong Kong Permanent Residents purchasing their sole residential property, Scale 2 AVD rates apply, starting at a flat HK$100 for properties up to HK$3 million, rising progressively to 1.5%, 2.25%, 3%, 3.75%, up to a maximum cap of 4.25% for properties valued above HK$21.73 million."
      }
    },
    {
      "@type": "Question",
      "name": "What is Buyer's Stamp Duty (BSD) in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Buyer's Stamp Duty (BSD) was introduced for non-Hong Kong permanent residents and corporate purchasers. Following recent government budget updates, BSD and Special Stamp Duty (SSD) demand-management cooling measures have been lifted to stimulate property transactions."
      }
    },
    {
      "@type": "Question",
      "name": "How is stamp duty calculated on rental tenancy agreements in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rental lease stamp duty (stamping of tenancy agreement) is calculated on average annual rent: 0.25% for leases under 1 year, 0.5% for leases between 1 and 3 years, and 1% for leases exceeding 3 years, plus HK$5 for duplicate counterparts."
      }
    },
    {
      "@type": "Question",
      "name": "When must Hong Kong stamp duty be paid to the IRD?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Stamp duty must be paid within 30 days after the execution of the sale and purchase agreement or tenancy lease document. Late payment incurs statutory penalties up to 10 times the duty owed."
      }
    }
  ]
};
---

<BlogLayout title={title} description={description} image={image} canonical={canonical} author="Andrew Ho" authorBio="Andrew Ho is a tax attorney specializing in Hong Kong real estate conveyancing, stamp duty planning, and IRD regulatory compliance." lastUpdated="August 2026" readTime="11 min read">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="min-h-screen bg-canvas dark:bg-canvas">
    <main class="min-h-screen">
      <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb" class="mb-6 text-sm">
          <ol class="flex flex-wrap items-center gap-2">
            <li class="flex items-center gap-2"><a href="/" class="text-link hover:underline dark:text-link">Home</a></li>
            <li class="flex items-center gap-2"><span class="text-muted">/</span><a href="/blogs" class="text-link hover:underline dark:text-link">Blogs</a></li>
            <li class="flex items-center gap-2"><span class="text-muted">/</span><span class="font-medium text-ink dark:text-on-primary" aria-current="page">Hong Kong Stamp Duty Guide</span></li>
          </ol>
        </nav>

        <article class="prose max-w-none">
          <h1 class="text-3xl sm:text-4xl font-bold text-ink mb-4 dark:text-on-primary">Hong Kong Stamp Duty Guide: Property & Tenancy Stamp Duty Rates</h1>
          <p class="text-lg text-body dark:text-muted">Last updated: August 2026 | Verified Stamp Office Rules | 11 min read</p>

          <img src="https://images.unsplash.com/photo-1450101499163-c8848c66ca85?w=1200&q=80" alt="Tax documents and stamp duty paperwork - Stamp Duty Guide" class="mb-6 w-full rounded-lg object-cover max-h-80 sm:max-h-96" loading="lazy" />

          <!-- Early Calculator CTA -->
          <div class="my-6 p-6 rounded-2xl border border-primary/30 bg-primary/5 dark:border-primary/20 dark:bg-primary/5 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <h3 class="text-xl font-bold text-ink dark:text-on-primary">Calculate Your HK Property & Lease Stamp Duty</h3>
              <p class="text-sm text-body dark:text-muted mt-1">Estimate Scale 2 AVD rates, first-time buyer concessions, and tenancy agreement stamping fees instantly.</p>
            </div>
            <a href="/countries/hong-kong/stamp-duty/hk-property-stamp-duty-calculator" class="btn btn-primary text-sm font-semibold shrink-0 px-5 py-2.5">
              Launch Stamp Duty Calculator →
            </a>
          </div>

          <div class="mt-8 space-y-6 text-body dark:text-muted leading-relaxed">
            <p>Hong Kong <strong>Stamp Duty</strong> is a statutory transaction duty governed by the <em>Stamp Duty Ordinance (Cap. 117)</em> and administered by the <strong>Stamp Office</strong> of the Inland Revenue Department. Stamp duty applies to conveyances on sale of residential and commercial property, agreements for sale, and tenancy agreements (leases).</p>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">Ad Valorem Stamp Duty (AVD) Scale 2 Rates</h2>
            <p>Ad Valorem Stamp Duty (AVD) is calculated on the consideration (purchase price) or market value of the property, whichever is higher. Under Scale 2 (applicable to Hong Kong Permanent Residents acting on their own behalf without owning other residential property):</p>

            <div class="my-4 overflow-x-auto rounded-xl border border-hairline bg-canvas dark:border-overlay-lighter dark:bg-surface">
              <table class="w-full text-left text-sm">
                <thead class="bg-canvas-soft border-b border-hairline dark:bg-surface/80 dark:border-overlay-lighter text-ink dark:text-on-primary font-bold">
                  <tr>
                    <th class="p-3">Property Consideration / Value (HKD)</th>
                    <th class="p-3">Scale 2 AVD Rate</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-hairline dark:divide-overlay-lighter">
                  <tr><td class="p-3">Up to HK$3,000,000</td><td class="p-3 font-bold text-primary dark:text-on-primary">HK$100 flat</td></tr>
                  <tr><td class="p-3">HK$3,000,001 – HK$3,528,240</td><td class="p-3">HK$100 + 10% of excess over HK$3M</td></tr>
                  <tr><td class="p-3">HK$3,528,241 – HK$4,500,000</td><td class="p-3">1.50%</td></tr>
                  <tr><td class="p-3">HK$4,500,001 – HK$6,000,000</td><td class="p-3">2.25%</td></tr>
                  <tr><td class="p-3">HK$6,000,001 – HK$9,000,000</td><td class="p-3">3.00%</td></tr>
                  <tr><td class="p-3">HK$9,000,001 – HK$20,000,000</td><td class="p-3">3.75%</td></tr>
                  <tr><td class="p-3">Above HK$21,739,130</td><td class="p-3 font-bold text-primary dark:text-on-primary">4.25%</td></tr>
                </tbody>
              </table>
            </div>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">Tenancy Agreement (Rental Lease) Stamp Duty</h2>
            <p>When renting residential or commercial premises in Hong Kong, the tenancy agreement must be submitted to the Stamp Office for stamping within 30 days of execution. Duty is customarily split 50/50 between landlord and tenant:</p>
            <ul class="list-disc pl-6 space-y-2">
              <li><strong>Lease Term ≤ 1 Year:</strong> 0.25% of total rent payable over the term.</li>
              <li><strong>Lease Term > 1 Year & ≤ 3 Years:</strong> 0.50% of average annual rent (AAR).</li>
              <li><strong>Lease Term > 3 Years:</strong> 1.00% of average annual rent (AAR).</li>
              <li><strong>Counterpart Fee:</strong> HK$5 per duplicate counterpart document.</li>
            </ul>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">Stamping Procedures & Late Payment Penalties</h2>
            <p>Instruments must be stamped within <strong>30 days of execution</strong>. Electronic stamping (e-Stamping) is available online via eTAX for tenancy agreements and property transfers. Late payment incurs strict surcharges:</p>
            <ul class="list-disc pl-6 space-y-2">
              <li>Late by ≤ 1 month: 2 times the duty payable.</li>
              <li>Late by 1–2 months: 4 times the duty payable.</li>
              <li>Late by > 2 months: 10 times the duty payable.</li>
            </ul>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">Frequently Asked Questions</h2>
            {faqSchema.mainEntity.map(faq => (
              <div class="my-4 p-4 rounded-xl border border-hairline bg-canvas dark:border-overlay-lighter dark:bg-surface">
                <h3 class="text-lg font-bold text-ink dark:text-on-primary">{faq.name}</h3>
                <p class="text-sm text-body dark:text-muted mt-1 leading-relaxed">{faq.acceptedAnswer.text}</p>
              </div>
            ))}
          </div>

          <!-- Internal Resource Linking Grid -->
          <div class="mt-12 pt-8 border-t border-hairline dark:border-overlay-lighter">
            <h2 class="text-2xl font-semibold text-ink mb-6 dark:text-on-primary">Hong Kong Tax Tools & Related Guides</h2>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              <a href="/countries/hong-kong/stamp-duty/hk-property-stamp-duty-calculator" class="block rounded-xl border border-hairline p-4 hover:border-primary transition bg-canvas dark:bg-surface dark:border-overlay-lighter">
                <h3 class="font-bold text-ink dark:text-on-primary text-sm">HK Stamp Duty Calculator</h3>
                <p class="text-xs text-muted mt-1">Calculate Scale 2 AVD & lease stamping fees.</p>
              </a>
              <a href="/blogs/hong-kong-property-tax-guide" class="block rounded-xl border border-hairline p-4 hover:border-primary transition bg-canvas dark:bg-surface dark:border-overlay-lighter">
                <h3 class="font-bold text-ink dark:text-on-primary text-sm">Hong Kong Property Tax Guide</h3>
                <p class="text-xs text-muted mt-1">15% standard rate on rental income.</p>
              </a>
              <a href="/blogs/hong-kong-rental-income-tax-guide" class="block rounded-xl border border-hairline p-4 hover:border-primary transition bg-canvas dark:bg-surface dark:border-overlay-lighter">
                <h3 class="font-bold text-ink dark:text-on-primary text-sm">Rental Income Tax Guide</h3>
                <p class="text-xs text-muted mt-1">Landlord statutory deductions & NAV.</p>
              </a>
              <a href="/blogs/hong-kong-salaries-tax-guide" class="block rounded-xl border border-hairline p-4 hover:border-primary transition bg-canvas dark:bg-surface dark:border-overlay-lighter">
                <h3 class="font-bold text-ink dark:text-on-primary text-sm">Hong Kong Salaries Tax Guide</h3>
                <p class="text-xs text-muted mt-1">Progressive brackets (2%-17%) & MPF rules.</p>
              </a>
              <a href="/blogs/hong-kong-etax-guide" class="block rounded-xl border border-hairline p-4 hover:border-primary transition bg-canvas dark:bg-surface dark:border-overlay-lighter">
                <h3 class="font-bold text-ink dark:text-on-primary text-sm">Hong Kong eTAX Guide</h3>
                <p class="text-xs text-muted mt-1">Online e-Stamping & tax filing portal.</p>
              </a>
              <a href="/blogs/hong-kong-car-tax-guide" class="block rounded-xl border border-hairline p-4 hover:border-primary transition bg-canvas dark:bg-surface dark:border-overlay-lighter">
                <h3 class="font-bold text-ink dark:text-on-primary text-sm">Hong Kong Car Tax Guide</h3>
                <p class="text-xs text-muted mt-1">First Registration Tax & EV concessions.</p>
              </a>
            </div>
          </div>

          <h2 class="text-2xl font-semibold text-ink mt-12 mb-6 dark:text-on-primary">Official Authorities & References</h2>
          <ul class="list-disc pl-6 space-y-2 text-body dark:text-muted">
            <li><a href="https://www.ird.gov.hk" target="_blank" rel="noopener noreferrer" class="text-link hover:underline dark:text-link">Inland Revenue Department (IRD) - Stamp Office Guidance</a></li>
            <li><a href="https://www.gov.hk" target="_blank" rel="noopener noreferrer" class="text-link hover:underline dark:text-link">Hong Kong Government e-Stamping Portal</a></li>
          </ul>
        </article>
      </div>
    </main>
  </div>
</BlogLayout>
