  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the Ad Valorem Stamp Duty (AVD) rate in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For Hong Kong Permanent Residents purchasing their sole residential property, Scale 2 AVD rates apply, starting at a flat HK$100 for properties up to HK$3 million, rising progressively to 1.5%, 2.25%, 3%, 3.75%, up to a maximum cap of 4.25% for properties valued above HK$21.73 million."
      }
    },
    {
      "@type": "Question",
      "name": "What is Buyer's Stamp Duty (BSD) in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Buyer's Stamp Duty (BSD) was introduced for non-Hong Kong permanent residents and corporate purchasers. Following recent government budget updates, BSD and Special Stamp Duty (SSD) demand-management cooling measures have been lifted to stimulate property transactions."
      }
    },
    {
      "@type": "Question",
      "name": "How is stamp duty calculated on rental tenancy agreements in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rental lease stamp duty (stamping of tenancy agreement) is calculated on average annual rent: 0.25% for leases under 1 year, 0.5% for leases between 1 and 3 years, and 1% for leases exceeding 3 years, plus HK$5 for duplicate counterparts."
      }
    },
    {
      "@type": "Question",
      "name": "When must Hong Kong stamp duty be paid to the IRD?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Stamp duty must be paid within 30 days after the execution of the sale and purchase agreement or tenancy lease document. Late payment incurs statutory penalties up to 10 times the duty owed."
      }
    }
  ]
};
