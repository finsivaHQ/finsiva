---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "Pakistan Vehicle Token Tax Guide 2026: Online Rates & ePay Payment";
const description = "Complete guide to vehicle token tax in Pakistan. Learn online token tax payment for Islamabad, Lahore (Punjab), Sindh, and KPK via ePay Punjab, City Islamabad App, and PSID generation.";
const image = "https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=1200&q=80";
const canonical = "https://finsiva.com/blogs/pakistan-token-tax-guide";
const author = "Sana Chaudhry";
const authorBio = "Provincial tax compliance and e-governance analyst specializing in online token tax systems, ePay Punjab, and vehicle registration.";
const lastUpdated = "August 2026";
const readTime = "14 min read";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I pay car token tax online in Lahore and Punjab?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Download the ePay Punjab app or visit the Punjab Excise portal, enter your vehicle registration number, generate a 17-digit PSID number, and pay via mobile banking apps or ATMs."
      }
    },
    {
      "@type": "Question",
      "name": "How to pay Islamabad registered vehicle token tax online?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "For Islamabad (ICT) registered vehicles, use the City Islamabad Mobile App or ICT Excise online portal to generate a PSID and pay token tax through 1Bill banking options."
      }
    },
    {
      "@type": "Question",
      "name": "What is the penalty for late token tax payment in Pakistan?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Provincial excise departments impose a monthly penalty ranging from 1% to 100% of the token tax amount for overdue payments beyond the due date."
      }
    },
    {
      "@type": "Question",
      "name": "What discount do Active Tax Filers receive on vehicle token tax?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "FBR active tax filers receive up to 50% discount on advance income tax withheld during annual vehicle token tax payments compared to non-filers."
      }
    }
  ]
};
---

<BlogLayout title={title} description={description} image={image} canonical={canonical} author={author} authorBio={authorBio} lastUpdated={lastUpdated} readTime={readTime}>
  <div class="mt-8 space-y-6 text-body dark:text-muted leading-relaxed">
            <p>
              Paying annual <strong>token tax car lahore</strong>, <strong>online token tax islamabad</strong>, and <strong>online vehicle token tax punjab</strong> has been fully digitalized across Pakistan through provincial e-governance initiatives.
            </p>
            <p>
              Motor vehicle owners can now compute, verify, and pay their <strong>islamabad registered vehicle token tax</strong> or <strong>lahore token tax rate</strong> online without visiting physical Excise & Taxation offices in Multan, Rawalpindi, Faisalabad, or Karachi.
            </p>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">1. How to Pay Online Token Tax in Punjab (ePay Punjab)</h2>
            <p>
              For vehicles registered in Punjab (Lahore, Rawalpindi, Multan, Faisalabad, Gujranwala):
            </p>
            <ol class="list-decimal pl-6 space-y-2">
              <li>Download the <strong>ePay Punjab</strong> app or visit <code>excise.punjab.gov.pk</code>.</li>
              <li>Select <em>Excise & Taxation</em> &rarr; <em>Motor Vehicle Tax</em>.</li>
              <li>Enter your vehicle registration number (e.g., <code>LEA-20-1234</code>).</li>
              <li>The portal calculates annual token tax, provincial levies, and FBR advance withholding tax based on your active tax filer status.</li>
              <li>Generate a 17-digit <strong>PSID number</strong> and pay via 1Bill on JazzCash, EasyPaisa, or any mobile banking app.</li>
            </ol>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">2. How to Pay Islamabad Registered Vehicle Token Tax</h2>
            <p>
              For vehicles registered in Islamabad Capital Territory (ICT):
            </p>
            <ol class="list-decimal pl-6 space-y-2">
              <li>Open the <strong>City Islamabad App</strong> or visit <code>islamabadexcise.gov.pk</code>.</li>
              <li>Enter your ICT vehicle registration number and chassis details.</li>
              <li>Generate the PSID and pay online via credit card or interbank 1Bill payment.</li>
              <li>Receive an instant digital Smart Card status update and e-receipt.</li>
            </ol>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">3. FBR Filer Discount on Vehicle Token Tax</h2>
            <p>
              Annual token tax bills include an advance income tax component levied under Section 234 of the Income Tax Ordinance. Active tax filers appearing on the FBR Active Taxpayer List (ATL) receive a <strong>50% discount</strong> on the advance withholding tax portion.
            </p>
            <p>
              Calculate your exact token tax dues on our <a href="/countries/pakistan/vehicle-tax/vehicle-tax-calculator" class="text-link hover:underline">Vehicle Token Tax Calculator</a>, read our <a href="/blogs/pakistan-vehicle-tax-guide" class="text-link hover:underline">Pakistan Vehicle Tax Guide</a>, or visit the main <a href="/knowledge/pakistan-income-tax" class="text-link hover:underline">Pakistan Income Tax Knowledge Hub</a>.
            </p>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">Frequently Asked Questions</h2>
          </div>

          <div class="mt-8 space-y-4">
            {faqSchema.mainEntity.map(faq => (
              <div class="rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
                <h3 class="text-lg font-semibold text-ink dark:text-on-primary">{faq.name}</h3>
                <p class="mt-2 text-sm text-body dark:text-muted leading-relaxed">{faq.acceptedAnswer.text}</p>
              </div>
            ))}
          </div>

          <div class="mt-12 p-6 rounded-2xl bg-canvas-soft border border-hairline dark:border-overlay-lighter dark:bg-surface">
            <h3 class="text-xl font-bold text-ink dark:text-on-primary">About the Author</h3>
            <p class="mt-2 text-sm font-semibold text-primary dark:text-on-primary">{author}</p>
            <p class="mt-1 text-sm text-body dark:text-muted">{authorBio}</p>
  </div>
</BlogLayout>
