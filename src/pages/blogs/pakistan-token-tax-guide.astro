const description = "Pakistan token tax guide. Learn vehicle token tax rates by province, property token tax, transfer fees, and use our token tax calculator for Islamabad, Sindh, Punjab, and KPK.";
const image = "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=1200&q=80";
const canonical = "https://finsiva.com/blogs/pakistan-token-tax-guide";
const author = "Hassan Raza";
const authorBio = "Excise and taxation expert covering provincial token tax systems across Pakistan.";
const lastUpdated = "August 2026";
const readTime = "9 min read";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How is vehicle token tax calculated in Pakistan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Vehicle token tax is calculated based on engine displacement (CC), provincial excise schedules, vehicle age, and FBR active taxpayer status (filers pay 50% lower withholding tax than non-filers)."
      }
    },
    {
      "@type": "Question",
      "name": "What is lifetime token tax in Pakistan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lifetime token tax is a single one-time payment option (e.g. PKR 20,000 for vehicles up to 1000cc in Punjab and Sindh) that exempts the vehicle from annual token tax payments forever."
      }
    },
    {
      "@type": "Question",
      "name": "How can I pay vehicle token tax online in Punjab and Sindh?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Vehicle token tax can be paid online by generating a PSID on ePay Punjab or e-Payment GOS (Sindh) and paying via mobile banking, ATM, or digital wallets."
      }
    }
  ]
};
---

<BlogLayout title={title} description={description} image={image} canonical={canonical} author={author} authorBio={authorBio} lastUpdated={lastUpdated} readTime={readTime}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="min-h-screen bg-canvas dark:bg-canvas">
    <main class="min-h-screen">
