const authorBio = "Senior International Tax Specialist focusing on Singapore expat tax planning, Employment Pass & ONE Pass tax structuring, Form IR21 clearance, and foreign mobility advisory.";
const canonical = "https://finsiva.com/blogs/singapore-expat-employment-pass-tax-calculator-guide";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How are Employment Pass (EP) holders taxed in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Employment Pass (EP) holders who reside or work in Singapore for 183 days or more in a calendar year qualify as tax residents. They are taxed at progressive resident rates (0% to 24%) and can claim personal reliefs (such as Earned Income Relief and SRS contributions). If employed between 61 and 182 days, they are taxed as non-residents at a flat rate of 15% on employment income or resident rates without reliefs, whichever yields higher tax."
      }
    },
    {
      "@type": "Question",
      name: "Do foreign EP holders pay CPF in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Employment Pass (EP), S Pass, and Work Permit holders are exempt from mandatory Central Provident Fund (CPF) contributions. Therefore, no CPF is deducted from an expat's monthly salary, resulting in higher immediate cash take-home pay."
      }
    },
    {
      "@type": "Question",
      name: "What is Form IR21 tax clearance for expats leaving Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Form IR21 is a mandatory IRAS tax clearance notification filed by employers when a foreign employee terminates employment, transfers overseas, or plans to leave Singapore for more than 3 months. The employer must withhold all payments (including last month's salary and bonus) until IRAS issues a Clearance Directive."
      }
    },
    {
      "@type": "Question",
      name: "Can foreign expats open an SRS account to save taxes in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes! Foreign expats can participate in the Supplementary Retirement Scheme (SRS) and contribute up to S$35,700 per year (significantly higher than the S$15,300 cap for citizens/PRs), enjoying dollar-for-dollar tax deductions on their taxable income."
      }
    }
  ]
};
