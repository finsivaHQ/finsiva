const description = "Calculate Singapore income tax for EP, S Pass, and Work Permit holders. Learn 183-day tax residency rules, 15% non-resident flat rates, SRS deductions, and Form IR21 clearance.";
const image = "https://images.unsplash.com/photo-1526304640581-d334cdbbf45e?w=1200&q=80";
