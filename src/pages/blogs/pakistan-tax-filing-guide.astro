---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "Pakistan FBR Tax Filing Guide 2026: IRIS Portal, Deadlines & ATL";
const description = "Complete step-by-step guide to online tax filing in Pakistan via FBR IRIS portal. Learn NTN registration, income tax filing deadline, ATL benefits, Befiler/Softax services, and amnesty schemes.";
const image = "https://images.unsplash.com/photo-1450133064473-71024230f91b?w=1200&q=80";
const canonical = "https://finsiva.com/blogs/pakistan-tax-filing-guide";
const author = "Ayesha Malik";
const authorBio = "Chartered accountant specializing in FBR IRIS tax return filing, tax advisory, and corporate tax compliance in Lahore and Karachi.";
const lastUpdated = "August 2026";
const readTime = "16 min read";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the official income tax filing deadline in Pakistan for 2026?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The statutory tax filing deadline for individuals and salaried workers in Pakistan is September 30 following the close of the tax year on June 30. However, the FBR occasionally extends this deadline through official notifications if circumstances demand it."
      }
    },
    {
      "@type": "Question",
      "name": "How do I register for a National Tax Number (NTN) on FBR IRIS?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "You can obtain an NTN by registering online at the FBR IRIS portal (iris.fbr.gov.pk) using your CNIC/NICOP, a mobile number registered in your own name, and an active email address. The system will guide you through SMS and email OTP verifications."
      }
    },
    {
      "@type": "Question",
      "name": "What are the benefits of filing a tax return and appearing on the Active Taxpayer List (ATL)?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Active tax filers on the ATL enjoy up to a 50% discount on withholding taxes for property purchases, vehicle token payments, bank cash withdrawals, and dividend payouts. Non-filers are subjected to punitive tax rates."
      }
    },
    {
      "@type": "Question",
      "name": "What tax advisory and filing services exist in Pakistan (Befiler, Softax, HQ Tax)?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Taxpayers can file directly on FBR IRIS for free or utilize certified tax consultant firms and digital platforms such as Befiler, Softax Karachi, or HQ Tax & Financial Inc Lahore for guided, error-free filing and audit representation."
      }
    },
    {
      "@type": "Question",
      "name": "What is a Tax Amnesty Scheme in Pakistan?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "A Tax Amnesty Scheme is a statutory asset declaration program periodically announced by the government. It allows citizens to declare previously undisclosed domestic or foreign assets by paying a concessional flat tax rate, thereby avoiding penalties and prosecution."
      }
    }
  ]
};
