---
import BlogLayout from "../../layouts/BlogLayout.astro";
import StickyToc from "../../components/StickyToc.astro";

const title = "Hong Kong Net Salary & Take-Home Pay Guide 2026/27: Calculate Salary After Tax";
const description = "Learn how to calculate your Hong Kong net salary and monthly take-home pay after MPF contributions and IRD salaries tax. Includes gross to net salary formulas, tax tables, and calculator.";
const image = "https://images.unsplash.com/photo-1559526324-4b87b5e36e44?w=1200&q=80";
const canonical = "https://finsiva.com/blogs/hong-kong-net-salary-take-home-pay-guide";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How is Hong Kong net salary calculated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hong Kong net salary is calculated by taking your gross annual salary, subtracting mandatory MPF employee contributions (5% capped at HK$1,500/month or HK$18,000/year), and subtracting your estimated annual HK Salaries Tax payable."
      }
    },
    {
      "@type": "Question",
      "name": "What percentage of salary is deducted for MPF in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Employees contribute 5% of their monthly relevant income to MPF, provided their monthly income is HK$7,100 or more. The maximum mandatory contribution is HK$1,500 per month (HK$18,000 per year)."
      }
    },
    {
      "@type": "Question",
      "name": "Is MPF deducted before or after calculating Salaries Tax?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mandatory MPF contributions are deducted from your gross income BEFORE calculating your assessable income for Salaries Tax, reducing your overall tax burden."
      }
    },
    {
      "@type": "Question",
      "name": "What is the average take-home pay ratio in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Because Hong Kong tax rates are low (effective rates between 0% and 15%), most employees take home 85% to 95% of their gross salary after tax and MPF deductions."
      }
    },
    {
      "@type": "Question",
      "name": "How does housing allowance affect net take-home salary in HK?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If structured as rental reimbursement, housing allowance is taxed at a concessionary 10% rental value rate rather than full gross salary, significantly increasing your net after-tax take-home pay."
      }
    }
  ]
};
---

<BlogLayout robots="noindex, follow" 
  title={title} 
  description={description} 
  image={image} 
  canonical={canonical}
  author="Jessica Liu, CPA" 
  authorBio="Jessica Liu is a Certified Public Accountant specializing in Hong Kong employment compensation, MPF deductions, and net salary optimization." 
  lastUpdated="August 2026" 
  readTime="12 min read"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="space-y-8 text-body dark:text-muted leading-relaxed">
            <section>
              <h2 class="text-2xl font-bold text-ink dark:text-on-primary mb-4">Understanding Gross vs Net Salary in Hong Kong</h2>
              <p>
                When negotiating job offers or budgeting monthly living expenses in Hong Kong, understanding your <strong>Net Take-Home Salary</strong> (salary after tax and mandatory deductions) is crucial. Unlike countries with monthly pay-as-you-earn (PAYE) tax withholding, Hong Kong employers pay gross salary monthly without withholding Salaries Tax. Tax is billed annually directly by the Inland Revenue Department (IRD).
              </p>
              <p class="mt-3">
                However, mandatory <strong>MPF (Mandatory Provident Fund)</strong> contributions of 5% (capped at HK$1,500/month) ARE deducted directly from your monthly paycheck by your employer.
              </p>
            </section>

            <section>
              <h2 class="text-2xl font-bold text-ink dark:text-on-primary mb-4">Hong Kong Net Take-Home Salary Formula</h2>
              <div class="my-6 p-6 rounded-2xl border border-hairline bg-canvas-soft dark:border-overlay-lighter dark:bg-surface">
                <p class="font-mono text-sm sm:text-base font-bold text-primary dark:text-on-primary leading-relaxed">
                  Monthly Gross Salary = Base Salary + Monthly Allowances<br/>
                  Monthly MPF Employee Deduction = MIN( 5% × Gross Salary, HK$1,500 )<br/>
                  Monthly Cash Paycheck = Monthly Gross Salary − Monthly MPF Deduction<br/><br/>
                  Net Take-Home Pay = Annual Gross Salary − MPF Contributions − HK Salaries Tax
                </p>
              </div>
            </section>

            <section>
              <h2 class="text-2xl font-bold text-ink dark:text-on-primary mb-4">Monthly Net Take-Home Pay Reference Table (2026/27)</h2>
              <p>
                The table below illustrates monthly take-home salary for a single taxpayer in Hong Kong receiving standard basic allowance (HK$132,000):
              </p>

              <div class="my-6 overflow-x-auto rounded-xl border border-hairline bg-canvas dark:border-overlay-lighter dark:bg-surface">
                <table class="w-full text-left text-sm">
                  <thead class="bg-canvas-soft border-b border-hairline dark:bg-surface/80 dark:border-overlay-lighter text-ink dark:text-on-primary">
                    <tr>
                      <th class="p-3.5 font-bold">Gross Monthly Salary</th>
                      <th class="p-3.5 font-bold">Monthly MPF (5%)</th>
                      <th class="p-3.5 font-bold">Est. Monthly Tax</th>
                      <th class="p-3.5 font-bold">Est. Monthly Net Take-Home</th>
                      <th class="p-3.5 font-bold">Take-Home %</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-hairline dark:divide-overlay-lighter">
                    <tr>
                      <td class="p-3.5 font-semibold">HK$20,000/mo (HK$240k/yr)</td>
                      <td class="p-3.5">HK$1,000</td>
                      <td class="p-3.5 font-medium text-emerald-600 dark:text-emerald-400">HK$317</td>
                      <td class="p-3.5 font-bold text-primary dark:text-on-primary">HK$18,683</td>
                      <td class="p-3.5 font-bold">93.4%</td>
                    </tr>
                    <tr>
                      <td class="p-3.5 font-semibold">HK$30,000/mo (HK$360k/yr)</td>
                      <td class="p-3.5">HK$1,500</td>
                      <td class="p-3.5 font-medium text-emerald-600 dark:text-emerald-400">HK$1,475</td>
                      <td class="p-3.5 font-bold text-primary dark:text-on-primary">HK$27,025</td>
                      <td class="p-3.5 font-bold">90.1%</td>
                    </tr>
                    <tr>
                      <td class="p-3.5 font-semibold">HK$50,000/mo (HK$600k/yr)</td>
                      <td class="p-3.5">HK$1,500</td>
                      <td class="p-3.5 font-medium text-emerald-600 dark:text-emerald-400">HK$4,508</td>
                      <td class="p-3.5 font-bold text-primary dark:text-on-primary">HK$43,992</td>
                      <td class="p-3.5 font-bold">88.0%</td>
                    </tr>
                    <tr>
                      <td class="p-3.5 font-semibold">HK$80,000/mo (HK$960k/yr)</td>
                      <td class="p-3.5">HK$1,500</td>
                      <td class="p-3.5 font-medium text-emerald-600 dark:text-emerald-400">HK$8,758</td>
                      <td class="p-3.5 font-bold text-primary dark:text-on-primary">HK$69,742</td>
                      <td class="p-3.5 font-bold">87.2%</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </section>

            <!-- FAQs -->
            <section>
              <h2 class="text-2xl font-bold text-ink dark:text-on-primary mb-6">Frequently Asked Questions</h2>
              <div class="space-y-4">
                {faqSchema.mainEntity.map(faq => (
                  <div class="rounded-xl border border-hairline bg-canvas p-5 dark:border-overlay-lighter dark:bg-surface">
                    <h3 class="text-base font-bold text-ink dark:text-on-primary">{faq.name}</h3>
                    <p class="text-sm text-body dark:text-muted mt-2 leading-relaxed">{faq.acceptedAnswer.text}</p>
                  </div>
                ))}
              </div>
            </section>
<!-- Calculator Launch Banner -->
          <div class="my-12 rounded-2xl border border-hairline bg-canvas-soft p-8 dark:border-overlay-lighter dark:bg-surface text-center shadow-sm">
            <h3 class="text-2xl font-bold text-ink dark:text-on-primary mb-2">Calculate Your Net Salary Now</h3>
            <p class="text-body dark:text-muted max-w-2xl mx-auto mb-6">
              Use our interactive online calculator to see your exact net monthly take-home salary after tax and MPF deductions.
            </p>
            <a 
              href="/countries/hong-kong/salaries-tax/hk-net-salary-calculator"
