const title = "Singapore Capital Gains, Dividends & Foreign Income Tax Guide 2026";
const description = "Complete guide to Singapore 0% capital gains tax, single-tier dividend tax exemption, foreign-sourced income remitted to Singapore (Section 13(6)), and interest income taxation.";
const image = "https://images.unsplash.com/photo-1590283603385-17ffb3a7f29f?w=1200&q=80";
