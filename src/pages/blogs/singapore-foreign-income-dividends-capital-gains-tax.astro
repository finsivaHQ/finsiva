const canonical = "https://finsiva.com/blogs/singapore-foreign-income-dividends-capital-gains-tax";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is there capital gains tax in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Singapore does not levy capital gains tax on profits derived from the sale of stocks, cryptocurrencies, bonds, or real estate (provided the owner is not deemed to be trading as a business)."
      }
    },
    {
      "@type": "Question",
      name: "Are foreign dividends taxable when received in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Foreign-sourced dividends remitted into Singapore by resident individuals are generally exempt from income tax. For corporate entities, Section 13(6) provides tax exemption if tax rate and headline conditions are met."
      }
    },
    {
      "@type": "Question",
      name: "Is fixed deposit interest taxable in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Interest derived by individuals from deposits with approved banks and finance companies in Singapore is exempt from personal income tax."
      }
    },
    {
      "@type": "Question",
      name: "How does IRAS determine if a gain is capital or trading income?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "IRAS uses the 'Badges of Trade' test, analyzing the frequency of transactions, holding period, motive for purchase, financing methods, and circumstances of the sale to determine if a gain is a non-taxable capital gain or taxable trading income."
      }
    },
    {
      "@type": "Question",
      name: "What are the Section 13(6) conditions for foreign income exemption?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The income must be subject to tax in the foreign jurisdiction, the highest corporate tax rate in that foreign country must be at least 15%, and the Comptroller must be satisfied the exemption is beneficial to the Singapore resident company."
      }
    }
  ]
};
---

<BlogLayout
  title={title}
  description={description}
  image={image}
