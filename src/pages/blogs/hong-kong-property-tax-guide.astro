const title = "Hong Kong Property Tax Guide: Rates, Deductions & Calculation";
const description = "Hong Kong property tax guide for property owners and landlords. Understand 15% standard rate on Net Assessable Value, 20% statutory repair allowance, and filing.";
const image = "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=1200&q=80";
const canonical = "https://finsiva.com/blogs/hong-kong-property-tax-guide";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the property tax rate in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The standard Property Tax rate in Hong Kong is 15% on the Net Assessable Value (NAV) of land or buildings. NAV is computed as gross rental income minus rates paid by the owner, minus a statutory 20% allowance for repairs and outgoings."
      }
    },
    {
      "@type": "Question",
      "name": "Who is liable to pay Hong Kong property tax?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Property tax is payable by the registered owner (or co-owners) of land or buildings situated in Hong Kong who derive rental income from the property."
      }
    },
    {
      "@type": "Question",
      "name": "Do I pay property tax if my flat is empty?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Property tax is assessed on actual rental income received or receivable. If the property remains vacant for the full year of assessment, no property tax is payable, but you must still declare it."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between Property Tax and Stamp Duty?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Property Tax is an annual tax on ongoing rental income. Stamp Duty is a one-time transaction tax paid on property purchases or lease agreements."
      }
    },
    {
      "@type": "Question",
      "name": "How can I file property tax online in Hong Kong?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Property owners can complete and submit Property Tax Returns electronically via the IRD eTAX portal, receiving an automatic 1-month filing extension."
      }
    },
    {
      "@type": "Question",
      "name": "Can I deduct my actual repair costs if they exceed the 20% allowance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Under the standard Property Tax assessment, the 20% statutory allowance is a fixed flat rate. You cannot claim actual expenses for repairs, management fees, or insurance, even if they exceed 20% of the assessable value."
      }
    },
    {
      "@type": "Question",
      "name": "Can I deduct mortgage interest from Property Tax?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under a standard Property Tax assessment, mortgage interest is not deductible. However, if you are an individual owner, you can elect Personal Assessment, which allows you to deduct mortgage interest paid on the rental property from your total assessable income."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if my tenant defaults on rent?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can claim a deduction for 'irrecoverable rent' in the year it proved to be irrecoverable. If you later recover this rent, it must be reported as income in the year of recovery."
      }
    },
    {
      "@type": "Question",
      "name": "How is Provisional Property Tax calculated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Provisional Property Tax is an estimated tax for the upcoming year, typically based on the Net Assessable Value of the preceding year. It is billed together with your final tax for the current year."
      }
    },
    {
      "@type": "Question",
      "name": "Can I apply for a holdover of Provisional Property Tax?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. If your rental income is expected to drop by more than 10% compared to the previous year (e.g., due to a vacant period or lower rent), or if you sold the property, you can apply in writing to the IRD for a holdover of the provisional tax."
      }
    }
  ]
};
