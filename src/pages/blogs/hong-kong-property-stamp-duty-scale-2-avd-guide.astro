---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "HK Property Stamp Duty: Scale 2 AVD Rates & Rules (2026)";
const description = "Complete 2026 guide to Hong Kong property stamp duty. Understand Scale 2 AVD rates, abolition of BSD & SSD cooling measures, and marginal tax relief.";
const image = "https://images.unsplash.com/photo-1506973035872-a4ec16b8e8d9?w=1200&q=80";
const author = "Kenneth Wong, Senior Real Estate Tax Specialist";
const authorBio = "Senior Hong Kong Property Tax Advisor and Chartered Valuation Surveyor advising homeowners, international expatriates, and institutional real estate funds on Stamp Duty Ordinance compliance.";
const canonical = "https://finsiva.com/blogs/hong-kong-property-stamp-duty-scale-2-avd-guide/";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What are the current property stamp duty rates in Hong Kong?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Following the abolition of property cooling measures, all residential property transactions in Hong Kong are taxed under Scale 2 Ad Valorem Stamp Duty (AVD). Rates start at a flat HK$100 for properties valued up to HK$3 million, progressing in tiers up to 4.25% for properties exceeding HK$21,739,120."
      }
    },
    {
      "@type": "Question",
      name: "Do foreigners still pay Buyer's Stamp Duty (BSD) in Hong Kong?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. The Hong Kong government officially abolished Buyer's Stamp Duty (BSD), New Residential Stamp Duty (NRSD), and Special Stamp Duty (SSD). Non-permanent residents and foreign corporate buyers now pay the same standard Scale 2 AVD rates as Hong Kong permanent residents."
      }
    },
    {
      "@type": "Question",
      name: "What is marginal relief in Hong Kong property stamp duty?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Marginal relief prevents sharp tax spikes at the threshold boundaries between rate bands. Taxpayers are charged the tax payable on the lower band plus a percentage (typically 10%) of the excess consideration above that band limit."
      }
    },
    {
      "@type": "Question",
      name: "When must property stamp duty be paid to the IRD?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Under the Stamp Duty Ordinance, stamp duty on residential property transactions must be paid to the Stamp Office of the Inland Revenue Department within 30 days of executing the formal Sale and Purchase Agreement."
      }
    }
  ]
};
