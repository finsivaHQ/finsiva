          <td class="py-3.5 px-4 text-muted">5 Years</td>
          <td class="py-3.5 px-4 font-medium">$52,000</td>
          <td class="py-3.5 px-4 font-medium text-emerald-600 dark:text-emerald-400">$18,480</td>
          <td class="py-3.5 px-4 font-bold text-ink dark:text-on-primary">$70,480</td>
          <td class="py-3.5 px-4 text-xs">26.2%</td>
        </tr>
        <tr>
          <td class="py-3.5 px-4 font-bold">Age 40</td>
          <td class="py-3.5 px-4 text-muted">10 Years</td>
          <td class="py-3.5 px-4 font-medium">$94,000</td>
          <td class="py-3.5 px-4 font-medium text-emerald-600 dark:text-emerald-400">$75,230</td>
          <td class="py-3.5 px-4 font-bold text-ink dark:text-on-primary">$169,230</td>
          <td class="py-3.5 px-4 text-xs">44.5%</td>
        </tr>
        <tr>
          <td class="py-3.5 px-4 font-bold">Age 45</td>
          <td class="py-3.5 px-4 text-muted">15 Years</td>
          <td class="py-3.5 px-4 font-medium">$136,000</td>
          <td class="py-3.5 px-4 font-semibold text-emerald-600 dark:text-emerald-400">$196,120</td>
          <td class="py-3.5 px-4 font-bold text-ink dark:text-on-primary">$332,120</td>
          <td class="py-3.5 px-4 text-xs font-semibold text-emerald-600">59.0% (Tipping Point)</td>
        </tr>
        <tr>
          <td class="py-3.5 px-4 font-bold">Age 50</td>
          <td class="py-3.5 px-4 text-muted">20 Years</td>
          <td class="py-3.5 px-4 font-medium">$178,000</td>
          <td class="py-3.5 px-4 font-semibold text-emerald-600 dark:text-emerald-400">$421,800</td>
          <td class="py-3.5 px-4 font-bold text-ink dark:text-on-primary">$599,800</td>
          <td class="py-3.5 px-4 text-xs">70.3%</td>
        </tr>
        <tr>
          <td class="py-3.5 px-4 font-bold">Age 55</td>
          <td class="py-3.5 px-4 text-muted">25 Years</td>
          <td class="py-3.5 px-4 font-medium">$220,000</td>
          <td class="py-3.5 px-4 font-semibold text-emerald-600 dark:text-emerald-400">$820,950</td>
          <td class="py-3.5 px-4 font-bold text-ink dark:text-on-primary">$1,040,950</td>
          <td class="py-3.5 px-4 text-xs">78.9%</td>
        </tr>
        <tr>
          <td class="py-3.5 px-4 font-bold">Age 60</td>
          <td class="py-3.5 px-4 text-muted">30 Years</td>
          <td class="py-3.5 px-4 font-medium">$262,000</td>
          <td class="py-3.5 px-4 font-bold text-emerald-600 dark:text-emerald-400">$1,505,800</td>
          <td class="py-3.5 px-4 font-extrabold text-ink dark:text-on-primary">$1,767,800</td>
          <td class="py-3.5 px-4 text-xs font-bold text-emerald-600">85.2%</td>
        </tr>
        <tr class="bg-primary/5">
          <td class="py-3.5 px-4 font-black text-primary">Age 65</td>
          <td class="py-3.5 px-4 text-muted">35 Years (Retirement)</td>
          <td class="py-3.5 px-4 font-bold">$304,000</td>
          <td class="py-3.5 px-4 font-black text-emerald-600 dark:text-emerald-400">$2,658,400</td>
          <td class="py-3.5 px-4 font-black text-ink dark:text-on-primary text-base">$2,962,400</td>
