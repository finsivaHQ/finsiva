const canonical = "https://finsiva.com/blogs/singapore-tax-for-foreigners-expats-guide";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How much tax do foreigners pay in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Foreigners who are tax residents (183+ days) pay progressive rates from 0% to 24% with personal reliefs. Non-residents (61-182 days) pay a flat 15% on employment income or progressive resident rates without reliefs, whichever is higher."
      }
    },
    {
      "@type": "Question",
      name: "Do Malaysians working in Singapore pay income tax?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Malaysians who earn employment income in Singapore are subject to Singapore income tax. If they qualify as tax residents (183+ days), they are taxed at progressive resident rates."
      }
    },
    {
      "@type": "Question",
      name: "What is Form IR21 tax clearance for foreigners?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Form IR21 is a mandatory notification submitted by employers to IRAS when a foreign employee terminates employment or prepares to leave Singapore. The employer withholds payments until tax clearance is issued."
      }
    },
    {
      "@type": "Question",
      name: "What is the 60-day rule for foreigners working in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Foreigners who exercise employment in Singapore for 60 days or less in a calendar year are exempt from tax on their employment income (excluding directors and entertainers)."
      }
    }
  ]
};
