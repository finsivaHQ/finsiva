---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "TDS Rate Chart FY 2025-26: Section 194C, 194J, 194I & Thresholds";
const description = "Complete TDS rate chart for FY 2025-26 (AY 2026-27). Detailed threshold limits and rules for Section 194C (contractors), 194J (professional/technical), 194I (rent), and TRACES filing.";
const image = "https://images.unsplash.com/photo-1450133064473-71024230f91b?w=1200&q=80";
const canonical = "https://finsiva.com/blogs/india-tds-rate-chart-194c-194j-194i-guide/";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the difference between 2% and 10% TDS under Section 194J?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under Section 194J of the Income Tax Act, fees for technical services (FTS), royalty for sale/distribution of cinematographic films, and call center operator payments are subject to a reduced TDS rate of 2%. In contrast, professional fees (such as legal, medical, architectural, accountancy, or consultancy services) and director remuneration remain subject to the standard 10% TDS rate, provided cumulative payments exceed the ₹30,000 annual threshold."
      }
    },
    {
      "@type": "Question",
      "name": "What are the exemption thresholds for contractor TDS under Section 194C?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under Section 194C, TDS is not applicable if a single contract payment does not exceed ₹30,000, or if aggregate payments to the contractor do not exceed ₹1,00,000 in a financial year. Once either threshold is crossed, tax must be deducted at 1% for individual/HUF payees and 2% for corporate/partnership entities."
      }
    },
    {
      "@type": "Question",
      "name": "What is the annual rent threshold for TDS under Section 194I?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under Section 194I, any business or individual subject to tax audit must deduct TDS on commercial or residential rent if the total rent paid or payable exceeds ₹2,40,000 per financial year. The applicable rate is 2% for the lease of plant, machinery, or equipment, and 10% for the lease of land, buildings, or furniture."
      }
    },
    {
      "@type": "Question",
      "name": "What are the penalties for late deduction versus late deposit of TDS under Section 201(1A)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under Section 201(1A), failure to deduct TDS at source incurs simple interest at 1% per month (or part of a month) from the date tax was deductible to the date of actual deduction. Failure to deposit deducted TDS to the government by the 7th of the following month incurs higher interest of 1.5% per month from the date of deduction to the date of actual payment."
      }
    },
    {
      "@type": "Question",
      "name": "How does Section 206AB penalize non-filers of income tax returns?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Section 206AB mandates higher TDS rates for 'specified persons' who failed to file their Income Tax Return for the assessment year preceding the financial year and had aggregate TDS/TCS of ₹50,000 or more. The applicable withholding rate is the higher of: twice the statutory rate, twice the rate in force, or a flat 5%."
      }
    }
  ]
};
