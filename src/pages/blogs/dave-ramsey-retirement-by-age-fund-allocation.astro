    ))}
  </div>

  <!-- Bottom Final Action Box -->
  <div class="mt-12 rounded-2xl border border-primary/20 bg-canvas-soft dark:bg-surface/50 p-6 sm:p-8 text-center space-y-4">
    <h3 class="text-2xl font-bold text-ink dark:text-on-primary">
      Ready to Put the Math to Work?
    </h3>
    <p class="text-sm text-body dark:text-muted max-w-xl mx-auto">
      Whether you are 25 or 55, understanding your compounding horizon is the first step toward financial peace. Launch our free calculator to see your custom roadmap today.
    </p>
    <div class="pt-2 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/dave-ramsey-retirement-calculator/"
        class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3.5 text-sm font-bold text-on-primary shadow hover:bg-primary-hover transition"
      >
        <span>Open Free Dave Ramsey Calculator</span>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
      </a>
      <a
        href="/blogs/dave-ramsey-retirement-calculator-guide/"
        class="inline-flex items-center gap-2 rounded-xl border border-hairline bg-canvas px-6 py-3.5 text-sm font-semibold text-ink hover:bg-canvas-soft dark:border-overlay-lighter dark:bg-surface dark:text-on-primary dark:hover:bg-surface/80 transition"
      >
        <span>Guide 1: 15% Rule & Math</span>
      </a>
      <a
        href="/blogs/dave-ramsey-roth-ira-vs-401k-order/"
        class="inline-flex items-center gap-2 rounded-xl border border-hairline bg-canvas px-6 py-3.5 text-sm font-semibold text-ink hover:bg-canvas-soft dark:border-overlay-lighter dark:bg-surface dark:text-on-primary dark:hover:bg-surface/80 transition"
      >
        <span>Guide 3: Roth IRA vs 401(k) Order</span>
      </a>
