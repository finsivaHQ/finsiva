        <div class="rounded-xl border border-hairline bg-canvas p-5 dark:border-overlay-lighter dark:bg-surface">
          <h3 class="font-bold text-ink dark:text-on-primary text-base mb-2">{faq.name}</h3>
          <p class="text-sm leading-relaxed text-body dark:text-muted">{faq.acceptedAnswer.text}</p>
        </div>
