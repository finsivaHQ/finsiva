---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "Indonesia Digital Nomad Tax: E33G Visa & Remote Worker Guide";
const description = "Complete 2026 tax guide for Bali digital nomads and E33G Remote Worker Visa holders. 183-day rule, foreign client tax exemption, and DJP filing.";
const image = "https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=1200&q=80";
const author = "Dewi Lestari, International Expat Tax Advisory Lead";
const authorBio = "Senior International Tax Specialist advising expatriates, digital nomads in Bali, KITAS holders, and foreign tech founders on Indonesian DJP tax compliance and bilateral DTAs.";
const canonical = "https://finsiva.com/blogs/indonesia-digital-nomad-visa-tax-e33g-guide/";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Do E33G Remote Worker Visa holders pay income tax in Indonesia?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "E33G Remote Worker Visa holders do not pay Indonesian income tax on remote earnings paid by offshore foreign employers, provided they do not conduct commercial business with Indonesian domestic clients or stay in Indonesia beyond 183 days without qualifying for the Omnibus Law expat territorial exemption."
      }
    },
    {
      "@type": "Question",
      name: "What happens if a digital nomad stays in Bali for more than 183 days?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Staying in Indonesia for more than 183 days in any 12-month period classifies a foreigner as a domestic tax resident (Subjek Pajak Dalam Negeri). Tax residents must register for an NPWP tax number and are subject to progressive tax rates (5% to 35%) on global income unless exempt."
      }
    },
    {
      "@type": "Question",
      name: "Can digital nomads work for Indonesian clients on an E33G visa?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. The Indonesian E33G Remote Worker Visa strictly prohibits working for Indonesian companies or generating local domestic income. Doing so violates immigration laws and triggers immediate domestic corporate and personal income tax liabilities."
      }
    },
    {
      "@type": "Question",
      name: "How does the Job Creation Law 4-year territorial tax exemption work?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Under the Job Creation Law (UU Cipta Kerja), qualifying foreign specialists who become tax residents are taxed only on Indonesian-sourced income for their first 4 calendar years, exempting overseas dividends, capital gains, and remote earnings not remitted through domestic exploitation."
      }
    }
  ]
};
---

<BlogLayout
