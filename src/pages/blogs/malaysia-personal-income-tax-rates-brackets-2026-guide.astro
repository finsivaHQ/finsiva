            <td class="p-3 font-bold text-slate-700 dark:text-slate-300">6%</td>
            <td class="p-3">RM 900</td>
            <td class="p-3 font-medium">RM 1,500</td>
          </tr>
          <tr>
            <td class="p-3 font-medium">50,001 – 70,000</td>
            <td class="p-3 font-bold text-slate-700 dark:text-slate-300">11%</td>
