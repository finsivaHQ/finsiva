---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "Malaysia Personal Income Tax Guide 2026: Tax Rates, Brackets, PCB & Net Salary";
const description = "Comprehensive 2026 guide to Malaysia individual income tax. Learn progressive resident tax rates (0% to 30%), chargeable income calculation, PCB deductions, minimum taxable salary, and RM 400 tax rebates.";
const image = "https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?w=1200&q=80";
const author = "Michael Tang, Senior Tax & Corporate Advisory Lead";
const authorBio = "Senior tax consultant specializing in Malaysian Income Tax Act 1967 compliance, LHDNM tax filing, Monthly Tax Deduction (PCB) calculations, and personal tax optimization.";
const canonical = "https://finsiva.com/blogs/malaysia-personal-income-tax-rates-brackets-2026-guide";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What are the individual income tax rates in Malaysia for 2026?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>For Year of Assessment 2026, resident individuals in Malaysia are taxed at progressive rates ranging from 0% to 30% across 11 income tiers. Non-residents pay a flat tax rate of 30% on all Malaysia-sourced employment and trade income.</p>"
      }
    },
    {
      "@type": "Question",
      name: "What is the minimum salary to pay income tax in Malaysia?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>An individual earning a monthly gross salary of around RM 3,050 (or RM 36,600 annually) after mandatory EPF contributions generally falls below the taxable threshold due to the RM 9,000 basic personal tax relief and RM 400 tax rebate for chargeable income up to RM 35,000.</p>"
      }
    },
    {
      "@type": "Question",
      name: "How is Monthly Tax Deduction (PCB / Potongan Cukai Bulanan) calculated in Malaysia?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>PCB is a mandatory monthly tax deduction withheld directly by employers from an employee's salary under Section 107B of the Income Tax Act 1967, based on LHDNM automated tax tables and declared personal reliefs.</p>"
      }
    },
    {
      "@type": "Question",
      name: "What is the difference between Gross Income and Chargeable Income in Malaysia?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>Gross Income includes total salary, bonuses, director fees, and allowances. Chargeable Income equals Gross Income minus allowable tax-exempt allowances and total approved LHDN tax reliefs (such as RM 9,000 personal relief and EPF deductions).</p>"
      }
    },
    {
      "@type": "Question",
      name: "Who qualifies for the RM 400 personal tax rebate in Malaysia?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>Resident individual taxpayers whose annual Chargeable Income does not exceed RM 35,000 are entitled to an automatic personal tax rebate of RM 400 under Section 6A of the Income Tax Act 1967.</p>"
      }
    }
  ]
};
