    {
      "@type": "Question",
      name: "Do freelancers pay income tax in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Freelancers, sole proprietors, private hire drivers, and gig workers are considered self-employed persons by IRAS and must declare their Net Trade Income if gross revenue exceeds S$6,000 or if they have total taxable income exceeding S$22,000."
      }
    },
    {
      "@type": "Question",
      name: "How is Net Trade Income calculated for self-employed persons?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Net Trade Income equals Gross Business Revenue minus allowable business expenses and allowable capital allowances."
      }
    },
    {
      "@type": "Question",
      name: "What is the simplified expense deduction scheme for food delivery drivers and taxi drivers?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "IRAS allows qualifying private hire drivers, taxi drivers, and commission agents to claim a fixed percentage of gross income (e.g., 60% deemed expense for drivers) as business expenses without keeping receipt proof."
      }
    },
    {
      "@type": "Question",
      name: "Do I need to pay CPF as a freelancer in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "While regular CPF contributions are not mandatory for self-employed persons, you are legally required to make mandatory MediSave contributions if your Net Trade Income exceeds S$6,000 in a year."
      }
    },
    {
      "@type": "Question",
      name: "How long must I keep my business receipts and records?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "In Singapore, self-employed persons and businesses must retain their business records, receipts, and accounting documents for at least 5 years from the relevant Year of Assessment."
      }
    }
  ]
};
