import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "Malaysia Foreign Source Income (FSI) Tax Guide 2026: Remittance & Overseas Dividends";
const description = "Comprehensive 2026 guide to Malaysia Foreign-Sourced Income (FSI) taxation. Learn about LHDN remittance rules, 3% gross tax rate, foreign dividend exemptions, statutory conditions, and Double Tax Relief.";
const image = "https://images.unsplash.com/photo-1559526324-4b87b5e36e44?w=1200&q=80";
const author = "Michael Tang, Senior Tax & Corporate Advisory Lead";
const authorBio = "Senior tax consultant specializing in Malaysian foreign-sourced income (FSI) taxation, cross-border remittance planning, Double Taxation Agreements (DTA), and Section 132/133 foreign tax credits.";
const canonical = "https://finsiva.com/blogs/malaysia-foreign-source-income-tax-fsi-2026-guide";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is foreign income received in Malaysia taxable in 2026?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>Foreign-sourced income (FSI) remitted into Malaysia by resident individuals is subject to tax unless specifically exempted under statutory orders (such as the Income Tax Exemption Order for qualifying foreign dividends and employment income meeting economic substance criteria).</p>"
      }
    },
    {
      "@type": "Question",
      name: "Are foreign dividends received by Malaysian residents taxable?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>Foreign dividends remitted into Malaysia by resident individuals and companies are tax-exempt until December 31, 2026, provided the foreign dividend has been subjected to tax in the source country with a headline tax rate of at least 15%.</p>"
      }
    },
    {
      "@type": "Question",
      name: "What is the 3% concessionary tax rate on foreign income remittance in Malaysia?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>During the transitional period announced in Budget updates, LHDN offered a concessionary tax rate of 3% on the gross amount of foreign-sourced income remitted into Malaysia. Post-transitional period, remitted FSI is taxed at prevailing scale rates (up to 30% for individuals and 24% for companies) unless exempt.</p>"
      }
    },
    {
      "@type": "Question",
      name: "How does Double Taxation Agreement (DTA) bilateral credit work for foreign income in Malaysia?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>Under Section 132 and Section 133 of the Income Tax Act 1967, taxpayers can claim a Double Tax Credit against Malaysian tax payable for foreign tax paid in the source country, preventing double taxation.</p>"
      }
    },
    {
      "@type": "Question",
      name: "If I leave my foreign income in an overseas bank account, is it taxable by LHDN?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>No. Malaysia continues to apply the remittance basis for FSI. If the foreign-sourced income is not remitted or brought into Malaysia, it remains non-taxable under current LHDN rules.</p>"
      }
    }
  ]
};
