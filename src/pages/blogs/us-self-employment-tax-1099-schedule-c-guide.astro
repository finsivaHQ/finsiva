---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "US Self-Employment Tax Guide: 15.3% Rate, 1099 & Schedule C Deductions";
const description = "Comprehensive guide to US self-employment tax for 1099 freelancers, independent contractors, and small business owners. Learn 15.3% SECA calculations, Schedule C write-offs, and estimated tax rules.";
const image = "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=1200&q=80";
const canonical = "https://finsiva.com/blogs/us-self-employment-tax-1099-schedule-c-guide/";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the self-employment tax rate in the United States?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The statutory self-employment tax rate under the Self-Employment Contributions Act (SECA) is 15.3%. This consists of 12.4% for Social Security on net earnings up to the annual wage base limit, and 2.9% for Medicare with no upper income cap. An Additional Medicare Tax of 0.9% applies to self-employment earnings exceeding $200,000 for single filers or $250,000 for married couples filing jointly."
      }
    },
    {
      "@type": "Question",
      "name": "Why is self-employment tax calculated on 92.35% of net business profit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under Section 1402(a)(12) of the Internal Revenue Code, self-employment tax is computed on 92.35% of your net Schedule C profit (100% minus 7.65%). This adjustment mirrors the tax treatment of W-2 employees, whose employers pay 7.65% in payroll taxes that are not included in the employee's taxable gross compensation."
      }
    },
    {
      "@type": "Question",
      "name": "How does the 50% self-employment tax deduction reduce income tax?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Self-employed individuals can deduct exactly half (50%) of their total calculated self-employment tax as an 'above-the-line' adjustment on Schedule 1 of Form 1040. This deduction reduces your Adjusted Gross Income (AGI), lowering your federal income tax liability regardless of whether you claim the standard deduction or itemize deductions."
      }
    },
    {
      "@type": "Question",
      "name": "What are the safe harbor rules for quarterly estimated tax payments?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To avoid IRS underpayment penalties under Form 2210, self-employed taxpayers must make four quarterly estimated tax payments covering either: (1) at least 90% of their current year tax liability, or (2) 100% of their total tax liability shown on the prior year's return (increased to 110% if prior-year AGI exceeded $150,000)."
      }
    },
    {
      "@type": "Question",
      "name": "Can an S-Corporation election save money on self-employment taxes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. By electing S-Corporation tax status via Form 2553, an LLC owner pays themselves a 'reasonable salary' subject to standard 15.3% FICA payroll taxes, while taking the remaining business net profits as shareholder distributions, which are exempt from self-employment tax."
      }
    }
  ]
};
---

<BlogLayout
