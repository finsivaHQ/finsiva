import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "Indonesia 183-Day Tax Residency: Worldwide Income Rules";
const description = "Understand the Indonesian 183-day tax residency rule, worldwide income reporting on SPT Form 1770, foreign tax credits, and non-resident PPh 26 flat tax.";
const image = "https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?w=1200&q=80";
const author = "Dewi Lestari, International Expat Tax Advisory Lead";
const authorBio = "Senior International Tax Specialist advising expatriates, digital nomads in Bali, KITAS holders, and foreign tech founders on Indonesian DJP tax compliance and bilateral DTAs.";
const canonical = "https://finsiva.com/blogs/indonesia-183-day-tax-residency-worldwide-income-guide/";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How is the 183-day tax residency rule calculated in Indonesia?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Under Article 2(3) of the Indonesian Income Tax Act, an individual is a domestic tax resident if present in Indonesia for more than 183 days within any continuous 12-month period. Partial days of presence, including arrival and departure dates, count as full days toward the 183-day threshold."
      }
    },
    {
      "@type": "Question",
      name: "Does Indonesia tax worldwide income for foreign tax residents?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Once deemed an Indonesian domestic tax resident, you are legally subject to tax on your global worldwide income under the Income Tax Act, unless you qualify for the 4-year territorial tax exemption for foreign specialists introduced under the Job Creation Law (UU Cipta Kerja)."
      }
    },
    {
      "@type": "Question",
      name: "What tax rate applies to non-residents earning Indonesian income?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Non-residents present in Indonesia for 182 days or less are subject to a flat 20% final withholding tax (PPh 26) on gross Indonesian-sourced payments, without entitlement to PTKP non-taxable allowances, unless reduced by an applicable Double Taxation Agreement (DTA)."
      }
    },
    {
      "@type": "Question",
      name: "Can foreign taxes paid overseas be credited against Indonesian income tax?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Under Article 24 of the Income Tax Act (PPh 24), Indonesian tax residents can claim a foreign tax credit for taxes paid overseas on foreign-sourced income, capped at the amount of Indonesian tax proportionally attributable to that foreign income."
      }
    }
  ]
};
