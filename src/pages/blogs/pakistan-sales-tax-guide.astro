---
import BlogLayout from "../../layouts/BlogLayout.astro";

const title = "Pakistan Sales Tax & GST Guide 2026: 18% Rate, Exemptions & Calculator";
const description = "Complete guide to sales tax and GST in Pakistan under the Sales Tax Act 1990. Learn federal 18% GST on goods, provincial sales tax on services, laptop GST, exempt items, and STRN filing.";
const image = "https://images.unsplash.com/photo-1554224154-26032ffc0d07?w=1200&q=80";
const canonical = "https://finsiva.com/blogs/pakistan-sales-tax-guide";
const author = "Farhan Ahmed";
const authorBio = "Indirect tax consultant specializing in sales tax registration (STRN), provincial services tax (SRB, PRA, ICT), and FBR monthly e-filing.";
const lastUpdated = "August 2026";
const readTime = "15 min read";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the standard federal sales tax (GST) rate in Pakistan for 2026?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The standard federal sales tax rate in Pakistan is 18% on the supply and import of taxable goods under the Sales Tax Act 1990 (increased from 17% in previous budget amendments)."
      }
    },
    {
      "@type": "Question",
      "name": "What is the sales tax rate on laptops and computer software in Pakistan?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Laptops and personal computers imported or sold locally are subject to federal sales tax rates, while IT software exports remain zero-rated. Domestic software sales incur provincial sales tax."
      }
    },
    {
      "@type": "Question",
      "name": "What is Further Tax on supplies to unregistered persons in Pakistan?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Under Section 3(1A) of the Sales Tax Act 1990, registered manufacturers and distributors must charge an additional Further Tax (typically 4%) on taxable supplies made to unregistered persons."
      }
    },
    {
      "@type": "Question",
      "name": "What goods are exempt from sales tax under the Sixth Schedule?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The Sixth Schedule of the Sales Tax Act 1990 lists exempt goods, including unprocessed agricultural produce, basic food items (wheat, milk, fresh vegetables), books, and life-saving medicines."
      }
    },
    {
      "@type": "Question",
      "name": "What are provincial sales tax rates on services in Sindh, Punjab, and Islamabad?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Services tax is administered provincially: Sindh Revenue Board (SRB) charges 13% to 15%, Punjab Revenue Authority (PRA) charges 16%, and Islamabad Excise/FBR charges 15% to 16% on taxable services."
      }
    }
  ]
};
---

<BlogLayout title={title} description={description} image={image} canonical={canonical} author={author} authorBio={authorBio} lastUpdated={lastUpdated} readTime={readTime}>
  <div class="mt-8 space-y-6 text-body dark:text-muted leading-relaxed">
            <p>
              Understanding <strong>pakistan sales tax</strong>, statutory <strong>gst rate in pakistan</strong>, and provincial services tax is essential for businesses, importers, retailers, and consumers.
            </p>
            <p>
              In Pakistan, indirect taxation is bifurcated: federal sales tax on goods is governed by the Federal Board of Revenue (FBR) under the <em>Sales Tax Act, 1990</em>, while sales tax on services is collected by provincial revenue authorities.
            </p>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">1. Federal Sales Tax Rates on Goods (18% GST)</h2>
            <p>
              The standard <strong>current sales tax rate in pakistan</strong> on taxable goods is <strong>18%</strong> (adjusted from the historical 17 percent gst in pakistan).
            </p>

            <div class="my-6 overflow-x-auto rounded-xl border border-hairline bg-canvas dark:border-overlay-lighter dark:bg-surface">
              <table class="w-full text-left text-sm">
                <thead class="bg-canvas-soft border-b border-hairline dark:bg-surface/80 dark:border-overlay-lighter text-ink dark:text-on-primary font-bold">
                  <tr>
                    <th class="p-3">Category</th>
                    <th class="p-3">FBR Federal Sales Tax Rate</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-hairline dark:divide-overlay-lighter">
                  <tr>
                    <td class="p-3 font-medium">Standard Taxable Goods & Imports</td>
                    <td class="p-3 font-bold text-primary dark:text-on-primary">18% Standard GST</td>
                  </tr>
                  <tr>
                    <td class="p-3 font-medium">Supplies to Unregistered Persons (Further Tax)</td>
                    <td class="p-3 font-bold text-rose-600">18% GST + 4% Further Tax = 22%</td>
                  </tr>
                  <tr>
                    <td class="p-3 font-medium">Laptops & Personal Computers</td>
                    <td class="p-3 font-medium">18% Sales Tax (or Eighth Schedule reduced rate)</td>
                  </tr>
                  <tr>
                    <td class="p-3 font-medium">Exempt Goods (Sixth Schedule)</td>
                    <td class="p-3 font-bold text-emerald-600">0% (Fully Exempt)</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <p>
              Calculate tax-inclusive prices using our <a href="/countries/pakistan/sales-tax/gst-calculator" class="text-link hover:underline">Pakistan GST Calculator</a>.
            </p>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">2. Provincial Sales Tax on Services Rates</h2>
            <p>
              Under the 18th Constitutional Amendment, sales tax on services is administered by provincial revenue authorities:
            </p>
            <ul>
              <li><strong>Sindh Sales Tax on Services (SRB)</strong>: Standard rate is 13% (with specific services taxed up to 15%).</li>
              <li><strong>Punjab Sales Tax on Services (PRA)</strong>: Standard rate is 16% across commercial and IT services.</li>
              <li><strong>Islamabad Capital Territory GST on Services (ICT)</strong>: Standard rate is 15% administered by FBR.</li>
              <li><strong>Khyber Pakhtunkhwa Sales Tax on Services (KPRA)</strong>: Standard rate ranges from 15% to 16%.</li>
            </ul>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">3. List of Exempt Goods (Sixth Schedule)</h2>
            <p>
              The Sixth Schedule of the Sales Tax Act 1990 provides a statutory <strong>list of goods exempted from sales tax in pakistan</strong>:
            </p>
            <ol class="list-decimal pl-6 space-y-2">
              <li>Unprocessed agricultural produce (wheat, rice, fresh fruits, un-bolled cotton).</li>
              <li>Basic food staples (fresh milk, pulses, fresh vegetables, meat).</li>
              <li>Educational textbooks, printed newspapers, and holy books.</li>
              <li>Life-saving pharmaceutical medicines and vaccines.</li>
            </ol>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">4. Tier-1 Retailers & STRN Mandatory Registration</h2>
            <p>
              Sales Tax Registration Number (STRN) is mandatory for importers, wholesalers, distributors, manufacturers, and Tier-1 retailers (retail outlets located in air-conditioned shopping malls or with electricity bills exceeding PKR 1.2 million per year). Tier-1 retailers must integrate POS systems directly with FBR's real-time portal.
            </p>
            <p>
              Explore all utilities on our <a href="/knowledge/pakistan-tax-calculators" class="text-link hover:underline">Pakistan Tax Calculators Directory</a> or review our <a href="/knowledge/pakistan-income-tax" class="text-link hover:underline">Pakistan Income Tax Knowledge Hub</a>.
            </p>

            <h2 class="text-2xl font-semibold text-ink dark:text-on-primary">Frequently Asked Questions</h2>
          </div>

          <div class="mt-8 space-y-4">
            {faqSchema.mainEntity.map(faq => (
              <div class="rounded-xl border border-hairline bg-canvas p-6 dark:border-overlay-lighter dark:bg-surface">
                <h3 class="text-lg font-semibold text-ink dark:text-on-primary">{faq.name}</h3>
                <p class="mt-2 text-sm text-body dark:text-muted leading-relaxed">{faq.acceptedAnswer.text}</p>
              </div>
            ))}
          </div>

          <div class="mt-12 p-6 rounded-2xl bg-canvas-soft border border-hairline dark:border-overlay-lighter dark:bg-surface">
            <h3 class="text-xl font-bold text-ink dark:text-on-primary">About the Author</h3>
            <p class="mt-2 text-sm font-semibold text-primary dark:text-on-primary">{author}</p>
            <p class="mt-1 text-sm text-body dark:text-muted">{authorBio}</p>
  </div>
</BlogLayout>
