const title = "New Zealand Take-Home Pay & PAYE Salary Tax Guide: Net Pay Calculations, Deductions & Write-Offs";
const description = "Complete guide to working out your take-home pay and net salary after tax in New Zealand. Explains PAYE tax deductions, ACC earners levy, KiwiSaver options, student loan repayments, and step-by-step calculation examples for a $90,000 salary.";
const image = "https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?w=1200&q=80";
const author = "Caleb Thorne, Senior Tax Advisory Lead";
const authorBio = "Public accountant and payroll advisor assisting employees, job seekers, and employers across Auckland, Christchurch, and Wellington with PAYE deductions, net salary conversions, KiwiSaver, and IRD online payments.";
const canonical = "https://finsiva.com/blogs/nz-take-home-pay-paye-salary-tax-calculator-guide";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How do I calculate my take-home pay in New Zealand?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>Your take-home pay (net salary) is calculated by taking your gross annual salary and deducting PAYE income tax (based on NZ's progressive tax brackets), the mandatory ACC Earners' Levy (1.60%), your KiwiSaver employee contribution (3%, 4%, 6%, 8%, or 10%), and any student loan repayments (12% of earnings above the repayment threshold).</p>"
      }
    },
    {
      "@type": "Question",
      name: "How much tax do I pay on a $90,000 salary in New Zealand?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>On a gross salary of $90,000 NZD in the 2024–2025 tax year, income tax is approximately $19,630, plus an ACC earners levy of $1,440. If contributing 3% to KiwiSaver ($2,700), your annual net take-home pay is approximately $66,230 (or roughly $1,273 per week).</p>"
      }
    },
    {
      "@type": "Question",
      name: "What is the ACC Earners' Levy in NZ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>The ACC Earners' Levy is a mandatory statutory levy deducted alongside PAYE tax from all employment income. It funds accident compensation cover for non-work injuries. For the 2024–2025 tax year, the rate is 1.60% capped at a maximum earnings limit of $142,283.</p>"
      }
    },
    {
      "@type": "Question",
      name: "What is non-taxable income in New Zealand?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>Non-taxable income in NZ includes tax-free employer reimbursements for genuine work expenses, certain tax-exempt allowances (such as relocation costs), gift inheritances, capital gains on primary residence sales, and approved tax-free employee meal allowances.</p>"
      }
    },
    {
      "@type": "Question",
      name: "What does Residual Income Tax (RIT) mean in NZ?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "<p>Residual Income Tax (RIT) is the final amount of tax you owe to the IRD after subtracting all PAYE tax withheld, tax credits, and foreign tax credits from your total tax liability. If your RIT exceeds $5,000, you are required to pay provisional tax in the following tax year.</p>"
      }
    }
  ]
};
