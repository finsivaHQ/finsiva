---
import Layout from "../../layouts/Layout.astro";

const title = "Expat Tax Comparison Hub | Side-by-Side Country Tax Comparisons - Finsiva";
const description = "Compare personal income tax, capital gains, corporate rates, and expat tax rules side-by-side across Hong Kong, Singapore, United States, United Kingdom, and India.";

const comparisonPages = [
  {
    slug: "hong-kong-vs-singapore",
    title: "Hong Kong vs Singapore Tax Comparison 2026",
    countryA: "Hong Kong 🇭🇰",
    countryB: "Singapore 🇸🇬",
    highlights: ["Max Progressive Rate: HK 17% vs SG 24%", "Capital Gains Tax: Both 0% Exempt", "Territorial Tax Basis vs Remittance Exemption"],
    category: "Asian Financial Hubs"
  },
  {
    slug: "united-states-vs-united-kingdom",
    title: "United States vs United Kingdom Expat Tax Comparison",
    countryA: "United States 🇺🇸",
    countryB: "United Kingdom 🇬🇧",
    highlights: ["Worldwide IRS Taxation vs Statutory Residency", "FEIE ($126k+) / FTC Credits vs UK Tax Relief", "State Taxes vs UK National Insurance (8%)"],
    category: "Western Hubs"
  },
  {
    slug: "india-vs-singapore-nri-tax",
    title: "India vs Singapore NRI Tax Comparison Guide",
    countryA: "India 🇮🇳",
    countryB: "Singapore 🇸🇬",
    highlights: ["NRI Tax Slabs vs SG Non-Resident 15%", "DTAA Foreign Tax Credit & Form 67", "Capital Gains & NRE Tax-Free Accounts"],
    category: "NRI & Emerging Markets"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description: description,
  url: "https://finsiva.com/compare"
};
---

<Layout title={title} description={description} schema={schema}>
  <div class="min-h-screen bg-canvas dark:bg-canvas">
    <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-6 text-sm">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="text-link hover:underline dark:text-link">Home</a></li>
          <li><span class="text-muted">/</span></li>
          <li class="font-medium text-ink dark:text-on-primary" aria-current="page">Tax Comparisons</li>
        </ol>
      </nav>

      <!-- Header -->
      <div class="mb-12 text-center sm:text-left">
        <h1 class="text-3xl font-extrabold tracking-tight text-ink sm:text-5xl dark:text-on-primary">
          Expat & Global Tax Comparison Hub
        </h1>
        <p class="mt-4 max-w-3xl text-lg text-body dark:text-muted leading-relaxed">
          Compare personal income tax brackets, capital gains exemptions, corporate tax incentives, and expat residency requirements side-by-side across major international financial jurisdictions.
        </p>
      </div>

      <!-- Comparison Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {comparisonPages.map(page => (
          <a href={`/compare/${page.slug}`} class="group rounded-2xl border border-hairline bg-canvas p-6 shadow-sm transition-all hover:border-primary hover:shadow-lg dark:border-overlay-lighter dark:bg-surface dark:hover:border-primary flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-primary">{page.category}</span>
                <span class="text-xs text-muted dark:text-muted">2026/27 Edition</span>
              </div>
              
              <h2 class="text-xl font-bold text-ink dark:text-on-primary group-hover:text-primary transition-colors mb-4">
                {page.title}
              </h2>

              <div class="flex items-center justify-between rounded-xl bg-canvas-soft p-3 mb-4 dark:bg-canvas/60 text-sm font-semibold text-ink dark:text-on-primary">
                <span>{page.countryA}</span>
                <span class="text-xs text-muted font-normal">VS</span>
                <span>{page.countryB}</span>
              </div>

              <ul class="space-y-2 text-xs text-body dark:text-muted">
                {page.highlights.map(h => (
                  <li class="flex items-center gap-2">
                    <span class="text-primary font-bold">•</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-6 pt-4 border-t border-hairline dark:border-overlay-lighter flex items-center justify-between text-sm font-semibold text-primary">
              <span>View Side-by-Side Comparison</span>
              <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </div>
          </a>
        ))}
      </div>

      <!-- Educational Guidance Section -->
      <section class="rounded-2xl border border-hairline bg-canvas-soft p-8 dark:border-overlay-lighter dark:bg-surface mb-16">
        <h2 class="text-2xl font-bold text-ink dark:text-on-primary mb-4">Key Factors When Comparing Global Tax Jurisdictions</h2>
        <p class="text-body dark:text-muted mb-6 leading-relaxed">
          Evaluating where to live, work remotely, or incorporate a business requires analyzing more than just headline income tax rates. Key legal and financial mechanisms significantly alter effective tax liabilities:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="rounded-xl border border-hairline bg-canvas p-5 dark:border-overlay-lighter dark:bg-canvas">
            <h3 class="font-bold text-ink dark:text-on-primary mb-2">1. Taxing Principle (Citizenship vs. Residency)</h3>
            <p class="text-sm text-body dark:text-muted">Most nations (UK, Singapore, India, HK) tax individuals based on physical residence. The US is an exception, taxing citizens worldwide regardless of domicile.</p>
          </div>
          <div class="rounded-xl border border-hairline bg-canvas p-5 dark:border-overlay-lighter dark:bg-canvas">
            <h3 class="font-bold text-ink dark:text-on-primary mb-2">2. Territorial vs. Worldwide System</h3>
            <p class="text-sm text-body dark:text-muted">Territorial jurisdictions like Hong Kong tax only income earned locally. Remittance-based systems tax foreign income only when brought into the country.</p>
          </div>
          <div class="rounded-xl border border-hairline bg-canvas p-5 dark:border-overlay-lighter dark:bg-canvas">
            <h3 class="font-bold text-ink dark:text-on-primary mb-2">3. Social Security & Mandatory Contributions</h3>
            <p class="text-sm text-body dark:text-muted">Mandatory payroll contributions like US FICA, UK National Insurance, or HK MPF alter take-home pay independently of income tax rates.</p>
          </div>
          <div class="rounded-xl border border-hairline bg-canvas p-5 dark:border-overlay-lighter dark:bg-canvas">
            <h3 class="font-bold text-ink dark:text-on-primary mb-2">4. Double Taxation Agreements (DTAs)</h3>
            <p class="text-sm text-body dark:text-muted">Bilateral DTAs clarify tie-breaker residency rules and offer Foreign Tax Credits (FTC) to prevent paying double tax on cross-border earnings.</p>
          </div>
          <div class="rounded-xl border border-hairline bg-canvas p-5 dark:border-overlay-lighter dark:bg-canvas">
            <h3 class="font-bold text-ink dark:text-on-primary mb-2">5. Capital Gains & Dividend Exemption</h3>
            <p class="text-sm text-body dark:text-muted">Jurisdictions like Hong Kong and Singapore levy 0% capital gains tax on investments, whereas India and the US apply specific holding period rates.</p>
          </div>
          <div class="rounded-xl border border-hairline bg-canvas p-5 dark:border-overlay-lighter dark:bg-canvas">
            <h3 class="font-bold text-ink dark:text-on-primary mb-2">6. Indirect & Consumption Taxes</h3>
            <p class="text-sm text-body dark:text-muted">Value Added Tax (VAT) or Goods & Services Tax (GST) range from 0% in Hong Kong to 9% in Singapore and up to 20% in the UK, impacting cost of living.</p>
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>
