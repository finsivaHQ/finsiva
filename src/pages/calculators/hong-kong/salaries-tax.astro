--- 
<!-- Calculators/HK Salaries Tax Calculator - WITH VALIDATION --> 

<h1 class="text-3xl font-bold text-ink text-center mb-6">Hong Kong Salaries Tax Calculator</h1>

<form id="hk-tax-form" class="max-w-2xl mx-auto p-8 space-y-6 bg-canvas rounded-lg shadow-lg" onsubmit="event.preventDefault()">
  <div class="space-y-4">
    <div>
      <label class="block text-sm font-medium text-ink mb-2" for="income" data-required>Annual Income (HKD) *</label>
      <input type="number" id="income" step="1000" min="0" value="0" class="w-full px-3 py-2 border border-hairline rounded focus:outline-none focus:ring-2 focus:ring-primary" required oninput="validateField('income', this)">
      <div id="income-error" class="text-xs text-danger mt-1 hidden">Please enter a valid amount</div>
    </div>
    
    <div>
      <label class="block text-sm font-medium text-ink mb-2" for="deductions">Deductions (HKD)</label>
      <input type="number" id="deductions" step="1000" min="0" value="0" class="w-full px-3 py-2 border border-hairline rounded focus:outline-none focus:ring-2 focus:ring-primary" oninput="validateField('deductions', this)">
      <div id="deductions-error" class="text-xs text-danger mt-1 hidden">Please enter a valid amount</div>
    </div>
    
    <div>
      <label class="block text-sm font-medium text-ink mb-2" for="marital">Marital Status *</label>
      <select id="marital" class="w-full px-3 py-2 border border-hairline rounded focus:outline-none focus:ring-2 focus:ring-primary" required onchange="validateSelect('marital')">
        <option value="">Select Status</option>
        <option value="single">Single</option>
        <option value="married">Married</option>
      </select>
      <div id="marital-error" class="text-xs text-danger mt-1 hidden">Please select a status</div>
    </div>
    
    <div>
      <label class="block text-sm font-medium text-ink mb-2" for="children">Number of Children</label>
      <input type="number" id="children" min="0" value="0" class="w-full px-3 py-2 border border-hairline rounded focus:outline-none focus:ring-2 focus:ring-primary" oninput="validateField('children', this)">
      <div id="children-error" class="text-xs text-danger mt-1 hidden">Please enter a valid number</div>
    </div>
  </div>

  <button type="button" id="calculate-btn" class="w-full py-3 bg-primary text-white rounded font-medium disabled:opacity-50 disabled:cursor-not-allowed" disabled>Calculate Tax</button>
</form>

<div id="results" class="mt-8 p-6 bg-on-secondary rounded-lg shadow-md hidden">
  <h2 class="text-xl font-semibold text-ink mb-4">Calculation Results</h2>
  <div id="results-content" class="space-y-4"></div>
</div>

<div id="error-message" class="mt-4 text-sm text-danger text-center hidden"></div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FinancialProduct",
  "name": "Hong Kong Salaries Tax Calculator",
  "description": "Calculate Hong Kong salaries tax using progressive and standard rates",
  "areaServed": ["Hong Kong"],
  "provider": {
    "@type": "Organization",
    "name": "Hong Kong Tax Tools"
  }
}
</script>

<script>
  // Form Validation Functions
  function validateField(fieldId, element) {
    const errorId = fieldId + '-error';
    const errorEl = document.getElementById(errorId);
    const value = parseFloat(element.value);
    
    if (isNaN(value) || value < 0) {
      element.classList.add('border-danger');
      errorEl.classList.remove('hidden');
      element.classList.remove('border-hairline');
      return false;
    } else {
      element.classList.remove('border-danger', 'border-hairline');
      errorEl.classList.add('hidden');
      return true;
    }
  }

  function validateSelect(selectId) {
    const errorId = selectId + '-error';
    const errorEl = document.getElementById(errorId);
    const selectEl = document.getElementById(selectId);
    const value = selectEl.value;
    
    if (!value) {
      selectEl.classList.add('border-danger');
      errorEl.classList.remove('hidden');
      selectEl.classList.remove('border-hairline');
      return false;
    } else {
      selectEl.classList.remove('border-danger', 'border-hairline');
      errorEl.classList.add('hidden');
      return true;
    }
  }

  function checkFormValidation() {
    const incomeValid = validateField('income', document.getElementById('income'));
    const deductionsValid = validateField('deductions', document.getElementById('deductions'));
    const childrenValid = validateField('children', document.getElementById('children'));
    const maritalValid = validateSelect('marital');
    
    const calculateBtn = document.getElementById('calculate-btn');
    if (incomeValid && deductionsValid && childrenValid && maritalValid) {
      calculateBtn.disabled = false;
    } else {
      calculateBtn.disabled = true;
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    checkFormValidation();
  });

  // Constants (HARDCODED per requirements)
  const STANDARD_RATE = 0.15;
  const ALLOWANCES = {
    BASIC_ALLOWANCE: 132000,
    MARRIED_ALLOWANCE: 264000,
    CHILD_ALLOWANCE: 120000
  };

  const PROGRESSIVE_BRACKETS = [
    { threshold: 50000, rate: 0.02 },
    { threshold: 100000, rate: 0.06 },
    { threshold: 150000, rate: 0.10 },
    { threshold: 200000, rate: 0.14 }
  ];

  function calculateHongKongSalariesTax({ income, deductions, maritalStatus, children }) {
    // Step 1: Calculate allowance
    let allowance = maritalStatus === 'married' 
      ? ALLOWANCES.MARRIED_ALLOWANCE 
      : ALLOWANCES.BASIC_ALLOWANCE;
    allowance += children * ALLOWANCES.CHILD_ALLOWANCE;

    // Step 2: Net Chargeable Income
    const netIncome = Math.max(0, income - deductions - allowance);

    // Step 3: Progressive Tax
    let progressiveTax = 0;
    let prevThreshold = 0;

    for (const bracket of PROGRESSIVE_BRACKETS) {
      if (netIncome > prevThreshold) {
        const taxableInBracket = Math.min(netIncome, bracket.threshold) - prevThreshold;
        progressiveTax += taxableInBracket * bracket.rate;
      }
      prevThreshold = bracket.threshold;
    }

    // Apply top rate for amounts exceeding highest bracket
    if (netIncome > 200000) {
      progressiveTax += (netIncome - 200000) * 0.17;
    }

    // Step 4: Standard Tax
    const standardTax = netIncome * STANDARD_RATE;

    // Step 5: Final Tax
    const finalTax = Math.min(progressiveTax, standardTax);

    return {
      netIncome,
      progressiveTax,
      standardTax,
      finalTax
    };
  }

  function formatHKD(amount) {
    return new Intl.NumberFormat('en-HK', {
      style: 'currency',
      currency: 'HKD',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0
    }).format(amount);
  }

  const calculateBtn = document.getElementById('calculate-btn');
  const resultsDiv = document.getElementById('results');
  const resultsContent = document.getElementById('results-content');
  const errorDiv = document.getElementById('error-message');

  calculateBtn.addEventListener('click', handleCalculate);

  function handleCalculate() {
    const income = parseFloat(document.getElementById('income').value) || 0;
    const deductions = parseFloat(document.getElementById('deductions').value) || 0;
    const maritalStatus = document.getElementById('marital').value;
    const children = parseInt(document.getElementById('children').value) || 0;

    if (income < 0 || deductions < 0 || children < 0) {
      errorDiv.textContent = 'Please enter non-negative values';
      errorDiv.classList.remove('hidden');
      return;
    }

    try {
      const result = calculateHongKongSalariesTax({ income, deductions, maritalStatus, children });

      resultsDiv.classList.remove('hidden');
      errorDiv.classList.add('hidden');
      resultsContent.innerHTML = `
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-canvas p-4 rounded">
            <p class="text-xs text-muted mb-1">Net Chargeable Income</p>
            <p class="text-lg font-semibold text-ink">${formatHKD(result.netIncome)}</p>
          </div>
          <div class="bg-canvas p-4 rounded">
            <p class="text-xs text-muted mb-1">Progressive Tax</p>
            <p class="text-lg font-semibold text-ink">${formatHKD(result.progressiveTax)}</p>
          </div>
          <div class="bg-canvas p-4 rounded">
            <p class="text-xs text-muted mb-1">Standard Tax</p>
            <p class="text-lg font-semibold text-ink">${formatHKD(result.standardTax)}</p>
          </div>
          <div class="bg-canvas p-4 rounded border-2 border-primary/30 bg-primary/5">
            <p class="text-xs text-muted mb-1">Final Tax Payable</p>
            <p class="text-2xl font-bold text-primary">${formatHKD(result.finalTax)}</p>
          </div>
        </div>
        <p class="mt-4 text-xs text-muted text-center">
          Final tax is calculated using the lower of progressive rates or standard rate as per Hong Kong tax rules.
        </p>
      `;
    } catch (error) {
      errorDiv.textContent = 'An error occurred during calculation. Please try again.';
      errorDiv.classList.remove('hidden');
      resultsDiv.classList.add('hidden');
    }
  }
</script>