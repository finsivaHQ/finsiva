  <!-- Client-Side Reactive Script -->
  <script is:inline>
    (function initDaveRamseyCalculator() {
      // Inputs
      var curAgeInput = document.getElementById('current-age');
      var retAgeInput = document.getElementById('retire-age');
      var savingsInput = document.getElementById('current-savings');
      var contribInput = document.getElementById('monthly-contrib');
      var incomeInput = document.getElementById('annual-income');
      var returnRateSlider = document.getElementById('return-rate');
      var returnRateVal = document.getElementById('return-rate-val');
      var withdrawalSlider = document.getElementById('withdrawal-rate');
      var withdrawalVal = document.getElementById('withdrawal-rate-val');
      var resetBtn = document.getElementById('calc-reset-btn');
      var apply15Btn = document.getElementById('apply-15-btn');

      // Outputs
      var totalNestEggEl = document.getElementById('total-nest-egg');
      var summaryRetireAgeEl = document.getElementById('summary-retire-age');
      var yearsToInvestEl = document.getElementById('years-to-invest');
      var monthlyIncomeEl = document.getElementById('monthly-income-val');
      var annualIncomeEl = document.getElementById('annual-income-val');
      var labelMonthlyRate = document.getElementById('label-monthly-rate');
      var labelAnnualRate = document.getElementById('label-annual-rate');
      var totalContribEl = document.getElementById('total-contributed');
      var totalGrowthEl = document.getElementById('total-growth');
      var growthPercentEl = document.getElementById('growth-percentage');
      var barContributions = document.getElementById('bar-contributions');
      var barGrowth = document.getElementById('bar-growth');
      var contribAnnualDisplay = document.getElementById('contrib-annual-display');
      var tableBody = document.getElementById('milestones-table-body');

      // Comparison Elements
      var compDaveMonthly = document.getElementById('comp-dave-monthly');
      var compDaveAnnual = document.getElementById('comp-dave-annual');
      var compTrinityMonthly = document.getElementById('comp-trinity-monthly');
      var compTrinityAnnual = document.getElementById('comp-trinity-annual');

      // Presets
      var ratePresetBtns = document.querySelectorAll('.rate-preset-btn');
      var withdrawalPresetBtns = document.querySelectorAll('.withdrawal-preset-btn');

      function formatMoney(num) {
        return '$' + Math.round(num).toLocaleString('en-US');
      }

      function calculate() {
        var curAge = parseInt(curAgeInput.value, 10) || 30;
        var retAge = parseInt(retAgeInput.value, 10) || 65;
        if (retAge <= curAge) {
          retAge = curAge + 1;
          retAgeInput.value = retAge;
        }

        var curSavings = parseFloat(savingsInput.value) || 0;
        var monthlyContrib = parseFloat(contribInput.value) || 0;
        var annualRate = (parseFloat(returnRateSlider.value) || 10) / 100;
        var withdrawalRate = (parseFloat(withdrawalSlider.value) || 8) / 100;

        var years = retAge - curAge;
        var months = years * 12;
        var monthlyRate = annualRate / 12;

        // Future Value Formula
        var fvLumpSum = curSavings * Math.pow(1 + monthlyRate, months);
        var fvAnnuity = 0;
        if (monthlyRate > 0) {
          fvAnnuity = monthlyContrib * ((Math.pow(1 + monthlyRate, months) - 1) / monthlyRate);
        } else {
          fvAnnuity = monthlyContrib * months;
        }

        var totalNestEgg = fvLumpSum + fvAnnuity;
        var totalContributed = curSavings + (monthlyContrib * months);
        var totalGrowth = Math.max(0, totalNestEgg - totalContributed);

        var annualIncome = totalNestEgg * withdrawalRate;
        var monthlyIncome = annualIncome / 12;

        var growthRatio = totalNestEgg > 0 ? (totalGrowth / totalNestEgg) * 100 : 0;
        var contribRatio = totalNestEgg > 0 ? (totalContributed / totalNestEgg) * 100 : 0;

        // Update DOM
        totalNestEggEl.textContent = formatMoney(totalNestEgg);
        summaryRetireAgeEl.textContent = retAge;
        yearsToInvestEl.textContent = years + ' Years of Compounding';
        monthlyIncomeEl.textContent = formatMoney(monthlyIncome) + ' / mo';
        annualIncomeEl.textContent = formatMoney(annualIncome) + ' / yr';
        labelMonthlyRate.textContent = 'at ' + (withdrawalRate * 100).toFixed(1) + '% draw';
        labelAnnualRate.textContent = 'at ' + (withdrawalRate * 100).toFixed(1) + '% draw';

        totalContribEl.textContent = formatMoney(totalContributed);
        totalGrowthEl.textContent = formatMoney(totalGrowth);
        growthPercentEl.textContent = growthRatio.toFixed(1) + '% Free Growth';

        barContributions.style.width = Math.min(100, Math.max(2, contribRatio)) + '%';
        barGrowth.style.width = Math.min(100, Math.max(2, growthRatio)) + '%';

        contribAnnualDisplay.textContent = formatMoney(monthlyContrib * 12) + ' / year';

        // Update Reality Check Comparison
        var daveAnnualDraw = totalNestEgg * 0.08;
        var daveMonthlyDraw = daveAnnualDraw / 12;
        var trinityAnnualDraw = totalNestEgg * 0.04;
        var trinityMonthlyDraw = trinityAnnualDraw / 12;

        compDaveMonthly.textContent = formatMoney(daveMonthlyDraw) + ' / mo';
        compDaveAnnual.textContent = formatMoney(daveAnnualDraw) + ' / year';
        compTrinityMonthly.textContent = formatMoney(trinityMonthlyDraw) + ' / mo';
        compTrinityAnnual.textContent = formatMoney(trinityAnnualDraw) + ' / year';

        // Build Milestones Table (5-year intervals)
        var tableHtml = '';
        var stepYears = 5;
        for (var y = stepYears; y <= years; y += stepYears) {
          var m = y * 12;
          var subLump = curSavings * Math.pow(1 + monthlyRate, m);
          var subAnnuity = monthlyRate > 0 ? monthlyContrib * ((Math.pow(1 + monthlyRate, m) - 1) / monthlyRate) : monthlyContrib * m;
          var subTotal = subLump + subAnnuity;
          var subContrib = curSavings + (monthlyContrib * m);
          var subGrowth = Math.max(0, subTotal - subContrib);
          var subMonthlyInc = (subTotal * withdrawalRate) / 12;

          tableHtml += '<tr class="hover:bg-canvas-soft/40 dark:hover:bg-overlay-light/30 transition-colors">';
          tableHtml += '<td class="py-3 px-4 font-bold text-ink dark:text-on-primary">Age ' + (curAge + y) + '</td>';
          tableHtml += '<td class="py-3 px-4 text-muted">' + y + ' Years In</td>';
          tableHtml += '<td class="py-3 px-4 font-medium text-ink dark:text-on-primary">' + formatMoney(subContrib) + '</td>';
          tableHtml += '<td class="py-3 px-4 font-semibold text-emerald-600 dark:text-emerald-400">+' + formatMoney(subGrowth) + '</td>';
          tableHtml += '<td class="py-3 px-4 font-extrabold text-ink dark:text-on-primary">' + formatMoney(subTotal) + '</td>';
          tableHtml += '<td class="py-3 px-4 font-bold text-primary">' + formatMoney(subMonthlyInc) + '/mo</td>';
          tableHtml += '</tr>';
        }

        // Final row if years not multiple of 5
        if (years % stepYears !== 0) {
          tableHtml += '<tr class="bg-primary/5 hover:bg-primary/10 transition-colors font-bold">';
          tableHtml += '<td class="py-3 px-4 font-black text-primary">Age ' + retAge + ' (Target)</td>';
          tableHtml += '<td class="py-3 px-4 text-muted">' + years + ' Years (Final)</td>';
          tableHtml += '<td class="py-3 px-4">' + formatMoney(totalContributed) + '</td>';
          tableHtml += '<td class="py-3 px-4 text-emerald-600 dark:text-emerald-400">+' + formatMoney(totalGrowth) + '</td>';
          tableHtml += '<td class="py-3 px-4 font-black text-ink dark:text-on-primary">' + formatMoney(totalNestEgg) + '</td>';
          tableHtml += '<td class="py-3 px-4 text-primary">' + formatMoney(monthlyIncome) + '/mo</td>';
          tableHtml += '</tr>';
        }

        tableBody.innerHTML = tableHtml;
      }

      // Event Listeners
      [curAgeInput, retAgeInput, savingsInput, contribInput].forEach(function(el) {
        el.addEventListener('input', calculate);
      });

      returnRateSlider.addEventListener('input', function() {
        returnRateVal.textContent = returnRateSlider.value + '%';
        ratePresetBtns.forEach(function(b) {
          b.classList.remove('active-preset', 'border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
          b.classList.add('border-hairline', 'bg-canvas-soft', 'text-ink');
          if (parseFloat(b.getAttribute('data-rate')) === parseFloat(returnRateSlider.value)) {
            b.classList.add('active-preset', 'border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
            b.classList.remove('border-hairline', 'bg-canvas-soft', 'text-ink');
          }
        });
        calculate();
      });

      withdrawalSlider.addEventListener('input', function() {
        withdrawalVal.textContent = withdrawalSlider.value + '%';
        withdrawalPresetBtns.forEach(function(b) {
          b.classList.remove('active-withdrawal', 'border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
          b.classList.add('border-hairline', 'bg-canvas-soft', 'text-ink');
          if (parseFloat(b.getAttribute('data-rate')) === parseFloat(withdrawalSlider.value)) {
            b.classList.add('active-withdrawal', 'border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
            b.classList.remove('border-hairline', 'bg-canvas-soft', 'text-ink');
          }
        });
        calculate();
      });

      // Rate Presets Click
      ratePresetBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var rate = this.getAttribute('data-rate');
          returnRateSlider.value = rate;
          returnRateVal.textContent = rate + '%';
          ratePresetBtns.forEach(function(b) {
            b.classList.remove('active-preset', 'border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
            b.classList.add('border-hairline', 'bg-canvas-soft', 'text-ink');
          });
          this.classList.add('active-preset', 'border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
          this.classList.remove('border-hairline', 'bg-canvas-soft', 'text-ink');
          calculate();
        });
      });

      // Withdrawal Presets Click
      withdrawalPresetBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var rate = this.getAttribute('data-rate');
          withdrawalSlider.value = rate;
          withdrawalVal.textContent = rate + '%';
          withdrawalPresetBtns.forEach(function(b) {
            b.classList.remove('active-withdrawal', 'border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
            b.classList.add('border-hairline', 'bg-canvas-soft', 'text-ink');
          });
          this.classList.add('active-withdrawal', 'border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
          this.classList.remove('border-hairline', 'bg-canvas-soft', 'text-ink');
          calculate();
        });
      });

      // 15% Rule Helper Button
      apply15Btn.addEventListener('click', function() {
        var inc = parseFloat(incomeInput.value) || 0;
        if (inc > 0) {
          var monthly15 = Math.round((inc * 0.15) / 12);
          contribInput.value = monthly15;
          calculate();
        }
      });

      incomeInput.addEventListener('input', function() {
        var inc = parseFloat(incomeInput.value) || 0;
        if (inc > 0) {
          var monthly15 = Math.round((inc * 0.15) / 12);
          apply15Btn.textContent = 'Set 15% ($' + monthly15 + '/mo)';
        }
      });

      // Reset
      resetBtn.addEventListener('click', function() {
        curAgeInput.value = '30';
        retAgeInput.value = '65';
        savingsInput.value = '25000';
        contribInput.value = '650';
        incomeInput.value = '60000';
        apply15Btn.textContent = 'Set 15% ($750/mo)';
        returnRateSlider.value = '10';
        returnRateVal.textContent = '10%';
        withdrawalSlider.value = '8';
        withdrawalVal.textContent = '8%';

        ratePresetBtns.forEach(function(b) {
          b.classList.remove('active-preset', 'border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
          b.classList.add('border-hairline', 'bg-canvas-soft', 'text-ink');
          if (b.getAttribute('data-rate') === '10') {
            b.classList.add('active-preset', 'border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
          }
        });

        withdrawalPresetBtns.forEach(function(b) {
          b.classList.remove('active-withdrawal', 'border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
          b.classList.add('border-hairline', 'bg-canvas-soft', 'text-ink');
          if (b.getAttribute('data-rate') === '8') {
            b.classList.add('active-withdrawal', 'border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
          }
        });

        calculate();
      });

      // Copy Summary
      var copyBtn = document.getElementById('copy-summary-btn');
      var copyBtnText = document.getElementById('copy-btn-text');
      copyBtn.addEventListener('click', function() {
        var text = 'Dave Ramsey Retirement Projection (via Finsiva):\n' +
          '• Current Age: ' + curAgeInput.value + ' | Target Age: ' + retAgeInput.value + '\n' +
          '• Current Savings: $' + savingsInput.value + '\n' +
          '• Monthly Contribution: $' + contribInput.value + ' ($' + (parseFloat(contribInput.value) * 12) + '/year)\n' +
          '• Projected Nest Egg: ' + totalNestEggEl.textContent + '\n' +
          '• Annual Income (' + withdrawalSlider.value + '% draw): ' + annualIncomeEl.textContent + '\n' +
          '• Monthly Income: ' + monthlyIncomeEl.textContent + '\n' +
          '• Contributed: ' + totalContribEl.textContent + ' | Compound Growth: ' + totalGrowthEl.textContent + '\n' +
          'Calculate yours at: ' + window.location.href;

        navigator.clipboard.writeText(text).then(function() {
          copyBtnText.textContent = 'Copied to Clipboard! ✓';
          setTimeout(function() {
            copyBtnText.textContent = 'Copy Retirement Summary';
          }, 2500);
        });
      });

      // Initial run
      calculate();
    })();
  </script>
</Layout>
