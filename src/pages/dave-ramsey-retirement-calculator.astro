---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FactCheckedBadge from "../components/FactCheckedBadge.astro";
import AuthorBioCard from "../components/AuthorBioCard.astro";

const pageTitle = "Dave Ramsey Retirement Calculator | Free Nest Egg & 15% Rule Tool | Finsiva";
const pageDescription = "Calculate your retirement nest egg using the Dave Ramsey retirement calculator. Estimate compound growth with the 15% rule, compare 10-12% returns, and test 8% vs 4% withdrawal rates.";
const canonicalUrl = "https://finsiva.com/dave-ramsey-retirement-calculator/";

const faqList = [
  {
    question: "What is Dave Ramsey's 15% retirement rule?",
    answer: "Dave Ramsey's 15% rule (Baby Step 4) advises investing 15% of your gross annual household income into tax-advantaged retirement accounts before saving for children's college (Step 5) or paying off your home early (Step 6). This 15% should come from your own contributions, ignoring any employer match as extra icing on the cake."
  },
  {
    question: "Why does Dave Ramsey use 10% to 12% annual return rates?",
    answer: "Dave cites the long-term historical average annual return of the S&P 500, which has averaged approximately 10% to 12% since 1926 before adjusting for inflation. While realistic financial planners often use 7% to 8% to account for inflation and fund fees, Dave's figures illustrate nominal compound growth."
  },
  {
    question: "What is Dave Ramsey's 8% withdrawal rate controversy?",
    answer: "Dave argues that retirees can safely withdraw 8% of their nest egg annually if their portfolio earns 12% and inflation is 4%. However, the widely accepted Trinity Study and modern CFPs recommend a 4% to 5% withdrawal rate to protect against sequence of returns risk and market downturns. Our calculator lets you compare both methodologies side-by-side."
  },
  {
    question: "What mutual funds does Dave Ramsey recommend?",
    answer: "Ramsey recommends dividing your retirement investments equally (25% each) across four categories of equity mutual funds: Growth and Income (large-cap value), Growth (large/mid-cap blend), Aggressive Growth (small-cap/emerging), and International (foreign markets)."
  },
  {
    question: "In what order should I fund my retirement accounts according to Dave?",
    answer: "Dave recommends: (1) Invest in your employer 401(k) up to the company match; (2) Fully fund a Roth IRA; (3) If you still have not reached 15% of your gross income, return to your 401(k) or a Health Savings Account (HSA) to fulfill the remaining balance."
  },
  {
    question: "How does this tool compare to a realistic retirement calculator?",
    answer: "A simple retirement calculator often locks you into one rigid assumption. This tool gives you full control: you can calculate with Dave Ramsey's optimistic 10-12% returns and 8% withdrawal rate, or toggle instant realistic presets (7-8% inflation-adjusted returns and a 4% safe withdrawal rate) to see your conservative safety margin."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqList.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Dave Ramsey Retirement Calculator",
  "url": canonicalUrl,
  "description": pageDescription,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  schema={webAppSchema}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Resources", href: "/knowledge/" },
        { label: "Dave Ramsey Retirement Calculator" }
      ]}
    />

    <!-- Hero Header -->
    <div class="relative overflow-hidden rounded-2xl bg-canvas p-6 sm:p-10 mb-8 border border-hairline shadow-sm dark:bg-surface dark:border-overlay-lighter mt-4">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
      <div class="absolute left-0 right-0 top-0 -z-10 m-auto h-[260px] w-[260px] rounded-full bg-primary/20 opacity-50 blur-[90px] dark:bg-primary/10"></div>
      <div class="relative z-10 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold mb-3">
          <span>✨ 2026 Financial Planning Engine</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-ink dark:text-on-primary">
          Dave Ramsey Retirement Calculator
        </h1>
        <p class="mt-3 text-base sm:text-lg text-body dark:text-muted leading-relaxed">
          Plan your financial freedom with Dave Ramsey's signature 15% rule (Baby Step 4), test 10%–12% historical compound growth, and compare Ramsey's 8% withdrawal rate against the conservative 4% rule.
        </p>
      </div>
    </div>

    <!-- Fact Check Badge & Metadata -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <FactCheckedBadge
        reviewerName="Finsiva Financial Engineering"
        reviewerTitle="Quantitative Modeling & Retirement Analytics"
        sourceName="Historical S&P 500 Data & Trinity Study"
        sourceUrl="https://finsiva.com/methodology/"
        lastChecked="October 2026"
      />
      <div class="flex items-center gap-2 text-xs text-muted">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Real-Time Client-Side Engine • Zero Data Stored</span>
      </div>
    </div>

    <!-- MAIN CALCULATOR INTERFACE (ABOVE THE FOLD) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
      
      <!-- LEFT: Inputs & Controls -->
      <div class="lg:col-span-5 rounded-2xl border border-hairline bg-canvas p-6 shadow-sm dark:border-overlay-lighter dark:bg-surface/60 backdrop-blur-sm">
        <div class="flex items-center justify-between border-b border-hairline dark:border-overlay-lighter pb-4 mb-6">
          <h2 class="text-lg font-bold text-ink dark:text-on-primary flex items-center gap-2">
            <svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
            </svg>
            Your Retirement Inputs
          </h2>
          <button id="calc-reset-btn" type="button" class="text-xs font-semibold text-muted hover:text-primary transition-colors">
            Reset Defaults
          </button>
        </div>

        <form id="retirement-form" class="space-y-5" onsubmit="event.preventDefault()">
          
          <!-- Ages Row -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="current-age" class="block text-xs font-semibold text-ink dark:text-on-primary mb-1">
                Current Age
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="current-age"
                  min="18"
                  max="80"
                  value="30"
                  class="w-full rounded-xl border border-hairline bg-canvas-soft px-3.5 py-2.5 text-sm font-semibold text-ink shadow-sm transition focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary dark:border-overlay-light dark:bg-surface dark:text-on-primary"
                  required
                />
                <span class="absolute right-3 top-2.5 text-xs text-muted">yrs</span>
              </div>
            </div>

            <div>
              <label for="retire-age" class="block text-xs font-semibold text-ink dark:text-on-primary mb-1">
                Retirement Age
              </label>
              <div class="relative">
                <input
                  type="number"
                  id="retire-age"
                  min="30"
                  max="95"
                  value="65"
                  class="w-full rounded-xl border border-hairline bg-canvas-soft px-3.5 py-2.5 text-sm font-semibold text-ink shadow-sm transition focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary dark:border-overlay-light dark:bg-surface dark:text-on-primary"
                  required
                />
                <span class="absolute right-3 top-2.5 text-xs text-muted">yrs</span>
              </div>
            </div>
          </div>

          <!-- Current Savings -->
          <div>
            <label for="current-savings" class="block text-xs font-semibold text-ink dark:text-on-primary mb-1">
              Current Retirement Savings ($)
            </label>
            <div class="relative">
              <span class="absolute left-3.5 top-2.5 text-sm font-medium text-muted">$</span>
              <input
                type="number"
                id="current-savings"
                min="0"
                step="500"
                value="25000"
                class="w-full rounded-xl border border-hairline bg-canvas-soft pl-8 pr-3.5 py-2.5 text-sm font-semibold text-ink shadow-sm transition focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary dark:border-overlay-light dark:bg-surface dark:text-on-primary"
                required
              />
            </div>
            <p class="text-[11px] text-muted mt-1">Total in 401(k), IRA, Roth IRA, and brokerage accounts.</p>
          </div>

          <!-- Monthly Contribution -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label for="monthly-contrib" class="block text-xs font-semibold text-ink dark:text-on-primary">
                Monthly Contribution ($)
              </label>
              <span id="contrib-annual-display" class="text-[11px] font-medium text-primary">
                $7,800 / year
              </span>
            </div>
            <div class="relative">
              <span class="absolute left-3.5 top-2.5 text-sm font-medium text-muted">$</span>
              <input
                type="number"
                id="monthly-contrib"
                min="0"
                step="50"
                value="650"
                class="w-full rounded-xl border border-hairline bg-canvas-soft pl-8 pr-3.5 py-2.5 text-sm font-semibold text-ink shadow-sm transition focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary dark:border-overlay-light dark:bg-surface dark:text-on-primary"
                required
              />
            </div>
          </div>

          <!-- Dave's 15% Rule Helper (Household Income) -->
          <div class="rounded-xl border border-dashed border-primary/40 bg-primary/5 p-3.5">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-xs font-bold text-ink dark:text-on-primary flex items-center gap-1.5">
                <span>🛡️</span> Dave's 15% Rule Check
              </span>
              <span class="text-[10px] uppercase font-bold tracking-wider text-primary">Baby Step 4</span>
            </div>
            <p class="text-[11px] text-body dark:text-muted mb-2">
              Enter annual gross income to auto-calculate your recommended 15% contribution:
            </p>
            <div class="flex items-center gap-2">
              <div class="relative flex-1">
                <span class="absolute left-3 top-2 text-xs font-medium text-muted">$</span>
                <input
                  type="number"
                  id="annual-income"
                  min="0"
                  step="1000"
                  value="60000"
                  placeholder="Annual Income"
                  class="w-full rounded-lg border border-hairline bg-canvas px-2.5 pl-6 py-1.5 text-xs font-medium text-ink shadow-sm focus:border-primary focus:outline-none dark:border-overlay-light dark:bg-surface dark:text-on-primary"
                />
              </div>
              <button
                type="button"
                id="apply-15-btn"
                class="rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-on-primary hover:bg-primary-hover transition shadow-sm whitespace-nowrap"
              >
                Set 15% ($750/mo)
              </button>
            </div>
          </div>

          <!-- Expected Annual Return -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="return-rate" class="block text-xs font-semibold text-ink dark:text-on-primary">
                Annual Return Rate: <span id="return-rate-val" class="text-primary font-bold">10%</span>
              </label>
              <span class="text-[11px] text-muted">Compounded Monthly</span>
            </div>
            <input
              type="range"
              id="return-rate"
              min="3"
              max="14"
              step="0.5"
              value="10"
              class="w-full accent-primary cursor-pointer mb-2"
            />
            <!-- Rate Presets -->
            <div class="grid grid-cols-3 gap-1.5">
              <button type="button" class="rate-preset-btn rounded-lg border border-hairline bg-canvas-soft px-2 py-1 text-[11px] font-medium text-ink hover:border-primary dark:border-overlay-light dark:bg-surface dark:text-on-primary" data-rate="11">
                Dave (11%)
              </button>
              <button type="button" class="rate-preset-btn active-preset rounded-lg border border-primary bg-primary/10 px-2 py-1 text-[11px] font-bold text-primary dark:border-primary" data-rate="10">
                S&P 500 (10%)
              </button>
              <button type="button" class="rate-preset-btn rounded-lg border border-hairline bg-canvas-soft px-2 py-1 text-[11px] font-medium text-ink hover:border-primary dark:border-overlay-light dark:bg-surface dark:text-on-primary" data-rate="7">
                Realistic (7%)
              </button>
            </div>
          </div>

          <!-- Safe Withdrawal Rate -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="withdrawal-rate" class="block text-xs font-semibold text-ink dark:text-on-primary">
                Retirement Withdrawal Rate: <span id="withdrawal-rate-val" class="text-primary font-bold">8%</span>
              </label>
              <span class="text-[11px] text-muted">Annual Drawdown</span>
            </div>
            <input
              type="range"
              id="withdrawal-rate"
              min="2"
              max="10"
              step="0.5"
              value="8"
              class="w-full accent-primary cursor-pointer mb-2"
            />
            <!-- Withdrawal Presets -->
            <div class="grid grid-cols-3 gap-1.5">
              <button type="button" class="withdrawal-preset-btn active-withdrawal rounded-lg border border-primary bg-primary/10 px-2 py-1 text-[11px] font-bold text-primary dark:border-primary" data-rate="8">
                Dave Ramsey (8%)
              </button>
              <button type="button" class="withdrawal-preset-btn rounded-lg border border-hairline bg-canvas-soft px-2 py-1 text-[11px] font-medium text-ink hover:border-primary dark:border-overlay-light dark:bg-surface dark:text-on-primary" data-rate="5">
                Money Guy (5%)
              </button>
              <button type="button" class="withdrawal-preset-btn rounded-lg border border-hairline bg-canvas-soft px-2 py-1 text-[11px] font-medium text-ink hover:border-primary dark:border-overlay-light dark:bg-surface dark:text-on-primary" data-rate="4">
                Trinity 4% Rule
              </button>
            </div>
          </div>

        </form>
      </div>

      <!-- RIGHT: Interactive Results Dashboard -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Primary Result Card -->
        <div class="rounded-2xl border border-hairline bg-gradient-to-br from-canvas to-canvas-soft p-6 sm:p-8 shadow-sm dark:border-overlay-lighter dark:from-surface dark:to-surface/70">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-muted">
              Estimated Nest Egg At Age <span id="summary-retire-age" class="text-ink dark:text-on-primary font-extrabold">65</span>
            </span>
            <span id="years-to-invest" class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
              35 Years of Compounding
            </span>
          </div>

          <!-- Big Total Number -->
          <div class="my-4">
            <div id="total-nest-egg" class="text-4xl sm:text-5xl md:text-6xl font-black text-ink dark:text-on-primary tracking-tight">
              $2,829,350
            </div>
            <p class="text-xs text-muted mt-1">Total projected balance across all investment accounts.</p>
          </div>

          <!-- Monthly & Annual Drawdown Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6 pt-6 border-t border-hairline dark:border-overlay-lighter">
            <div class="rounded-xl bg-canvas p-4 border border-hairline dark:bg-surface/80 dark:border-overlay-light">
              <div class="text-xs text-muted font-medium mb-1 flex items-center justify-between">
                <span>Monthly Retirement Income</span>
                <span id="label-monthly-rate" class="text-[10px] font-bold text-primary">at 8% draw</span>
              </div>
              <div id="monthly-income-val" class="text-2xl sm:text-3xl font-extrabold text-primary">
                $18,862 / mo
              </div>
              <p class="text-[11px] text-muted mt-1">Safe monthly spending budget</p>
            </div>

            <div class="rounded-xl bg-canvas p-4 border border-hairline dark:bg-surface/80 dark:border-overlay-light">
              <div class="text-xs text-muted font-medium mb-1 flex items-center justify-between">
                <span>Annual Retirement Income</span>
                <span id="label-annual-rate" class="text-[10px] font-bold text-primary">at 8% draw</span>
              </div>
              <div id="annual-income-val" class="text-2xl sm:text-3xl font-extrabold text-ink dark:text-on-primary">
                $226,348 / yr
              </div>
              <p class="text-[11px] text-muted mt-1">Pre-tax annual withdrawal</p>
            </div>
          </div>

          <!-- Compound Growth Breakdown (Progress Bar) -->
          <div class="mt-6 pt-6 border-t border-hairline dark:border-overlay-lighter">
            <div class="flex items-center justify-between text-xs font-semibold mb-2">
              <span class="text-ink dark:text-on-primary">Principal Contributed vs Compound Growth</span>
              <span id="growth-percentage" class="text-emerald-600 dark:text-emerald-400 font-bold">89.5% Free Growth</span>
            </div>

            <!-- Dual Bar -->
            <div class="h-4 w-full rounded-full bg-canvas-soft dark:bg-surface overflow-hidden flex border border-hairline dark:border-overlay-light">
              <div id="bar-contributions" class="bg-primary transition-all duration-300" style="width: 10.5%;" title="Principal Contributed"></div>
              <div id="bar-growth" class="bg-emerald-500 transition-all duration-300" style="width: 89.5%;" title="Compound Growth"></div>
            </div>

            <div class="grid grid-cols-2 gap-4 mt-3 text-xs">
              <div class="flex items-center gap-2">
                <span class="h-3 w-3 rounded-full bg-primary flex-shrink-0"></span>
                <span class="text-muted">Total Contributed:</span>
                <span id="total-contributed" class="font-bold text-ink dark:text-on-primary">$298,000</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="h-3 w-3 rounded-full bg-emerald-500 flex-shrink-0"></span>
                <span class="text-muted">Compound Growth:</span>
                <span id="total-growth" class="font-bold text-emerald-600 dark:text-emerald-400">$2,531,350</span>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="mt-6 pt-6 border-t border-hairline dark:border-overlay-lighter flex flex-wrap items-center justify-between gap-3">
            <button
              id="copy-summary-btn"
              type="button"
              class="inline-flex items-center gap-2 rounded-xl border border-hairline bg-canvas px-4 py-2 text-xs font-semibold text-ink hover:bg-canvas-soft dark:border-overlay-light dark:bg-surface dark:text-on-primary dark:hover:bg-overlay-light transition"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
              <span id="copy-btn-text">Copy Retirement Summary</span>
            </button>
            <button
              id="print-btn"
              type="button"
              onclick="window.print()"
              class="inline-flex items-center gap-2 rounded-xl border border-hairline bg-canvas px-4 py-2 text-xs font-semibold text-ink hover:bg-canvas-soft dark:border-overlay-light dark:bg-surface dark:text-on-primary dark:hover:bg-overlay-light transition"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zM9 9h6v2H9V9z"></path></svg>
              <span>Print Plan</span>
            </button>
          </div>
        </div>

        <!-- Realistic Comparison Card: Dave's 8% vs The 4% Rule -->
        <div class="rounded-2xl border border-hairline bg-canvas p-6 shadow-sm dark:border-overlay-lighter dark:bg-surface/50">
          <h3 class="text-base font-bold text-ink dark:text-on-primary mb-3 flex items-center gap-2">
            <span>⚖️</span> Reality Check: Dave Ramsey's 8% vs The 4% Rule
          </h3>
          <p class="text-xs text-body dark:text-muted mb-4 leading-relaxed">
            Dave Ramsey controversially recommends withdrawing 8% per year in retirement, assuming 12% returns minus 4% inflation. In contrast, financial researchers and The Money Guy advise a 4% to 5% safe withdrawal rate to guard against sequence-of-returns risk. Here is how your retirement income looks under each philosophy:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <!-- Dave Ramsey Method -->
            <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/5 p-4">
              <div class="font-bold text-emerald-600 dark:text-emerald-400 mb-1 flex items-center justify-between">
                <span>Dave Ramsey 8% Rule</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/10">High Income</span>
              </div>
              <div id="comp-dave-monthly" class="text-xl font-black text-ink dark:text-on-primary my-1">
                $18,862 / mo
              </div>
              <div id="comp-dave-annual" class="text-xs font-semibold text-muted">
                $226,348 / year
              </div>
              <p class="text-[11px] text-muted mt-2">Relies on continuous stock market outperformance without sustained bear markets.</p>
            </div>

            <!-- Trinity 4% Rule -->
            <div class="rounded-xl border border-primary/30 bg-primary/5 p-4">
              <div class="font-bold text-primary mb-1 flex items-center justify-between">
                <span>Trinity Study 4% Rule</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-primary/10">Ultra-Safe</span>
              </div>
              <div id="comp-trinity-monthly" class="text-xl font-black text-ink dark:text-on-primary my-1">
                $9,431 / mo
              </div>
              <div id="comp-trinity-annual" class="text-xs font-semibold text-muted">
                $113,174 / year
              </div>
              <p class="text-[11px] text-muted mt-2">Tested to survive 95%+ of historical 30-year retirement windows, including 1929 and 2008.</p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- DAVE RAMSEY INVESTMENT CHART / MILESTONE TABLE -->
    <section class="rounded-2xl border border-hairline bg-canvas p-6 sm:p-8 shadow-sm dark:border-overlay-lighter dark:bg-surface mb-16" aria-labelledby="milestone-chart-heading">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div>
          <h2 id="milestone-chart-heading" class="text-2xl font-bold text-ink dark:text-on-primary flex items-center gap-2">
            <span>📈</span> Dave Ramsey Investment Chart & Milestones
          </h2>
          <p class="text-sm text-body dark:text-muted mt-1">
            See the exact trajectory of your nest egg every 5 years as compound interest overtakes your out-of-pocket contributions.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-3 py-1.5 rounded-full">
            <span>🚀</span> Compound Interest Snowball
          </span>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse">
          <thead>
