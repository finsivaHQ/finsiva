---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

const title = "Singapore Tax Residency Guide: 183-Day Rule, Form IR21 & Non-Resident Tax Rates";
const description = "Comprehensive guide to Singapore tax residency. Learn the 183-day rule, 60-day short-term employment exemption, non-resident tax rates (15%/24%), and Form IR21 tax clearance.";
const baseUrl = "https://finsiva.com";
const currentUrl = `${baseUrl}/knowledge/singapore-tax-residency`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How is Singapore tax residency determined for foreigners?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Foreigners who stay or work in Singapore for 183 days or more in a calendar year qualify as tax residents for that Year of Assessment. They are then taxed at progressive resident rates and can claim tax reliefs."
      }
    },
    {
      "@type": "Question",
      name: "What is the 183-day rule in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The 183-day rule states that if you are physically present or exercise employment in Singapore for 183 days or more in a calendar year, you will be treated as a tax resident for that year."
      }
    },
    {
      "@type": "Question",
      name: "What is the 60-day rule for working in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Foreigners who exercise employment in Singapore for 60 days or less in a calendar year are exempt from tax on their employment income. This exemption does not apply to company directors, public entertainers, or professionals."
      }
    },
    {
      "@type": "Question",
      name: "What is Form IR21 tax clearance?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Form IR21 is a mandatory IRAS tax clearance notification that employers must submit when a foreign employee terminates employment or leaves Singapore for more than three months. Employers must withhold money due to the employee until clearance is granted."
      }
    },
    {
      "@type": "Question",
      name: "Are Employment Pass (EP) and S Pass holders automatically tax residents?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No, EP and S Pass holders are not automatically tax residents. Their tax residency depends on the duration of their stay and employment in Singapore, specifically whether they meet the 183-day rule or other continuous residency rules."
      }
    }
  ]
};
---

<Layout
