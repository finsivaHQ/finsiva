              <tr><td class="p-3">Next S$180,000 (S$320,001 – S$500,000)</td><td class="p-3 font-medium">22%</td><td class="p-3">S$39,600</td><td class="p-3">S$84,150</td></tr>
              <tr><td class="p-3">Next S$500,000 (S$500,001 – S$1,000,000)</td><td class="p-3 font-medium">23%</td><td class="p-3">S$115,000</td><td class="p-3">S$199,150</td></tr>
              <tr><td class="p-3">Above S$1,000,000</td><td class="p-3 font-medium">24%</td><td class="p-3">24% on excess</td><td class="p-3">Variable</td></tr>
            </tbody>
