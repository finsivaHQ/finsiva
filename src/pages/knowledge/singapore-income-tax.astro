    {
      "@type": "Question",
      name: "How are non-residents taxed on income in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Non-residents working in Singapore are taxed at a flat rate of 15% on employment income or the progressive resident rate, whichever results in a higher tax amount. Non-residents do not qualify for personal tax reliefs."
      }
    },
    {
      "@type": "Question",
      name: "What is the corporate income tax rate in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Singapore corporate income tax is a flat 17%. Qualifying new startups benefit from partial tax exemptions (75% exemption on the first S$100,000 and 50% on the next S$100,000)."
      }
    },
    {
      "@type": "Question",
      name: "Does Singapore tax capital gains or stock dividends?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Singapore has 0% capital gains tax and operates a single-tier corporate tax framework where foreign and local stock dividends paid to individuals are tax-free."
      }
    },
    {
      "@type": "Question",
      name: "What is the maximum personal income tax relief cap in Singapore?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The total personal income tax relief an individual can claim is capped at S$80,000 per Year of Assessment."
      }
