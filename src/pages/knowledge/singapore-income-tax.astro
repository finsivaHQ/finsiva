              <tr>
                <th class="border p-3">Chargeable Income Bracket (SGD)</th>
                <th class="border p-3">Marginal Tax Rate</th>
                <th class="border p-3">Tax Payable on Bracket</th>
                <th class="border p-3">Cumulative Tax Payable</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline dark:divide-overlay-lighter">
              <tr><td class="p-3">First S$20,000</td><td class="p-3 font-medium">0%</td><td class="p-3">S$0</td><td class="p-3">S$0</td></tr>
              <tr><td class="p-3">Next S$10,000 (S$20,001 – S$30,000)</td><td class="p-3 font-medium">2%</td><td class="p-3">S$200</td><td class="p-3">S$200</td></tr>
              <tr><td class="p-3">Next S$10,000 (S$30,001 – S$40,000)</td><td class="p-3 font-medium">3.5%</td><td class="p-3">S$350</td><td class="p-3">S$550</td></tr>
              <tr><td class="p-3">Next S$40,000 (S$40,001 – S$80,000)</td><td class="p-3 font-medium">7%</td><td class="p-3">S$2,800</td><td class="p-3">S$3,350</td></tr>
              <tr><td class="p-3">Next S$40,000 (S$80,001 – S$120,000)</td><td class="p-3 font-medium">11.5%</td><td class="p-3">S$4,600</td><td class="p-3">S$7,950</td></tr>
              <tr><td class="p-3">Next S$40,000 (S$120,001 – S$160,000)</td><td class="p-3 font-medium">15%</td><td class="p-3">S$6,000</td><td class="p-3">S$13,950</td></tr>
              <tr><td class="p-3">Next S$40,000 (S$160,001 – S$200,000)</td><td class="p-3 font-medium">18%</td><td class="p-3">S$7,200</td><td class="p-3">S$21,150</td></tr>
              <tr><td class="p-3">Next S$40,000 (S$200,001 – S$240,000)</td><td class="p-3 font-medium">19%</td><td class="p-3">S$7,600</td><td class="p-3">S$28,750</td></tr>
              <tr><td class="p-3">Next S$40,000 (S$240,001 – S$280,000)</td><td class="p-3 font-medium">19.5%</td><td class="p-3">S$7,800</td><td class="p-3">S$36,550</td></tr>
