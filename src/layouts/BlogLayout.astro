---
import Layout from "./Layout.astro";
import AuthorBioCard from "../components/AuthorBioCard.astro";
import FactCheckedBadge from "../components/FactCheckedBadge.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  author?: string;
  authorBio?: string;
  lastUpdated?: string;
  readTime?: string;
  canonical?: string;
  schema?: Record<string, unknown>;
}

const {
  title,
  description,
  image = "/og-image.svg",
  author = "Finsiva Financial Editorial Board",
  authorBio = "Verified tax policy research and financial guidance by the Finsiva content team.",
  lastUpdated = "August 2026",
  readTime = "10 min read",
  canonical,
  schema
} = Astro.props;

const formattedDateModified = (() => {
  if (/^\d{4}-\d{2}-\d{2}$/.test(lastUpdated)) return lastUpdated;
  const parsed = Date.parse(lastUpdated);
  return isNaN(parsed) ? "2026-08-01" : new Date(parsed).toISOString().split('T')[0];
})();

const authorSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": image.startsWith('http') ? image : `https://finsiva.com${image.startsWith('/') ? '' : '/'}${image}`,
  "author": {
    "@type": "Person",
    "name": author,
    "jobTitle": "Certified Financial & Tax Analyst",
    "worksFor": {
      "@type": "Organization",
      "name": "Finsiva",
      "url": "https://finsiva.com"
    }
  },
  "publisher": {
    "@type": "Organization",
    "name": "Finsiva",
    "logo": {
      "@type": "ImageObject",
      "url": "https://finsiva.com/logo.png"
    }
  },
  "datePublished": "2025-01-01",
  "dateModified": formattedDateModified
};
---

<Layout title={`${title} | Finsiva`} description={description} image={image} canonical={canonical} schema={schema || authorSchema}>
  <div class="min-h-screen bg-canvas dark:bg-canvas">
    <main class="min-h-screen">
      <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb" class="mb-6 text-sm">
          <ol class="flex flex-wrap items-center gap-2">
            <li class="flex items-center gap-2"><a href="/" class="text-link hover:underline dark:text-link">Home</a></li>
            <li class="flex items-center gap-2"><span class="text-muted" aria-hidden="true">/</span><a href="/blogs" class="text-link hover:underline dark:text-link">Tax Guides</a></li>
            <li class="flex items-center gap-2"><span class="text-muted" aria-hidden="true">/</span><span class="font-medium text-ink dark:text-on-primary" aria-current="page">{title}</span></li>
          </ol>
        </nav>

        <article class="prose max-w-none">
          <header class="mb-8">
            {image && (
              <img src={image} alt={title} class="mb-6 w-full rounded-lg object-cover max-h-80 sm:max-h-96" loading="lazy" />
            )}
            <h1 class="text-4xl font-bold text-ink mb-4 dark:text-on-primary">{title}</h1>
            <div class="flex flex-wrap items-center gap-4 text-sm text-muted dark:text-muted mb-4">
              <span>By <span class="font-medium text-ink dark:text-on-primary">{author}</span></span>
              <span aria-hidden="true">·</span>
              <span>Last updated: {lastUpdated}</span>
              <span aria-hidden="true">·</span>
              <span>{readTime}</span>
            </div>

            <FactCheckedBadge reviewerName={author} lastChecked={lastUpdated} />
          </header>

          <slot />

          <footer class="mt-12 pt-8 border-t border-hairline dark:border-overlay-lighter">
            <AuthorBioCard name={author} bio={authorBio} lastVerified={lastUpdated} />
          </footer>
        </article>
      </div>
    </main>
  </div>
</Layout>

